#!/bin/sh
# The commit gates run from prebuilt binaries — bin/.tools_ensure fetches the
# release (content-addressed, never a build). A red working tree therefore never
# blocks a commit; a missing gate binary is named, never silent.
#
# Two gates, both measured against the tree before they block:
#   commit_check         — text semantics of the staged texts (incl. the `||` swallow)
#   concurrency_contract — the workflow concurrency contracts (ci-check: false;
#                          the six matrix workflows at job-level)
set -u
root="$(git rev-parse --show-toplevel 2>/dev/null || echo .)"
ensure() { "$root/bin/.tools_ensure" "$1" >/dev/null 2>&1 || true; }
# The gate binary is refreshed on every commit via .tools_ensure (content-addressed,
# TTL-gated) — a locally built older binary never hides a healed registry. The old
# `[ -x ]` guard skipped the refresh and let a stale gate block a legitimate commit
# (measured 2026-10-07: the healed force-unit baseline).
run() {
    for b in "$root/target/release/$1" "$root/target/debug/$1"; do
        if [ -x "$b" ]; then
            "$b"
            return $?
        fi
    done
    echo "$1: no gate binary (target/{release,debug}/$1) — the gate is skipped; the build is a CI job" >&2
    return 0
}
# commit_check's ereignis-ohne-folge gate is session-bound: it checks only the
# account/send events whose field 1 (the opencode sessionID) matches the current
# session. The sessionID source: OMEGAFLOW_SESSION (env) or, when empty, the
# plugin-written state/reports/active_session.φ (act_recorder, Konvention
# notes_notify.rs; measured: opencode sets no ses_ env). Without a session name
# commit_check skips by name, never silent.
if [ -z "${OMEGAFLOW_SESSION:-}" ] && [ -f "$root/state/reports/active_session.φ" ]; then
    IFS= read -r OMEGAFLOW_SESSION < "$root/state/reports/active_session.φ" || OMEGAFLOW_SESSION=""
fi
export OMEGAFLOW_SESSION="${OMEGAFLOW_SESSION:-}"
ensure commit_check
run commit_check || exit $?
ensure concurrency_contract
run concurrency_contract || exit $?
exit 0
