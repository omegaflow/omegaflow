#!/bin/sh
# Gate 3 — keine zweite Linie. Ein Push darf nur main aktualisieren; ein Branch,
# der die Maschine verlässt, ist eine Linie, die niemand mehr sieht.
# Lokale Branches bleiben erlaubt (sie erreichen kein Remote), müssen aber vor
# dem nächsten Push gelöscht oder gemerged werden.
set -u
rc=0
while read -r local_ref local_sha remote_ref remote_sha; do
    case "$remote_ref" in
        refs/heads/main) ;;
        *)
            echo "pre-push: $remote_ref abgelehnt — es gibt nur eine Linie: main" >&2
            echo "pre-push: lokal weiterarbeiten ist erlaubt, aber nicht veröffentlichen." >&2
            rc=1
            ;;
    esac
done
exit $rc
