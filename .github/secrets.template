# omegaflow GitHub Secrets - Stub
# Werte hinter dem '=' eintragen, dann entweder in der GitHub-UI
# (Settings > Secrets and variables > Actions) anlegen oder per CLI:
#   gh secret set EBIRD_API_KEY
#   (gh liest den Wert interaktiv von stdin ein)

EBIRD_API_KEY=
# https://ebird.org/api/keygen (Cornell-Account)

OPENAQ_API_KEY=
# https://explore.openaq.org/register

FIRMS_MAP_KEY=
# https://firms.modaps.eosdis.nasa.gov/api/area/ > "Get MAP_KEY" (mit Earthdata-Login)

EARTHDATA_EDL_TOKEN=
# https://urs.earthdata.nasa.gov > Profil > "Generate Token"

CMEMS_USER=
# https://data.marine.copernicus.eu/register

CMEMS_PASS=
# persoenlicher CMEMS-Token aus dem Profil (dient als Passwort)

CATALOGS_TOKEN=
# PAT mit Contents-write auf omegaflow/catalogs; ohne wird GITHUB_TOKEN genutzt
