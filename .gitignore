fam_state_SOD_2024.txt

# A=A: der verbindliche Register-Kanon ist in phi/canon.φ deklariert; eine
# neue getrackte phi/*.φ-Datei ist ein Architektur-Akt (Operator/Council-Wort
# + Kanon-Deklaration im selben Commit). Die !-Zeilen darunter bleiben
# Sichtbarkeitsmuster.
phi/*
# Meteo-Ereignis-Konfigurationen (phi/meteo/*.json) sind die Eingabe des
# Korrelations-Screenings (meteo_harvest/cross_te_screen) und die
# workflow_dispatch-Konfig des meteo-cdn.yml — versioniert wie die Register.
!phi/meteo/
phi/meteo/*
!phi/meteo/*.json
!phi/canon.φ
!phi/sources.φ
!phi/dead_sources.φ
!phi/blocked_sources.φ
!phi/witnesses.φ
!phi/footprints.φ
!phi/nrs_stations.φ
# Das Harvest-Master-Register ist ein Registrierungs-Urteil — versioniert wie sources.φ.
!phi/harvest.φ
# Flatten-Compiler-Eingaben (Katalog) sind Registrierungs-Urteile — versioniert:
# die kernel-flatten-Körperjob-Kette braucht sie auf dem CI-Runner
# (TNO-Split-GM + Solar-ω). Alles andere im Katalog bleibt lokale Ernte.
!phi/pipeline/
phi/pipeline/*
# Der Maschinen-Zwilling des Oszillator-Gates ist ein Registrierungs-Urteil — versioniert.
!phi/pipeline/decline_lens.φ
# Das Zustands-Register (SOURCE_PORT §4) ist ein Registrierungs-Urteil — versioniert wie dead_sources.φ.
!phi/pipeline/ledger.φ
# Der Pipeline-Index (Korpus-/Zustands-Verweise) und die Probe-Entwürfe sind
# Registrierungs-Urteile des Planungs-Passes (register_lookup --open liest sie) — versioniert.
!phi/pipeline/index.φ
!phi/pipeline/probe_wave.φ
!phi/pipeline/probe_hapi_proposed.φ
!phi/pipeline/probe_batch_skymap.φ
!phi/pipeline/catalog/
phi/pipeline/catalog/*
# Das TAP-Adressbuch der Weberin (tap_index_*.φ) ist ein Katalog-Inventar — versioniert wie MANIFEST.φ.
!phi/pipeline/catalog/tap_index*.φ
!phi/pipeline/catalog/asteroid_gm_sb441.φ
!phi/pipeline/catalog/asteroid_gm_inpop25c.φ
!phi/pipeline/catalog/solar_omega_g.φ
# Das NOAA-NODD-Dispositions-Register ist ein Registrierungs-Urteil (Bucket-Litmus,
# ledger.φ:937) — versioniert wie dead_sources.φ/blocked_sources.φ.
!phi/pipeline/catalog/noaa_nodd_disposition.φ
# Das Copernicus-Dispositions-Register ist ein Registrierungs-Urteil (Bucket-Litmus,
# ledger.φ copernicus-litmus) — versioniert wie noaa_nodd_disposition.φ.
!phi/pipeline/catalog/copernicus_disposition.φ
# Die Karte des Katalogs (role/state/lens je Datei) ist ein Registrierungs-Urteil — versioniert.
!phi/pipeline/catalog/MANIFEST.φ
# Das Korpora-Heim-Verdikt (Lizenzverdikt je Korpus: redistribute/decline/pending)
# ist ein Registrierungs-Urteil — versioniert; korpora-cdn.yml liest es.
!phi/pipeline/catalog/korpora_heim.φ
# Die redistribute-Verdikt-Korpora (CC0/CC-BY-Metadaten, korpora_heim.φ) sind
# versioniert, damit der CI-Runner sie für die CDN-Manifestation sieht
# (korpora-cdn.yml); nach der Manifestation ist das CDN das dauerhafte Heim.
!phi/pipeline/catalog/pangaea_catalog.φ
!phi/pipeline/catalog/pangaea_catalog_full.φ
!phi/pipeline/catalog/re3data_catalog.φ
!phi/pipeline/catalog/zenodo_catalog.φ
!phi/pipeline/catalog/dryad_catalog.φ
!phi/pipeline/catalog/wdcc_catalog.φ
!phi/pipeline/catalog/dataverse_harvard.φ
!phi/pipeline/catalog/dataverse_borealis.φ
!phi/pipeline/catalog/seanoe_catalog.φ
# Bindungen (Vorregistrierungen) sind Registrierungs-Urteile — versioniert.
!phi/bindings/
# Scan-Koverage ist ein Registrierungs-Urteil — versioniert (die Mess-Serie gehört der Zukunft).
# Runtime-Ledger im selben Ordner (gate_state.φ) bleiben ignoriert.
!phi/reports/
phi/reports/*
!phi/reports/scan_coverage.φ
# Der Probe-Sweep-Bericht (survivors/void) ist ein Registrierungs-Urteil — versioniert.
!phi/reports/probe_sweep_survivors.φ
!phi/reports/probe_sweep_void.txt

# Strang-Marker (Arbeitsebene der Session, je Branch im Worktree)
.omegaflow-strand

# Cloudflare-Worker-Werkzeuge (nicht ins Repo)
cloudflare/node_modules/
cloudflare/package.json
cloudflare/package-lock.json
cloudflare/.wrangler/
# Lokale Tunnel-Config (absoluter Credential-Pfad — Deployment, kein Repo-Gegenstand)
cloudflare/cloudflared-config.yml

# Runtime-Ledger (Gate/Watchdog-Zustand) — kein Source, kein Commit
/state/

# Geteilter Zustand-Ledger (Postfach-Zeile trägt Mail-/PII-Inhalte) — nie ins Repo; lokal erhalten.
docs/zustand/external-state.md

# Login-/Konto-Prüflisten (persönlich — nie ins Repo)
markiert.csv
omegaflow-pruefdatei.csv

# Lokales Anzeige-Mapping (enthält die private Operator-Adresse) — nie ins Repo
.mailmap

# Firmware (eigener Workspace, Build im CI) — lokale target/ und Lockfiles nicht ins Repo
firmware/*/target/
firmware/*/Cargo.lock

# Playwright-MCP artefacts (snapshots/logs) — local only
.playwright-mcp/
