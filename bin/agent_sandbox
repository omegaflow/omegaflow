#!/bin/sh
# agent_sandbox — a bubblewrap cage for the public agents.
#
# POSITIVE LIST: inside this namespace ONLY these are visible —
#   (1) the public repo   /home/johannes/projects/omegaflow
#   (2) the work yard     /home/johannes/projects/omegaflow-work
#   (3) the net           (shared, not unshared)
# plus the system (/usr /lib /bin /etc) and the bare toolchain minima needed to
# build and to reach opencode's own state. Everything else under /home — private
# documents, other projects, ~/.ssh, ~/.gpg — is NOT MOUNTED: it does not exist
# in here. A path outside the cage cannot be sniffed, not even by mistake.
set -eu
root=/home/johannes/projects/omegaflow
work=/home/johannes/projects/omegaflow-work
# The public token only: GH_TOKEN from .secrets.local (name read, value passed to
# the cage's env — never printed). It is scoped to omegaflow/omegaflow; the full
# account login (~/.config/gh) stays OUT of the cage, in the private house.
ghtok="$(sed -n 's/^GH_TOKEN=//p' "$root/.secrets.local" 2>/dev/null | sed -n '1p')"
exec bwrap \
  --ro-bind /usr /usr \
  --ro-bind-try /lib /lib \
  --ro-bind-try /lib64 /lib64 \
  --ro-bind-try /bin /bin \
  --ro-bind-try /sbin /sbin \
  --ro-bind /etc /etc \
  --ro-bind-try /run /run \
  --proc /proc --dev /dev \
  --tmpfs /tmp \
  --bind-try /tmp/opencode /tmp/opencode \
  --bind "$root" "$root" \
  --bind "$work" "$work" \
  --ro-bind-try /home/johannes/.cargo /home/johannes/.cargo \
  --ro-bind-try /home/johannes/.rustup /home/johannes/.rustup \
  --ro-bind-try /home/johannes/.local/bin /home/johannes/.local/bin \
  --ro-bind-try /home/johannes/.local/share/opencode /home/johannes/.local/share/opencode \
  --ro-bind-try /home/johannes/.gitconfig /home/johannes/.gitconfig \
  --setenv GH_TOKEN "$ghtok" \
  --share-net \
  --chdir "$root" \
  /bin/bash "$@"
