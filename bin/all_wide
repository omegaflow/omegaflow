#!/bin/sh
# all_wide — alias for `archive_search --wide`.
#
# The width is one flag now: `--wide` is `--all` with the stop threshold raised
# to 400 result lines, so the arms the default --all holds back (base, datacite,
# re3data, pangaea, figshare, crossref, github, ia-search, sourcegraph, jina,
# exa, linkup …) actually pull. This wrapper stays as the shell entry point the
# permission rules know; it is the same call as `archive_search --wide`.
#
# Usage: all_wide <keyword>... [--root <dir>]... [archive_search flags]
set -eu
root="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
for a in "$@"; do
  case "$a" in
    --root|--root=*|--index|--index=*|--mft|--mft=*|--git|--git=*)
      echo "all_wide: '$a' is a local-disk mode — refused; the wide search reads the net only, never the disk" >&2
      exit 2
      ;;
  esac
done
exec "$root/bin/archive_search" "$@" --wide
