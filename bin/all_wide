#!/bin/sh
# all_wide — `archive_search --wide` for the released binary.
#
# The width is one flag: `--wide` is `--all` with the stop threshold raised to
# 400 result lines, so the arms the default --all holds back (base, datacite,
# re3data, pangaea, figshare, crossref, github, ia-search, sourcegraph, jina,
# exa, linkup …) actually pull. This wrapper carries the same width through the
# env override the released binary already knows, so it works before the next
# tools-latest release ships the flag. It is the shell entry the permission
# rules know; `archive_search --wide` is the same width.
#
# Usage: all_wide <keyword>... [--root <dir>]... [archive_search flags]
set -eu
root="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
for a in "$@"; do
  case "$a" in
    --root|--root=*|--index|--index=*|--mft|--mft=*|--git|--git=*)
      echo "all_wide: '$a' is a local-disk mode — refused; the wide search reads the net only, never the disk" >&2
      exit 2
      ;;
  esac
done
stop="${OMEGAFLOW_ALL_WIDE_STOP:-400}"
OMEGAFLOW_ALL_STOP="$stop" exec "$root/bin/archive_search" "$@" --all
