#!/bin/sh
# Names every workflow line that publishes to the CDN around the licence check.
# The only gate is bin/cdn-put -> phi/sources.φ + src/archivar/licences.tsv.
# `gh release create` only opens an empty release and is not a publication;
# `--repo omegaflow/omegaflow` publishes the tool build, not a source asset.
set -u
root="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
cd "$root" || exit 2
uploads=0
files=0
for f in .github/workflows/*.yml; do
    [ -f "$f" ] || continue
    hits="$(perl -ne '
        next unless /\bgh release upload\b/;
        next if /--repo\s+"?omegaflow\/omegaflow/;
        # Meldungstexte ("… returned void", "… failed") sind keine Befehle
        next if /"[^"]*gh release upload[^"]*(?:returned|failed)/;
        print "$.: $_";
    ' "$f")"
    [ -n "$hits" ] || continue
    files=$((files + 1))
    uploads=$((uploads + $(printf '%s\n' "$hits" | wc -l)))
    printf '%s\n' "$f"
    printf '%s\n' "$hits" | sed 's/^/  /'
done
printf 'cdn-audit: %s upload line(s) in %s workflow(s) go around bin/cdn-put\n' "$uploads" "$files" >&2
[ "$uploads" -eq 0 ]
