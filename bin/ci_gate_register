#!/bin/sh
# The local per-SHA ci-gate verdict register (SHA -> green|red|pending):
# execs the release binary refreshed by bin/.tools_ensure; never builds.
set -u
self="$0"
while [ -h "$self" ]; do
    d="$(CDPATH= cd -- "$(dirname -- "$self")" && pwd)"
    self="$(readlink "$self")"
    case "$self" in /*) ;; *) self="$d/$self" ;; esac
done
root="$(CDPATH= cd -- "$(dirname -- "$self")/.." && pwd)"
"$root/bin/.tools_ensure" ci_gate_register
bin="$root/target/release/ci_gate_register"
if [ ! -x "$bin" ]; then
    echo "ci_gate_register: pending — no release installed; the build belongs to CI (tools-build)" >&2
    exit 2
fi
exec "$bin" "$@"
