#!/bin/sh
# The CI manage tool the sessions and the ci_watchdog run: builds only when
# needed, then execs it. A dirty or broken working tree never blocks a run
# read/cancel/rerun — the existing release binary runs; the rebuild is a CI
# job, not a per-call tax.
set -u
root="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
bin="$root/target/release/ci_manage"
stamp="$root/target/release/.ci_manage_build_stamp"
needs_build=0
if [ ! -x "$bin" ]; then
    needs_build=1
elif find "$root/tools/utils/src" "$root/src" "$root/Cargo.toml" "$root/tools/utils/Cargo.toml" \
        \( -name '*.rs' -o -name '*.cjs' \) -newer "$bin" -print -quit 2>/dev/null | grep -q .; then
    needs_build=1
fi
if [ "$needs_build" = 1 ] && { [ ! -f "$stamp" ] || find "$stamp" -mmin +5 | grep -q .; }; then
    (cd "$root" && cargo build --release -q -p omegaflow-utils --bin ci_manage 2>/dev/null) || true
    touch "$stamp"
fi
if [ ! -x "$bin" ]; then
    echo "ci_manage: no release binary and the rebuild failed (the tree does not compile) — the build belongs to CI" >&2
    exit 2
fi
exec "$bin" "$@"
