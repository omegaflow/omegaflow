#!/bin/sh
# copilot_review — read-only Zweit-Leser über die genannten Pfade.
# Copilot läuft im Plan-Modus ohne MCP-Server (kein Schreib-/Aktionskanal) und
# meldet nach fester Rubrik nur Kandidaten: ungemessene Zustandsbehauptungen,
# Fabrikationsmuster, Widersprüche. Die Befunde sind KEINE Verdikte — die
# Session misst jeden am Baum (A = A), bevor er als Zeile zählt. Kein Gate:
# die blockierende Schicht bleiben commit_check/concurrency_contract/….
set -u
if [ "$#" -lt 1 ]; then
    echo "usage: copilot_review <pfad...>" >&2
    exit 2
fi
rubric="Read-only second reader. Read ONLY these paths in the current repository: $*. Report ONLY, one line per finding: (1) a state claim without a measured source, (2) a fabrication pattern (silent default, unwrap_or, 0-sentinel for absent, speculative wording), (3) a contradiction between two places. Format each as: file:line | quoted text | one sentence. No summary, no rating, no fix suggestion."
exec copilot -p "$rubric" --mode plan --disable-builtin-mcps --max-ai-credits 30
