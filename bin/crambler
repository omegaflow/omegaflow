#!/bin/sh
# crambler — einen Text von Hand schwärzen (Operator-Werkzeug).
#
# Text einfügen, Strg-D drücken, geschwärzt zurücklesen:
#     bin/crambler
# oder aus der Zwischenablage:
#     xclip -o | bin/crambler
#
# Es ist DERSELBE Schwärzer wie im Gateway (bin/private_read — Stufe 1 deterministisch,
# einstufig). Nur zum Hineinkopieren von Hand. Läuft im Terminal des OPERATORS:
# der Agent-Käfig hat keinen Zugang zum privaten Haus.
set -eu
here="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
priv="${OMEGAFLOW_PRIVATE:-$HOME/projects/omegaflow-personal}"
[ -d "$priv" ] || { printf 'crambler: kein privates Haus unter %s\n' "$priv" >&2; exit 2; }

tmp="$priv/.crambler.stdin.$$"
trap 'rm -f "$tmp"' EXIT INT TERM

printf '>> Text einfügen, dann Strg-D.  (leer = Abbruch)\n' >&2
cat > "$tmp"
if [ ! -s "$tmp" ]; then printf '>> nichts eingefügt — abgebrochen.\n' >&2; exit 0; fi

printf '\n==== geschwärzt ====\n\n' >&2
"$here/private_read" "$tmp"
printf '\n====================\n' >&2
