#!/bin/sh
# crambler_clip — den MARKIERTEN Text schwärzen und in die Zwischenablage legen.
#
# EIN Schritt:  Text markieren → Tastenkürzel → Strg+V   (geschwärzt).
# Kein Strg+C nötig: gelesen wird die Markierung (PRIMARY-Auswahl), geschrieben das
# Clipboard. Ist nichts markiert, wird die vorhandene Zwischenablage genommen.
#
# Es ist derselbe Schwärzer wie bin/crambler (bin/private_read).
# Läuft im Terminal/Desktop des OPERATORS, nie im Agent-Käfig.
set -eu
here="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
priv="${OMEGAFLOW_PRIVATE:-$HOME/projects/omegaflow-personal}"

# Wayland zuerst, dann X11.
if [ -n "${WAYLAND_DISPLAY:-}" ] && command -v wl-paste >/dev/null 2>&1; then
  sel()   { wl-paste --primary --no-newline 2>/dev/null || true; }
  clip()  { wl-paste --no-newline 2>/dev/null || true; }
  put()   { wl-copy; }
elif command -v xclip >/dev/null 2>&1; then
  sel()   { xclip -selection primary -o 2>/dev/null || true; }
  clip()  { xclip -selection clipboard -o 2>/dev/null || true; }
  put()   { xclip -selection clipboard -i; }
elif command -v xsel >/dev/null 2>&1; then
  sel()   { xsel -p -o 2>/dev/null || true; }
  clip()  { xsel -b -o 2>/dev/null || true; }
  put()   { xsel -b -i; }
else
  printf 'crambler_clip: kein Clipboard-Werkzeug (installiere xclip oder wl-clipboard)\n' >&2
  exit 2
fi

tmp="$priv/.crambler.clip.$$"
trap 'rm -f "$tmp"' EXIT INT TERM

# Quelle: die Markierung; wenn leer, die Zwischenablage.
sel > "$tmp"
[ -s "$tmp" ] || clip > "$tmp"
if [ ! -s "$tmp" ]; then
  printf 'crambler_clip: nichts markiert und Zwischenablage leer.\n' >&2
  exit 0
fi

"$here/private_read" "$tmp" | put
if command -v notify-send >/dev/null 2>&1; then
  notify-send "crambler" "Markierung geschwärzt ✓ (Strg+V zum Einfügen)"
fi
