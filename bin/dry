#!/bin/sh
# dry — eine Ersetzung auf einer Kopie zeigen, bevor sie geschrieben wird.
#
#   bin/dry 's|a|b|' <datei> [<datei> ...]
#
# Schreibt nichts am Original. Kopiert nach scratch/dry.<pid>/, fährt sed -i auf
# der Kopie, zeigt Diff und Zeilenzahl. Exit 1, wenn sich etwas ändern würde.
# Erst nach Sicht: bin/write 's|a|b|' <datei> ... (derselbe Lauf, mit Schreiben).
set -u
expr="${1:-}"
[ -n "$expr" ] || { echo "usage: bin/dry 's|a|b|' <datei> [...]" >&2; exit 2; }
shift
[ $# -gt 0 ] || { echo "bin/dry: keine Datei" >&2; exit 2; }
root="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
work="${OMEGAFLOW_WORK:-$HOME/projects/omegaflow-work}"
tmp="$work/scratch/dry.$$"
mkdir -p "$tmp" || exit 2
trap 'rm -rf "$tmp"' 0 1 2 15
changed=0
for f in "$@"; do
    [ -f "$f" ] || { echo "bin/dry: $f fehlt" >&2; exit 2; }
    cp "$f" "$tmp/copy"
    sed -i "$expr" "$tmp/copy"
    if diff -q "$f" "$tmp/copy" >/dev/null 2>&1; then
        printf '%s: unveraendert\n' "$f"
    else
        n=$(diff "$f" "$tmp/copy" | sed -n '/^</p' | wc -l | tr -d ' ')
        printf '%s: %s Zeile(n) wuerden sich aendern\n' "$f" "$n"
        diff -u "$f" "$tmp/copy" | head -60
        changed=1
    fi
done
exit "$changed"
