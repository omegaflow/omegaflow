#!/bin/sh
# find — mehrere Köder in einem Lauf: suchen, Kandidaten snüffeln, nur halten lassen,
# was alle Köder trägt.
#
#   bin/find --header "time,station_id,discharge_m3s" \
#            --value 55041.35 --hex 08e2c0d464663440 \
#            --engine serper --top 5
#
# Jeder Köder ist optional, mindestens einer muss da sein. Hex ist kein Suchbegriff,
# sondern nur die Prüfung. Ein Kandidat ist erst MATCH, wenn jeder angegebene Köder
# hält; ein Wert, der nicht im Prefix steht, ist unbewiesen — nicht "nein".
set -u
export LC_ALL=C
root="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
bin="$root/target/release/archive_search"
engine=""
top=""
header=""
direct=""
fits=""
value=""
hex=""
ctx=""
near=""
pdf=0

usage() {
    cat >&2 <<'EOF'
find: usage: bin/find [--header "a,b,c"] [--value <zahl>[,<zahl>...]] [--hex <hex>] [--fits "K=V,K=V"] [--context "<begriff>"] [--pdf] [--near <abs|N%>] --engine <kanal> --top N
  mindestens ein Köder: --header, --value oder --hex
  --header  alle Spaltennamen müssen im sniffed header stehen
  --value   der Wert muss im Text stehen, sonst unbewiesen
  --hex     pattern=<hex> muss Treffer melden
EOF
    exit 2
}

while [ $# -gt 0 ]; do
    case "$1" in
        --header) [ $# -ge 2 ] && [ -n "$2" ] || usage; header="$2"; shift 2 ;;
        --fits) [ $# -ge 2 ] && [ -n "$2" ] || usage; fits="$2"; shift 2 ;;
        --url) [ $# -ge 2 ] && [ -n "$2" ] || usage; direct="$2"; shift 2 ;;
        --value)  [ $# -ge 2 ] && [ -n "$2" ] || usage; value="$2"; shift 2 ;;
        --hex)    [ $# -ge 2 ] && [ -n "$2" ] || usage; hex="$2"; shift 2 ;;
        --context) [ $# -ge 2 ] && [ -n "$2" ] || usage; ctx="$2"; shift 2 ;;
        --near) [ $# -ge 2 ] && [ -n "$2" ] || usage; near="$2"; shift 2 ;;
        --pdf) pdf=1; shift ;;
        --engine) [ $# -ge 2 ] && [ -n "$2" ] || usage; engine="$2"; shift 2 ;;
        --top)    [ $# -ge 2 ] && [ -n "$2" ] || usage; top="$2"; shift 2 ;;
        *) usage ;;
    esac
done

[ -n "$engine" ] || [ -n "$direct" ] || usage
[ -n "$top" ] || usage
 [ -n "$header$value$hex$fits" ] || usage

if [ -z "$header" ] && [ -z "$hex" ] && [ -n "$value" ]; then
    case "$value" in
        *.*) [ "${#value}" -ge 4 ] || { echo "find: \"$value\" ist zu kurz (mind. 4 Zeichen mit Dezimalpunkt)" >&2; exit 2; } ;;
        *) [ "${#value}" -ge 6 ] || { echo "find: \"$value\" ist zu kurz (mind. 6 Zeichen)" >&2; exit 2; } ;;
    esac
    echo "find: Warnung — Wert allein ist kein Beweis; ein Treffer bleibt eine Hypothese" >&2
fi

case "$engine" in
    '') [ -n "$direct" ] || usage ;;
    *[!a-z0-9-]*) usage ;;
esac
case "$top" in
    ''|*[!0-9]*) usage ;;
esac
[ "$top" -gt 0 ] || usage

# Header in Spaltennamen ohne Kommas zerlegen; leere Spalten sind kein stiller Default.
header_cols=""
if [ -n "$header" ]; then
    if ! header_cols="$(printf '%s\n' "$header" | awk -F, '{
            for (i = 1; i <= NF; i++) {
                gsub(/^[ \t]+|[ \t]+$/, "", $i)
                if ($i == "") exit 1
                printf "%s%s", (i > 1 ? " " : ""), $i
            }
        }')"; then
        usage
    fi
fi

# Hex normalisieren und prüfen; der Wert wird für die Prefix-Prüfung als Bytes gebraucht.
hex="$(printf '%s' "$hex" | tr -d '[:space:]' | tr 'A-F' 'a-f')"
if [ -n "$hex" ]; then
    case "$hex" in
        *[!0-9a-f]*) usage ;;
    esac
    [ $(( ${#hex} % 2 )) -eq 0 ] || usage
fi
if [ -n "$value" ]; then
    for v in $(printf '%s' "$value" | tr ',' ' '); do
        case "$v" in
            ""|*[!0-9.eE+-]*) echo "find: --value ist keine Zahl: $v" >&2; exit 2 ;;
        esac
    done
fi
# Hex bleibt draußen — es prüft nur.
query="$ctx"
for col in $header_cols; do
    [ -n "$query" ] && query="$query "
    query="$query\"$col\""
done
if [ -n "$value" ]; then
    [ -n "$query" ] && query="$query "
    query="$query$(printf '%s' "$value" | tr ',' ' ')"
fi
if [ "$pdf" -eq 1 ]; then
    query="$query filetype:pdf"
fi
if [ -z "$query" ] && [ -z "$direct" ]; then
    echo "find: --hex allein liefert keinen Suchbegriff — --header oder --value nötig" >&2
    exit 2
fi

if [ ! -x "$bin" ]; then
    echo "find: $bin fehlt — erst bauen (cargo build --release -p omegaflow-utils --bin archive_search)" >&2
    exit 2
fi

tmp=""
i=0
while [ "$i" -lt 100 ]; do
    tmp="${TMPDIR:-/tmp}/omegaflow-find.$$.$i"
    if mkdir -m 700 "$tmp" 2>/dev/null; then
        break
    fi
    i=$((i + 1))
done
if [ -z "$tmp" ] || [ ! -d "$tmp" ]; then
    echo "find: kein temporäres Verzeichnis" >&2
    exit 2
fi
trap 'rm -rf "$tmp"' 0 1 2 15

search_once() {
    "$bin" --"$engine" "$1" >"$tmp/search" 2>&1
}

if [ -n "$direct" ]; then
    printf "url %s\n" "$direct" >"$tmp/urls"
else
    search_once "$query"
fi
if [ "$engine" = serper ] && grep -q 'pending — Serper HTTP 400' "$tmp/search"; then
    case "$query" in
        *'"'*)
            echo "find: Quotes abgelehnt, Suche ohne"
            query="$(printf '%s' "$query" | tr -d '"' | sed 's/  */ /g; s/^ //; s/ $//')"
            search_once "$query"
            ;;
    esac
fi

if [ -z "$direct" ]; then
    awk -v n="$top" '
    /^url / || /^\[[^]]*\] url / {
        sub(/^\[[^]]*\] /, "")
        print
        if (++c >= n) exit
    }' "$tmp/search" >"$tmp/urls"
    candidates="$(wc -l <"$tmp/urls" | tr -d ' ')"
    if [ "$candidates" -eq 0 ]; then
        if grep -q 'network:  archive_search' "$tmp/search"; then
            echo "find: unbekannte Engine '$engine' — archive_search kennt sie nicht" >&2
            exit 2
        fi
        sed -n '/^pending —/p; /^absent —/p' "$tmp/search" | sed 's/^/find: /'
    fi
else
    candidates="$(wc -l <"$tmp/urls" | tr -d ' ')"
fi
matches=0
twins=0
nears=0
while IFS= read -r line; do
    [ -n "$line" ] || continue
    url="$(printf '%s\n' "$line" | sed -n 's/^url \([^[:space:]]*\).*/\1/p')"
    [ -n "$url" ] || continue
    title="$(printf '%s\n' "$line" | awk -F'\t' '{
            for (i = 2; i <= NF; i++) if ($i ~ /^title: /) {
                sub(/^title: /, "", $i)
                print $i
                exit
            }
        }')"

    sniff_out="$("$bin" --sniff "$url" 2>&1)"
    header_line="$(printf '%s\n' "$sniff_out" | sed -n 's/^\(\[sniff\] \)\{0,1\}header //p' | head -n 1)"

    header_state=""
    header_note=""
    if [ -n "$header" ]; then
        if [ "$header_line" = absent ] || [ -z "$header_line" ]; then
            header_state="fehlt"
            header_note="kein header im Prefix"
        else
            # Der Header kann bei HTML-Seiten sehr lang werden: über stdin, nicht als argv.
            if missing_cols="$(printf '%s\n' "$header_line" | awk -v cols="$header_cols" 'BEGIN{
                    m = split(cols, b, " ")
                }
                {
                    n = split($0, a, ",")
                    for (i = 1; i <= n; i++) seen[a[i]] = 1
                }
                END {
                    miss = ""
                    for (i = 1; i <= m; i++)
                        if (!(b[i] in seen)) miss = miss (miss == "" ? "" : ",") b[i]
                    print miss
                }')"; then
                if [ -z "$missing_cols" ]; then
                    header_state="erfüllt"
                else
                    header_state="fehlt"
                    header_note="nicht im header: $missing_cols"
                fi
            else
                header_state="unbewiesen"
                header_note="Header nicht lesbar"
            fi
        fi
    fi

    fits_state=""
    fits_note=""
    if [ -n "$fits" ]; then
        fits_line="$(printf '%s\n' "$sniff_out" | sed -n 's/^\(\[sniff\] \)\{0,1\}fits //p' | head -n 1)"
        if [ -z "$fits_line" ]; then
            fits_state="fehlt"
            fits_note="kein FITS-Header"
        else
            miss=""
            for kv in $(printf '%s' "$fits" | tr ',' ' '); do
                printf '%s' "$fits_line" | grep -qF -- "$kv" || miss="$miss $kv"
            done
            if [ -z "$miss" ]; then
                fits_state="erfüllt"
            else
                fits_state="fehlt"
                fits_note="nicht:$miss"
            fi
        fi
    fi
    value_state=""
    value_note=""
    if [ -n "$value" ]; then
        body="$(curl -sSL --max-time 90 "$url" 2>/dev/null | head -c 30000000)"
        case "$body" in
            %PDF*)
                if command -v pdftotext >/dev/null 2>&1; then
                    printf '%s' "$body" > "$tmp/cand.pdf"
                    pdftotext -q "$tmp/cand.pdf" "$tmp/cand.txt" 2>/dev/null
                    if [ -s "$tmp/cand.txt" ]; then
                        body="$(cat "$tmp/cand.txt")"
                    fi
                fi
                ;;
        esac
        total=0
        ok_all=1
        far_any=0
        near_any=0
        maxdelta=0
        maxdelta_s=""
        for v in $(printf '%s' "$value" | tr ',' ' '); do
            total=$((total + 1))
            tol="$(awk -v v="$v" 'BEGIN{ n=split(v,a,"."); if(n==1){print "0.5"} else { d=length(a[2]); printf "%.10g", 5*10^(-(d+1)) } }')"
            nearest="$(printf '%s' "$body" | grep -oE '[-+]?[0-9]+([.][0-9]+)?([eE][-+]?[0-9]+)?' | awk -v t="$v" 'BEGIN{m=-1} { d=$1-t; if(d<0)d=-d; if(m<0||d<m){m=d} } END{ if(m>=0) printf "%.10g", m }')"
            if [ -z "$nearest" ]; then
                ok_all=0
                far_any=1
                maxdelta_s="keine Zahl"
                continue
            fi
            cls="$(awk -v d="$nearest" -v tol="$tol" -v v="$v" -v spec="$near" 'BEGIN{
                ad=(v<0)?-v:v;
                if (spec != "") {
                    if (spec ~ /%$/) { p=spec; sub(/%$/,"",p); nb=ad*p/100 } else { nb=spec+0 }
                } else {
                    nb=20*tol; if (0.01*ad>nb) nb=0.01*ad
                }
                if (d<=tol) print 1; else if (ad>0 && d<=nb) print 2; else print 3 }')"
            if [ "$cls" != "1" ]; then
                ok_all=0
            fi
            [ "$cls" = "2" ] && near_any=1
            [ "$cls" = "3" ] && far_any=1
            bigger="$(awk -v d="$nearest" -v m="$maxdelta" 'BEGIN{print (d>m)?"1":"0"}')"
            if [ "$bigger" = "1" ]; then
                maxdelta="$nearest"
                maxdelta_s="$(awk -v d="$nearest" 'BEGIN{printf "%.6g", d}')"
            fi
        done
        if [ "$ok_all" = "1" ]; then
            value_state="erfüllt"
            value_note="$total/$total, max Delta $maxdelta_s"
        elif [ "$far_any" = "0" ] && [ "$near_any" = "1" ]; then
            value_state="nah"
            value_note="max Delta $maxdelta_s — anderes Werkzeug/Messpunkt denkbar"
        else
            value_state="daneben"
            value_note="$total Werte, max Delta $maxdelta_s"
        fi
    fi
    hex_state=""
    hex_note=""
    if [ -n "$hex" ]; then
        hex_out="$("$bin" --sniff "$url" "pattern=$hex" 2>&1)"
        hex_line="$(printf '%s\n' "$hex_out" | grep -F "pattern $hex hits" | head -n 1)"
        if [ -z "$hex_line" ]; then
            hex_state="unbewiesen"
            hex_note="Musterzeile fehlt (Sniff pending?)"
        else
            hex_hits="$(printf '%s\n' "$hex_line" | sed "s/^.*pattern $hex hits //")"
            if [ -n "$hex_hits" ]; then
                hex_state="erfüllt"
            else
                hex_state="fehlt"
                hex_note="0 Treffer"
            fi
        fi
    fi

    ok=1
    if [ -n "$header" ] && [ "$header_state" != erfüllt ]; then ok=0; fi
    if [ -n "$fits" ] && [ "$fits_state" != erfüllt ]; then ok=0; fi
    if [ -n "$value" ] && [ "$value_state" != erfüllt ]; then ok=0; fi
    if [ -n "$hex" ] && [ "$hex_state" != erfüllt ]; then ok=0; fi

    nearhit=0
    if [ "$ok" -eq 0 ] && [ -n "$value" ] && [ "$value_state" = "nah" ]; then
        near_ok=1
        if [ -n "$header" ] && [ "$header_state" != erfüllt ]; then near_ok=0; fi
        if [ -n "$fits" ] && [ "$fits_state" != erfüllt ]; then near_ok=0; fi
        if [ -n "$hex" ] && [ "$hex_state" != erfüllt ]; then near_ok=0; fi
        [ "$near_ok" -eq 1 ] && nearhit=1
    fi

    if [ "$ok" -eq 1 ]; then
        if [ -n "$header" ] && [ -n "$value" ] && [ -n "$hex" ]; then
            verdict="ZWILLING"
            twins=$((twins + 1))
        else
            verdict="MATCH"
        fi
        matches=$((matches + 1))
    elif [ "$nearhit" -eq 1 ]; then
        verdict="NAH"
        nears=$((nears + 1))
    else
        verdict="kein-match"
    fi
    [ -n "$title" ] && printf '   %s\n' "$title"
    [ -n "$header" ] && printf '   header: %s%s\n' "$header_state" "$( [ -n "$header_note" ] && printf ' (%s)' "$header_note" )"
    [ -n "$fits" ] && printf '   fits: %s%s\n' "$fits_state" "$( [ -n "$fits_note" ] && printf ' (%s)' "$fits_note" )"
    [ -n "$value" ] && printf '   value: %s%s\n' "$value_state" "$( [ -n "$value_note" ] && printf ' (%s)' "$value_note" )"
    [ -n "$hex" ] && printf '   hex: %s%s\n' "$hex_state" "$( [ -n "$hex_note" ] && printf ' (%s)' "$hex_note" )"
done <"$tmp/urls"

printf '\nfind: %s Kandidaten, %s Treffer, %s Zwillinge, %s nah\n' "$candidates" "$matches" "$twins" "$nears"
