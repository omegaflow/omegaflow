#!/bin/sh
# frei_search — the free research agent's ONLY tool.
#
# It forwards to archive_search but refuses every LOCAL-DISK mode
# (--root / --index / --mft / --git). The free agent is a free external model;
# it reads the NET only, never sniffs this disk. Writes go to the tool's own
# spill under the public work yard.
set -eu
root="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
for a in "$@"; do
  case "$a" in
    --root|--root=*|--index|--index=*|--mft|--mft=*|--git|--git=*)
      echo "frei_search: '$a' is a local-disk mode — refused; the free agent reads the net only" >&2
      exit 2
      ;;
  esac
done
exec "$root/bin/archive_search" "$@"
