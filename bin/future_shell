#!/bin/sh
# future_shell — the future session's shell: it refreshes the redacted mirror, then opens
# a shell inside it. So the snapshot is fresh at every session start — the mirror never
# ages between sessions.
#
# It runs OUTSIDE the cage (it fills the mirror through the redactor). The session whose
# shell is this wrapper starts in the mirror, never in the private house.
set -eu
root="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
spiegel="${OMEGAFLOW_FUTURE_SPIEGEL:-$HOME/projects/omegaflow-work/future-spiegel}"
"$root/bin/future_spiegel" >&2
export OMEGAFLOW_FUTURE_SPIEGEL="$spiegel"
cd "$spiegel"
exec /bin/bash
