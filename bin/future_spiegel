#!/bin/sh
# future_spiegel — fills the redacted mirror for the future line.
#
# Every text file of the private house goes through the redactor (bin/private_read) and
# lands as a placeholder-only copy under the mirror. The future session (a strong model,
# outside the private house) works on the mirror — it never sees the raw file.
#
# Run OUTSIDE the cage (it reads the private house). Usage: future_spiegel
set -eu
root="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
priv="${OMEGAFLOW_PRIVATE:-$HOME/projects/omegaflow-personal}"
out="${OMEGAFLOW_FUTURE_SPIEGEL:-$HOME/projects/omegaflow-work/future-spiegel}"
mkdir -p "$out"
count=0
fd -H -t f -e md -e txt -e phi -e φ -e json -e toml . "$priv" 2>/dev/null | while IFS= read -r f; do
  rel="${f#"$priv"/}"
  mkdir -p "$out/$(dirname "$rel")"
  if "$root/bin/private_read" "$f" > "$out/$rel" 2>/dev/null; then
    count=$((count + 1))
  fi
done
printf 'future_spiegel: %s\n' "$out"
