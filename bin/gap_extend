#!/bin/sh
set -u

LC_ALL=C
export LC_ALL

root="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
bracket="$root/bin/bracket"
search="$root/bin/archive_search"

usage() {
    cat >&2 <<'EOF'
gap_extend: usage: bin/gap_extend <serie> --from <iso> --to <iso> --source <arm> [--query <begriff>] [--unit <unit>] [--cadence <sec>] [--live] [--out <datei>]
  <serie>       vorhandene Reihe (Text/CSV, Zeit in der ersten Spalte)
  --from/--to   Suchfenster; die Kadenz kommt aus bin/bracket --expect
  --source      archive_search-Arm ohne führende Striche (z. B. oai-pmh, frbcat, hapi, live, goes-live)
  --query       Suchbegriff oder Live-Ziel (Listing-URL bzw. "g18 FDCF"); für jede Suche Pflicht
  --unit        erwartete Einheit; sonst die Einheit, die --sniff in <serie> findet
  --cadence     Kadenz in Sekunden; sonst die gemessene Kadenz aus bracket
  --live        nur der neueste Zeitpunkt des Live-Arms (nur mit live|goes-live)
  --out         neue Datei; <serie> bleibt unverändert, vorhandene --out wird nicht überschrieben
  Kandidaten werden in Rangfolge gesnifft; nach 45 s endet die Suche als pending (offene Kandidaten bleiben ungeprüft)
  es wird nichts interpoliert: nur gemessene Zeilen außerhalb des vorhandenen Bereichs
EOF
    exit 2
}

die2() { printf 'gap_extend: %s\n' "$*" >&2; exit 2; }
pending() { printf 'gap_extend: pending — %s\n' "$*"; exit 3; }
pnorm() { printf '%s' "$1" | tr 'A-Z' 'a-z' | tr -d '[:space:]'; }
info_get() { sed -n "s/^$1	//p" "$2" | head -n 1; }

serie=""
from=""
to=""
source=""
query=""
unit=""
cadence=""
live=0
out=""

while [ $# -gt 0 ]; do
    case "$1" in
        --from)
            [ $# -ge 2 ] && [ -n "$2" ] || usage
            from="$2"; shift 2 ;;
        --to)
            [ $# -ge 2 ] && [ -n "$2" ] || usage
            to="$2"; shift 2 ;;
        --source)
            [ $# -ge 2 ] && [ -n "$2" ] || usage
            source="$2"; shift 2 ;;
        --query)
            [ $# -ge 2 ] && [ -n "$2" ] || usage
            query="$2"; shift 2 ;;
        --unit)
            [ $# -ge 2 ] && [ -n "$2" ] || usage
            unit="$2"; shift 2 ;;
        --cadence)
            [ $# -ge 2 ] && [ -n "$2" ] || usage
            cadence="$2"; shift 2 ;;
        --out)
            [ $# -ge 2 ] && [ -n "$2" ] || usage
            out="$2"; shift 2 ;;
        --live) live=1; shift ;;
        -h|--help) usage ;;
        --)
            shift
            [ $# -eq 1 ] || die2 "genau eine Serie erwartet"
            [ -z "$serie" ] || die2 "mehr als eine Serie"
            serie="$1"; shift ;;
        -*)
            die2 "unbekannte Option: $1" ;;
        *)
            [ -z "$serie" ] || die2 "mehr als eine Serie: $serie und $1"
            serie="$1"; shift ;;
    esac
done

[ -n "$serie" ] || usage
[ -n "$from" ] || usage
[ -n "$to" ] || usage
[ -n "$source" ] || die2 "fehlt: --source <arm>"
[ -f "$serie" ] && [ -r "$serie" ] || die2 "Serie nicht lesbar: $serie"
[ -x "$bracket" ] || die2 "$bracket fehlt"
[ -x "$search" ] || die2 "$search fehlt"

arm="${source#--}"
case "$arm" in
    ''|-*|*[!A-Za-z0-9._-]*) die2 "unbrauchbarer Arm: $source" ;;
esac

live_mode=0
case "$arm" in
    live|goes-live) live_mode=1 ;;
esac
if [ "$live" -eq 1 ] && [ "$live_mode" -eq 0 ]; then
    die2 "--live braucht --source live|goes-live (nicht $arm)"
fi
if [ "$live_mode" -eq 1 ] && [ "$live" -eq 0 ]; then
    printf 'gap_extend: %s ist ein Live-Arm, es wird nur der neueste Zeitpunkt gelesen\n' "$arm"
fi

if [ -n "$cadence" ]; then
    awk -v c="$cadence" 'BEGIN { exit !(c ~ /^[0-9]+([.][0-9]+)?$/ && c + 0 > 0) }' ||
        die2 "--cadence braucht positive Sekunden: $cadence"
fi

if [ -n "$out" ]; then
    [ "$out" = "$serie" ] && die2 "--out ist die Serie selbst: $out"
    [ -e "$out" ] && die2 "--out existiert schon: $out (kein stilles Append)"
    outdir="$(dirname -- "$out")"
    [ -d "$outdir" ] || die2 "Zielverzeichnis fehlt: $outdir"
fi

tmpdir="$(mktemp -d "${TMPDIR:-/tmp}/gap_extend.XXXXXX")" || die2 "kein Temp-Verzeichnis"
trap 'rm -rf "$tmpdir"' EXIT
trap 'exit 130' HUP INT TERM

: > "$tmpdir/times"

bout="$("$bracket" "$serie" --from "$from" --to "$to" --expect 2>"$tmpdir/bracket.err")"
brc=$?
[ "$brc" -eq 0 ] || pending "bracket konnte $serie nicht klammern (rc $brc): $(head -n 1 "$tmpdir/bracket.err")"

bcad="$(printf '%s\n' "$bout" | sed -n 's/.*kadenz \([0-9][0-9.]*\)s.*/\1/p' | head -n 1)"
case "$bout" in
    *"erwartet absent"*) bcad="" ;;
esac

if [ -n "$cadence" ]; then
    cad="$cadence"
    cadfrom="--cadence"
elif [ -n "$bcad" ]; then
    cad="$bcad"
    cadfrom="bracket"
else
    pending "Kadenz nicht bestimmbar ($bout); --cadence <sec> setzen"
fi

sout="$("$search" --sniff "$serie" 2>"$tmpdir/sniff-serie.err")"
src_rc=$?
[ "$src_rc" -eq 0 ] || pending "sniff $serie (rc $src_rc): $(head -n 1 "$tmpdir/sniff-serie.err")"

s_header="$(printf '%s\n' "$sout" | sed -n 's/^\[sniff\] header //p' | head -n 1)"
s_unit="$(printf '%s\n' "$sout" | sed -n 's/^\[sniff\] unit //p' | head -n 1)"
[ "$s_header" = "absent" ] && s_header=""
[ "$s_unit" = "absent" ] && s_unit=""

awk -v times="$tmpdir/times" -v from_raw="$from" -v to_raw="$to" '
function trim(s) {
    gsub(/^[ \t\r\n]+/, "", s)
    gsub(/[ \t\r\n]+$/, "", s)
    return s
}
function isnum(s) {
    return s ~ /^[-+]?([0-9]+([.][0-9]*)?|[.][0-9]+)([eE][-+]?[0-9]+)?$/
}
function days_from_civil(y, m, d,   era, yoe, doy, doe) {
    y -= (m <= 2)
    era = int((y >= 0 ? y : y - 399) / 400)
    yoe = y - era * 400
    doy = int((153 * (m + (m > 2 ? -3 : 9)) + 2) / 5) + d - 1
    doe = yoe * 365 + int(yoe / 4) - int(yoe / 100) + doy
    return era * 146097 + doe - 719468
}
function parse_time(s,   z, sign, off, oh, om, date, clock, np, dp, nd, tp, nt, y, mo, da, h, mi, se, i) {
    s = trim(s)
    if (isnum(s)) return s + 0
    tzsec = 0
    if (s ~ /[Zz]$/) {
        sub(/[Zz]$/, "", s)
    } else if (match(s, /[+-][0-9][0-9]:[0-9][0-9]$/)) {
        z = substr(s, RSTART, RLENGTH)
        s = substr(s, 1, RSTART - 1)
        sign = (substr(z, 1, 1) == "-") ? -1 : 1
        gsub(/:/, "", z)
        off = substr(z, 2) + 0
        oh = int(off / 100)
        om = off % 100
        tzsec = sign * (oh * 3600 + om * 60)
    } else if (match(s, /[+-][0-9][0-9][0-9][0-9]$/)) {
        z = substr(s, RSTART, RLENGTH)
        s = substr(s, 1, RSTART - 1)
        sign = (substr(z, 1, 1) == "-") ? -1 : 1
        off = substr(z, 2) + 0
        oh = int(off / 100)
        om = off % 100
        tzsec = sign * (oh * 3600 + om * 60)
    }
    gsub(/[Tt]/, " ", s)
    gsub(/[ \t]+/, " ", s)
    np = split(s, p, " ")
    if (np < 1 || np > 2) { perr = 1; return 0 }
    date = p[1]
    nd = split(date, dp, "-")
    if (nd != 3) { perr = 1; return 0 }
    y = dp[1] + 0; mo = dp[2] + 0; da = dp[3] + 0
    h = 0; mi = 0; se = 0
    if (np == 2) {
        nt = split(p[2], tp, ":")
        if (nt < 1 || nt > 3) { perr = 1; return 0 }
        h = tp[1] + 0
        if (nt >= 2) mi = tp[2] + 0
        if (nt >= 3) se = tp[3] + 0
    }
    if (y < 1 || mo < 1 || mo > 12 || da < 1 || da > 31 ||
        h < 0 || h > 23 || mi < 0 || mi > 59 || se < 0 || se >= 61) {
        perr = 1; return 0
    }
    return days_from_civil(y, mo, da) * 86400 + h * 3600 + mi * 60 + se - tzsec
}
BEGIN {
    perr = 0
    ft = parse_time(from_raw)
    if (perr) { print "error	from"; exit 2 }
    perr = 0
    tt = parse_time(to_raw)
    if (perr) { print "error	to"; exit 2 }
    if (tt < ft) { print "error	order"; exit 2 }
    lineno = 0
    nd = 0
    firstline = 0
    header = 0
    cmin_flag = 0
}
{
    line = $0
    sub(/\r$/, "", line)
    lineno++
    if (line ~ /^[ \t]*$/ || line ~ /^[ \t]*#/) next
    nf = split(line, f, /[ \t,]+/)
    if (nf < 2) next
    ttok = f[1]
    if (f[1] ~ /^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]$/ &&
        nf >= 3 && f[2] ~ /^[0-9][0-9]:[0-9][0-9]/) {
        ttok = f[1] " " f[2]
    }
    if (firstline == 0) {
        firstline = lineno
        if (ttok ~ /^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/ || isnum(ttok)) header = 0
        else header = 1
    }
    perr = 0
    t = parse_time(ttok)
    if (perr) next
    nd++
    printf "%.0f\n", t > times
    if (nd == 1) {
        sfirst = t
        firstraw = trim(ttok)
        sfields = nf
        firstdata = lineno
        stclass = (ttok ~ /^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/) ? "iso" : "num"
    }
    slast = t
    lastraw = trim(ttok)
}
END {
    printf "rows	%d\n", nd
    printf "header	%d\n", header
    printf "fields	%d\n", (nd > 0 ? sfields : 0)
    printf "firstdata	%d\n", (nd > 0 ? firstdata : 0)
    printf "tclass	%s\n", (nd > 0 ? stclass : "")
    printf "first	%.0f	%s\n", sfirst, (nd > 0 ? firstraw : "")
    printf "last	%.0f	%s\n", slast, (nd > 0 ? lastraw : "")
    printf "from	%.0f\n", ft
    printf "to	%.0f\n", tt
}
' "$serie" > "$tmpdir/serie.info"
sirc=$?
[ "$sirc" -eq 0 ] || pending "Serie nicht parsebar (rc $sirc)"

nrows="$(info_get rows "$tmpdir/serie.info")"
hflag="$(info_get header "$tmpdir/serie.info")"
sfields_v="$(info_get fields "$tmpdir/serie.info")"
stclass_v="$(info_get tclass "$tmpdir/serie.info")"
firstdata="$(info_get firstdata "$tmpdir/serie.info")"
sfirst_v="$(info_get first "$tmpdir/serie.info")"
slast_v="$(info_get last "$tmpdir/serie.info")"
ft_v="$(info_get from "$tmpdir/serie.info")"
tt_v="$(info_get to "$tmpdir/serie.info")"

[ "${nrows:-0}" -gt 0 ] || pending "keine Zeitzeile in $serie"
[ -n "$firstdata" ] && [ "$firstdata" -gt 0 ] || pending "erste Zeitzeile in $serie nicht bestimmbar"

sfirst_ts="${sfirst_v%%	*}"
sfirst_raw="${sfirst_v#*	}"
slast_ts="${slast_v%%	*}"
slast_raw="${slast_v#*	}"

if [ -n "$unit" ]; then
    eu="$unit"
elif [ -n "$s_unit" ]; then
    eu="$s_unit"
else
    eu=""
fi

[ -n "$query" ] || pending "--source $arm braucht --query <begriff>"

res="$("$search" "--$arm" "$query" 2>"$tmpdir/suche.err")"
qrc=$?
printf '%s\n' "$res" | awk '
{
    line = $0
    sub(/\r$/, "", line)
    if (line == "") next
    sub(/^\[[^]]+\][ \t]+/, "", line)
    if (line ~ /^(absent|pending)([ \t]|$)/) next
    split(line, f, /[ \t]+/)
    if (f[1] == "url" || f[1] == "path" || f[1] == "file") { print f[2]; next }
    if (f[1] ~ /^https?:\/\//) print f[1]
}' | awk '!seen[$0]++' > "$tmpdir/cands"

ncand="$(awk 'END { print NR }' "$tmpdir/cands")"
[ "$ncand" -gt 0 ] ||
    pending "Quelle $arm lieferte keinen Kandidaten (rc $qrc): $(printf '%s\n' "$res" | head -n 1)"

[ "$live_mode" -eq 0 ] && [ "$hflag" -eq 1 ] && [ -z "$s_header" ] &&
    pending "Serie trägt einen Header, --sniff liest ihn nicht"

accepted=0
reason="kein Kandidat geprüft"
cand_url=""
cand_sha=""
cand_unit=""
cand_header=""
start_s="$(date +%s)"
ci=0

while IFS= read -r cand; do
    [ -n "$cand" ] || continue
    ci=$((ci + 1))
    if [ $(( $(date +%s) - start_s )) -ge 45 ]; then
        reason="Kandidaten-Budget 45s erschöpft: $((ncand - ci + 1)) von $ncand Kandidaten nicht geprüft"
        break
    fi
    cfile="$cand"
    isurl=0
    case "$cand" in http://*|https://*) isurl=1 ;; esac

    cout="$("$search" --sniff "$cand" 2>"$tmpdir/sniff-k.err")"
    crc=$?
    if [ "$crc" -ne 0 ]; then
        reason="$cand: sniff rc $crc: $(head -n 1 "$tmpdir/sniff-k.err")"
        continue
    fi
    c_header="$(printf '%s\n' "$cout" | sed -n 's/^\[sniff\] header //p' | head -n 1)"
    c_unit="$(printf '%s\n' "$cout" | sed -n 's/^\[sniff\] unit //p' | head -n 1)"
    c_timecol="$(printf '%s\n' "$cout" | sed -n 's/^\[sniff\] time_column //p' | head -n 1)"
    c_sha="$(printf '%s\n' "$cout" | sed -n 's/^\[sniff\] chunk .* sha256 \([0-9a-f]\{64\}\)$/\1/p' | head -n 1)"
    [ "$c_header" = "absent" ] && c_header=""
    [ "$c_unit" = "absent" ] && c_unit=""

    if [ "$c_timecol" = "absent" ]; then
        reason="$cand: Zeitbasis fehlt (time_column absent)"
        continue
    fi
    if [ "$hflag" -eq 1 ]; then
        if [ -z "$c_header" ]; then
            reason="$cand: Header fehlt (Serie: $s_header)"
            continue
        fi
        if [ "$(pnorm "$c_header")" != "$(pnorm "$s_header")" ]; then
            reason="$cand: Header/Zeitbasis $c_header ≠ $s_header"
            continue
        fi
    fi
    if [ -n "$eu" ]; then
        if [ -z "$c_unit" ]; then
            reason="$cand: Unit fehlt (erwartet $eu)"
            continue
        fi
        if [ "$(pnorm "$c_unit")" != "$(pnorm "$eu")" ]; then
            reason="$cand: Unit $c_unit ≠ $eu"
            continue
        fi
    fi

    if [ "$isurl" -eq 1 ]; then
        command -v curl >/dev/null 2>&1 || pending "curl fehlt für den URL-Kandidaten $cand"
        cfile="$tmpdir/kandidat.data"
        curl -fsSL --max-time 30 -o "$cfile" -- "$cand" 2>"$tmpdir/curl.err" || {
            reason="$cand: URL nicht lesbar"
            continue
        }
    else
        [ -f "$cand" ] && [ -r "$cand" ] || {
            reason="$cand: Datei nicht lesbar"
            continue
        }
    fi

    : > "$tmpdir/early.tsv"
    : > "$tmpdir/late.tsv"
    awk -v sfirst="$sfirst_ts" -v slast="$slast_ts" -v ft="$ft_v" -v tt="$tt_v" \
        -v mode="$live_mode" -v sfields="$sfields_v" -v stclass="$stclass_v" \
        -v times="$tmpdir/times" -v efile="$tmpdir/early.tsv" -v lfile="$tmpdir/late.tsv" '
function trim(s) {
    gsub(/^[ \t\r\n]+/, "", s)
    gsub(/[ \t\r\n]+$/, "", s)
    return s
}
function isnum(s) {
    return s ~ /^[-+]?([0-9]+([.][0-9]*)?|[.][0-9]+)([eE][-+]?[0-9]+)?$/
}
function days_from_civil(y, m, d,   era, yoe, doy, doe) {
    y -= (m <= 2)
    era = int((y >= 0 ? y : y - 399) / 400)
    yoe = y - era * 400
    doy = int((153 * (m + (m > 2 ? -3 : 9)) + 2) / 5) + d - 1
    doe = yoe * 365 + int(yoe / 4) - int(yoe / 100) + doy
    return era * 146097 + doe - 719468
}
function parse_time(s,   z, sign, off, oh, om, date, clock, np, dp, nd, tp, nt, y, mo, da, h, mi, se, i) {
    s = trim(s)
    if (isnum(s)) return s + 0
    tzsec = 0
    if (s ~ /[Zz]$/) {
        sub(/[Zz]$/, "", s)
    } else if (match(s, /[+-][0-9][0-9]:[0-9][0-9]$/)) {
        z = substr(s, RSTART, RLENGTH)
        s = substr(s, 1, RSTART - 1)
        sign = (substr(z, 1, 1) == "-") ? -1 : 1
        gsub(/:/, "", z)
        off = substr(z, 2) + 0
        oh = int(off / 100)
        om = off % 100
        tzsec = sign * (oh * 3600 + om * 60)
    } else if (match(s, /[+-][0-9][0-9][0-9][0-9]$/)) {
        z = substr(s, RSTART, RLENGTH)
        s = substr(s, 1, RSTART - 1)
        sign = (substr(z, 1, 1) == "-") ? -1 : 1
        off = substr(z, 2) + 0
        oh = int(off / 100)
        om = off % 100
        tzsec = sign * (oh * 3600 + om * 60)
    }
    gsub(/[Tt]/, " ", s)
    gsub(/[ \t]+/, " ", s)
    np = split(s, p, " ")
    if (np < 1 || np > 2) { perr = 1; return 0 }
    date = p[1]
    nd = split(date, dp, "-")
    if (nd != 3) { perr = 1; return 0 }
    y = dp[1] + 0; mo = dp[2] + 0; da = dp[3] + 0
    h = 0; mi = 0; se = 0
    if (np == 2) {
        nt = split(p[2], tp, ":")
        if (nt < 1 || nt > 3) { perr = 1; return 0 }
        h = tp[1] + 0
        if (nt >= 2) mi = tp[2] + 0
        if (nt >= 3) se = tp[3] + 0
    }
    if (y < 1 || mo < 1 || mo > 12 || da < 1 || da > 31 ||
        h < 0 || h > 23 || mi < 0 || mi > 59 || se < 0 || se >= 61) {
        perr = 1; return 0
    }
    return days_from_civil(y, mo, da) * 86400 + h * 3600 + mi * 60 + se - tzsec
}
BEGIN {
    while ((getline ln < times) > 0) seen[ln + 0] = 1
    close(times)
    lineno = 0
    nd = 0
    firstline = 0
    cheader = 0
    mism = 0
    ne = 0
    nl = 0
    lt_count = 0
    cmin_flag = 0
    cmax_flag = 0
    ctclass = ""
    newest = 0
    newestraw = ""
}
{
    line = $0
    sub(/\r$/, "", line)
    lineno++
    if (line ~ /^[ \t]*$/ || line ~ /^[ \t]*#/) next
    nf = split(line, f, /[ \t,]+/)
    if (nf < 2) next
    ttok = f[1]
    if (f[1] ~ /^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]$/ &&
        nf >= 3 && f[2] ~ /^[0-9][0-9]:[0-9][0-9]/) {
        ttok = f[1] " " f[2]
    }
    if (firstline == 0) {
        firstline = lineno
        if (ttok ~ /^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/ || isnum(ttok)) cheader = 0
        else cheader = 1
    }
    perr = 0
    t = parse_time(ttok)
    if (perr) next
    if (ctclass == "")
        ctclass = (ttok ~ /^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/) ? "iso" : "num"
    nd++
    if (!cmin_flag) { cmin = t; cminraw = trim(ttok); cmin_flag = 1 }
    if (!cmax_flag) { cmax = t; cmaxraw = trim(ttok); cmax_flag = 1 }
    if (t < cmin) { cmin = t; cminraw = trim(ttok) }
    if (t > cmax) { cmax = t; cmaxraw = trim(ttok) }
    if (sfields + 0 > 0 && nf != sfields + 0) { mism++; next }
    key = sprintf("%.0f", t)
    if (key in seen) next
    if (mode + 0 == 1) {
        lt_count++
        lt[lt_count] = t
        lraw[lt_count] = line
    } else if (t < sfirst + 0 || t > slast + 0) {
        if (t >= ft + 0 && t < tt + 0) {
            if (t < sfirst + 0) {
                printf "%.0f\t%s\n", t, line > efile
                ne++
            } else {
                printf "%.0f\t%s\n", t, line > lfile
                nl++
            }
        }
    }
}
END {
    if (mode + 0 == 1 && lt_count > 0) {
        maxt = lt[1]
        for (i = 2; i <= lt_count; i++) if (lt[i] > maxt) maxt = lt[i]
        if (maxt > slast + 0) {
            for (i = 1; i <= lt_count; i++)
                if (lt[i] == maxt) {
                    printf "%.0f\t%s\n", lt[i], lraw[i] > lfile
                    nl++
                }
            newest = maxt
            newestraw = cmaxraw
        } else {
            newest = maxt
        }
    }
    printf "rows	%d\n", nd
    printf "mismatch	%d\n", mism
    printf "header	%d\n", cheader
    printf "tclass	%s\n", ctclass
    printf "cmin	%.0f	%s\n", cmin, cminraw
    printf "cmax	%.0f	%s\n", cmax, cmaxraw
    printf "early	%d\n", ne
    printf "late	%d\n", nl
    printf "newest	%.0f	%s\n", newest, newestraw
}
' "$cfile" > "$tmpdir/cinfo"
ccrc=$?

    if [ "$ccrc" -ne 0 ]; then
        reason="$cand: Zeilen nicht lesbar (rc $ccrc)"
        continue
    fi

    c_rows="$(info_get rows "$tmpdir/cinfo")"
    c_mism="$(info_get mismatch "$tmpdir/cinfo")"
    c_tclass="$(info_get tclass "$tmpdir/cinfo")"
    c_early="$(info_get early "$tmpdir/cinfo")"
    c_late="$(info_get late "$tmpdir/cinfo")"

    if [ "${c_rows:-0}" -eq 0 ]; then
        reason="$cand: keine Zeitzeile lesbar"
        continue
    fi
    if [ "${c_mism:-0}" -gt 0 ]; then
        reason="$cand: Spaltenzahl weicht von $sfields_v ab ($c_mism Zeilen)"
        continue
    fi
    if [ "$c_tclass" != "$stclass_v" ]; then
        reason="$cand: Zeitbasis $c_tclass ≠ $stclass_v"
        continue
    fi
    if [ "${c_early:-0}" -eq 0 ] && [ "${c_late:-0}" -eq 0 ]; then
        if [ "$live_mode" -eq 1 ]; then
            reason="$cand: kein neuerer Zeitpunkt als $slast_raw"
        else
            reason="$cand: keine Zeile außerhalb $sfirst_raw..$slast_raw im Fenster $from..$to"
        fi
        continue
    fi

    cand_url="$cand"
    cand_sha="$c_sha"
    cand_unit="$c_unit"
    cand_header="$c_header"
    accepted=1
    break
done < "$tmpdir/cands"

[ "$accepted" -eq 1 ] || pending "$reason"

n_early="$(info_get early "$tmpdir/cinfo")"
n_late="$(info_get late "$tmpdir/cinfo")"
n_new=$((n_early + n_late))

[ -s "$tmpdir/early.tsv" ] &&
    sort -n -k1,1 "$tmpdir/early.tsv" | cut -f2- > "$tmpdir/early.lines"
[ -s "$tmpdir/late.tsv" ] &&
    sort -n -k1,1 "$tmpdir/late.tsv" | cut -f2- > "$tmpdir/late.lines"

ensure_nl() {
    [ -s "$1" ] || return 0
    [ "$(tail -c 1 "$1" | wc -l)" -eq 1 ] || printf '\n' >> "$1"
}

head -n $((firstdata - 1)) "$serie" > "$tmpdir/pre"
tail -n +"$firstdata" "$serie" > "$tmpdir/dat"

: > "$tmpdir/merged"
cat "$tmpdir/pre" >> "$tmpdir/merged"
ensure_nl "$tmpdir/merged"
[ -s "$tmpdir/early.lines" ] && cat "$tmpdir/early.lines" >> "$tmpdir/merged"
cat "$tmpdir/dat" >> "$tmpdir/merged"
ensure_nl "$tmpdir/merged"
[ -s "$tmpdir/late.lines" ] && cat "$tmpdir/late.lines" >> "$tmpdir/merged"

if [ -n "$out" ]; then
    cat "$tmpdir/merged" > "$out" || die2 "kann $out nicht schreiben"
    target="$out"
    write_mode="neu"
else
    cat "$tmpdir/merged" > "$serie" || die2 "kann $serie nicht schreiben"
    target="$serie"
    write_mode="ersetzt"
fi

mapfile="${target}.map"
{
    printf 'field\tvalue\n'
    printf 'serie\t%s\n' "$serie"
    printf 'target\t%s\n' "$target"
    printf 'mode\t%s\n' "$([ "$live_mode" -eq 1 ] && printf live || printf archive)"
    printf 'source\t%s\n' "$arm"
    printf 'query\t%s\n' "$query"
    printf 'url\t%s\n' "$cand_url"
    printf 'sha256\t%s\n' "$cand_sha"
    printf 'unit\t%s\n' "${cand_unit:-absent}"
    printf 'header\t%s\n' "${cand_header:-absent}"
    printf 'cadence\t%s\n' "$cad"
    printf 'window\t%s\t%s\n' "$from" "$to"
    printf 'series_range\t%s\t%s\n' "$sfirst_raw" "$slast_raw"
    printf 'added_before\t%s\n' "$n_early"
    printf 'added_after\t%s\n' "$n_late"
    printf 'at\t%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
} > "$mapfile" || die2 "kann $mapfile nicht schreiben"

printf 'gap_extend: serie %s (%s Zeilen, Bereich %s..%s, Spalten %s)\n' \
    "$serie" "$nrows" "$sfirst_raw" "$slast_raw" "$sfields_v"
printf 'gap_extend: bracket %s\n' "${bout#bracket: }"
printf 'gap_extend: kadenz %ss (%s), Fenster %s..%s\n' "$cad" "$cadfrom" "$from" "$to"
printf 'gap_extend: quelle %s query %s\n' "$arm" "$query"
printf 'gap_extend: kandidat %s (unit %s, sha256 %s)\n' \
    "$cand_url" "${cand_unit:-absent}" "${cand_sha:-absent}"
printf 'gap_extend: geprüft header %s, zeitbasis %s\n' \
    "${cand_header:-absent}" "$stclass_v"
printf 'gap_extend: angehängt %s Zeilen (vor %s, nach %s), nur außerhalb %s..%s\n' \
    "$n_new" "$n_early" "$n_late" "$sfirst_raw" "$slast_raw"
printf 'gap_extend: schrieb %s (%s), map %s\n' "$target" "$write_mode" "$mapfile"

exit 0
