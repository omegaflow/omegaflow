#!/bin/sh
# gateway_tray — ein Schloss im Nachrichtenbereich (Tray).
#
#   grün  = der Crambler-Gateway läuft  → alles über die Leitung ist geschwärzt
#   grau  = der Gateway ist AUS         → nichts wird geschwärzt (Warnung!)
#
# Rechtsklick: Status · Log · Neustart · Stop.
# Läuft im Desktop des Operators (braucht yad + systemctl --user). Nie im Agent-Käfig.
set -u
SVC=llm-gateway
LOG=/tmp/opencode/llm-gw.log

command -v yad >/dev/null 2>&1 || { printf 'gateway_tray: yad fehlt (sudo apt install yad)\n' >&2; exit 2; }

TERM_CMD="x-terminal-emulator"
command -v "$TERM_CMD" >/dev/null 2>&1 || TERM_CMD="xterm"

MENU="Status!$TERM_CMD -e sh -c 'systemctl --user status $SVC; printf \\\"\\\\nEnter schliesst …\\\"; read x'"
MENU="$MENU|Log!$TERM_CMD -e sh -c 'less $LOG'"
MENU="$MENU|Neustart!systemctl --user restart $SVC"
MENU="$MENU|Stop!systemctl --user stop $SVC"

# yad --notification --listen liest Steuerzeilen von stdin (icon:/tooltip:).
{
  while :; do
    if systemctl --user is-active --quiet "$SVC"; then
      printf 'icon:security-high\n'
      printf 'tooltip:Crambler AN — Namen werden geschwärzt\n'
    else
      printf 'icon:security-low\n'
      printf 'tooltip:Crambler AUS — nichts wird geschwärzt!\n'
    fi
    sleep 10
  done
} | yad --notification --listen --image=security-low --text="Crambler" --menu="$MENU"
