#!/bin/sh
# instrumente — die Messklassen des Registers, nach Instrument geordnet.
#
# Ein Block im Register sagt, WAS gemessen wird (field ... <kraft> <einheit>
# <kadenz>), aber nicht WOMIT. Diese Tabelle schließt die Lücke: je Klasse
# (kraft, einheit) das Instrument, sein Band und der Beleg. Damit ist die Suche
# nach der Messung lokal möglich (welche Blöcke liefern diese Klasse?) und
# online (bin/spec mit demselben Band).
#
# Die kuratierte Seite steht in src/archivar/werkzeuge.tsv:
#   klasse  instrument  band  beleg
# Die Zahlen (Zeilen, Kadenz, Lizenzen) werden bei jedem Lauf frisch aus
# phi/sources.φ gezählt — sie stehen nicht in der Datei.
set -u
export LC_ALL=C
root="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
PHI="${PHI:-$root/phi/sources.φ}"
KURATIERT="${KURATIERT:-$root/src/archivar/instrumente.tsv}"
muster="${1:-}"

[ -f "$PHI" ] || { echo "instrumente: kein Register: $PHI" >&2; exit 2; }

exec perl - "$PHI" "$KURATIERT" "$muster" "$root/src/archivar/licences.tsv" <<'PERL'
use strict; use warnings; use utf8;
binmode STDOUT, ':encoding(UTF-8)';
my ($phi, $kur, $muster, $licences) = @ARGV;

# kuratierte Seite: klasse -> [instrument, band, beleg]
my %k;
if (-f $kur) {
    open my $h, '<:encoding(UTF-8)', $kur or die $!;
    while (<$h>) {
        chomp; next if /^#/ || /^\s*$/;
        my ($kl, $ins, $band, $beleg) = split /\t/;
        next unless defined $kl;
        $kl =~ s{/}{\t};
        $k{lc $kl} = [$ins // "", $band // "", $beleg // ""];
    }
    close $h;
}

# Register zählen: Klasse (kraft, einheit) -> Zeilen, Kadenz, Lizenzen
my %verdict;
if (-f $licences) {
    open my $lh, '<', $licences or die $!;
    while (<$lh>) { chomp; next if /^#/; my ($t, $v) = split /\t/; $verdict{lc $t} = $v if defined $v }
    close $lh;
}

open my $p, '<:encoding(UTF-8)', $phi or die $!;
my (%zeilen, %kadenz, %terms, %felder, %compiler, %quelle);
my ($kraft, $einheit, $kad, $tok, $comp, $host, $ttl, $ort, $zeit);
my $flush = sub { $tok = undef; $comp = undef; $host = undef; $ttl = undef; $ort = undef; $zeit = undef };
while (<$p>) {
    chomp;
    if (/^\s*$/) { $flush->(); next }
    if (/^terms (\S+)/) { $tok = $1; next }
    if (/^compiler (\S+)/) { $comp = $1; next }
    if (/^ttl (\S+)/) { $ttl = $1; next }
    if (/^(?:at|on) (\S+)(?: (\S+) (\S+))?/) { $ort = $1 . (defined $2 ? " $2 $3" : ""); next }
    if (/^(?:epoch|last) (\S+)/) { $zeit = $1; next }
    if (/^range (\S+)/) { $zeit = $1; next }
    if (/^origin [a-z]+:\/\/([^\/]+)/) { $host = $1; next }
    if (/^url \S*\/download\/([^\/]+)\//) { $host //= $1; next }
    if (/^url [a-z]+:\/\/([^\/]+)/) { $host //= $1; next }
    next unless /^field /;
    my @t = /"([^"]*)"|(\S+)/g;
    my @tok; for (my $i = 0; $i < @t; $i += 2) {
        push @tok, defined $t[$i] ? $t[$i] : $t[$i + 1];
    }
    next if @tok < 5;
    # Grammatik: field <name> [<id>] <kernel> <kraft> <einheit> <kadenz> …
    # Die Einheit kann selbst numerisch sein (dimensionslos = 1), also wird sie
    # nicht an Zahlen erkannt, sondern am Kernel, der davor steht.
    my %kernel = map { $_ => 1 } qw(
        inverse-square gaussian-inverse-square point exponential-decay
        patch-levy erfc primary inverse-linear
    );
    my $kix;
    for my $i (1 .. $#tok - 3) {
        next unless $kernel{ lc $tok[$i] };
        $kix = $i;
        last;
    }
    next unless defined $kix;
    my ($u, $kr, $cad) = ($tok[$kix + 2], $tok[$kix + 1], $tok[$kix + 3]);
    my $kl = lc "$kr\t$u";
    $zeilen{$kl}++;
    $kadenz{$kl}{$cad}++;
    $terms{$kl}{$tok}++ if defined $tok;
    $compiler{$kl}{$comp}++ if defined $comp;
    $quelle{$kl}{$host // '?'}{terms} = $tok;
    $quelle{$kl}{$host // '?'}{n}++;
    $quelle{$kl}{$host // '?'}{ttl}    //= $ttl;
    $quelle{$kl}{$host // '?'}{ort}    //= $ort;
    $quelle{$kl}{$host // '?'}{zeit}   //= $zeit;
    push @{ $felder{$kl} }, $tok[0] if @{ $felder{$kl} // [] } < 3;
}
close $p;

sub mode {
    my %c = %{ shift() };
    my @s = sort { $c{$b} <=> $c{$a} } keys %c;
    return $s[0] // '-';
}

my @klassen = sort { $zeilen{$b} <=> $zeilen{$a} } keys %zeilen;
printf "%-30s %-20s %-14s %6s %-8s %-18s %-24s %s\n",
    "klasse", "instrument", "band", "zeilen", "kadenz", "lizenz", "compiler", "beleg";
for my $kl (@klassen) {
    my ($kr, $u) = split /\t/, $kl;
    my $m = lc $muster; $m =~ s{/}{\t};
    next if length $m && index($kl, $m) < 0
                         && index(lc($k{$kl}[0] // ""), $m) < 0;
    my $kur = $k{$kl} // ['', '', ''];
    printf "%-30s %-20s %-14s %6d %-8s %-18s %-24s %s\n",
        "$kr/$u",
        ($kur->[0] || "—"),
        ($kur->[1] || "—"),
        $zeilen{$kl},
        mode($kadenz{$kl}),
        mode($terms{$kl} // {}),
        mode($compiler{$kl} // {}),
        ($kur->[2] || "");
    # Tausch-Ansicht: dieselbe Messung, mehrere Quellen, je mit eigener Lizenz
    if (length $m) {
        printf "    %-38s %4s  %-22s %-12s %-5s %-14s %s\n",
            "quelle", "n", "terms", "urteil", "ttl", "ort", "zeitraum";
        for my $h (sort { $quelle{$kl}{$b}{n} <=> $quelle{$kl}{$a}{n} }
                   keys %{ $quelle{$kl} // {} }) {
            my $t = $quelle{$kl}{$h}{terms};
            my $v = defined $t ? ($verdict{lc $t} // 'unbeurteilt') : 'unbeurteilt';
            printf "    %-38s %4d  %-22s %-12s %-5s %-14s %s\n",
                substr($h, 0, 38), $quelle{$kl}{$h}{n}, $t // '-', $v,
                $quelle{$kl}{$h}{ttl} // '-',
                $quelle{$kl}{$h}{ort} // '-',
                $quelle{$kl}{$h}{zeit} // '-';
        }
    }
}
printf "\n%d Klassen, %d Feldzeilen\n", scalar @klassen,
    do { my $s = 0; $s += $_ for values %zeilen; $s };
PERL
