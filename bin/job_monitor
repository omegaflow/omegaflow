#!/bin/sh
# The job monitor: execs the release binary refreshed by bin/.tools_ensure; never builds.
set -u
self="$0"
while [ -h "$self" ]; do
    d="$(CDPATH= cd -- "$(dirname -- "$self")" && pwd)"
    self="$(readlink "$self")"
    case "$self" in /*) ;; *) self="$d/$self" ;; esac
done
root="$(CDPATH= cd -- "$(dirname -- "$self")/.." && pwd)"
"$root/bin/.tools_ensure" job_monitor
bin="$root/target/release/job_monitor"
if [ ! -x "$bin" ]; then
    echo "job_monitor: pending — no release installed; the build belongs to CI (tools-build)" >&2
    exit 2
fi
exec "$bin" "$@"
