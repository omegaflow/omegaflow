#!/bin/bash
# lage — generiert state/stimmen/_lage.md aus git + Register + Gateway-Stand.
# Der Live-Index, den jede Sitzung zuerst liest. Kein Hand-Prosa, nur Abgeleitetes.
set -u
repo="${OMEGAFLOW_REPO:-$HOME/projects/omegaflow}"
cd "$repo" || exit 1

head_sha=$(git rev-parse --short HEAD 2>/dev/null || echo '?')
ts=$(date -u +%Y-%m-%dT%H:%M:%SZ)

open_rows=$(grep -E '\*\*rat-offen|\*\*rat-konvergiert|\*\*offen\*\*|\*\*gefahren\*\*' state/stimmen/_rat-register.md 2>/dev/null | sed 's/^/  /' | head -25)

last_runs=$(ls -1t state/stimmen/ 2>/dev/null | grep -E 'sammlung|verdikt|lage' | head -8 | sed 's/^/  /')

models=$(wc -l < state/zustand/llm-gateway-models.tsv 2>/dev/null || echo '?')
alive=$(wc -l < state/zustand/llm-gateway-alive.tsv 2>/dev/null || echo '?')
balance=$(tail -n +2 state/zustand/llm-gateway-balance.tsv 2>/dev/null | sed 's/^/  /')

line_rows=$(for line in mountain mycelium river sensory future; do
  h=$(git ls-files 'docs/handover/handover-*.md' 2>/dev/null | grep -v '/archiv/' | grep -E -- "-$line(-|\.)" | sort | tail -1)
  [ -f "$h" ] || continue
  n=$(awk '/^## Offen/{f=1;next} /^## /{f=0} f{if(/^### /)h++; else if(/^- /)b++} END{if(h)print h; else print b+0}' "$h")
  b=$(awk '/^## Offen/{f=1;next} /^## /{f=0} f' "$h" | grep -ci 'braucht')
  c=0
  for f in $(awk '/^## Offen/{f=1;next} /^## /{f=0} f' "$h" | grep -o '`[^`]*`' | tr -d '`' | sed -E 's/:[0-9]+$//' | grep -E '^(state|docs)/' | sort -u); do
    [ -f "$f" ] && grep -qi 'offen' "$f" && c=$((c+1))
  done
  printf '  %-9s %2s offen · %2s Braucht · %2s offene Traeger · %s\n' "$line" "$n" "$b" "$c" "$(basename "$h")"
done)

{
  echo "# Lage — generiert $ts"
  echo
  echo "HEAD \`$head_sha\`"
  echo
  echo "## Sitze / Routen (Gateway)"
  echo "- Katalog: $models Modelle"
  echo "- Lebendige freie Chat-Modelle: $alive"
  if [ -n "$balance" ]; then
    echo "- Guthaben (USD):"
    echo "$balance"
  fi
  echo "- Rat-Sitze: \`state/stimmen/_rat-anweisung.md\` (Leiter; 17.10.-Tabelle überholt)"
  echo
  echo "## Offen je Linie (Handover)"
  if [ -n "$line_rows" ]; then
    echo "$line_rows"
  else
    echo "  (keine)"
  fi
  echo
  echo "## Rat-Fragen (offen | rat-konvergiert)"
  if [ -n "$open_rows" ]; then
    echo "$open_rows"
  else
    echo "  (keine)"
  fi
  echo
  echo "## Letzte Läufe / Sammlungen"
  if [ -n "$last_runs" ]; then
    echo "$last_runs"
  else
    echo "  (keine)"
  fi
  echo
  echo "Regenerieren: \`bin/lage\`"
} > state/stimmen/_lage.md

echo "geschrieben: state/stimmen/_lage.md (HEAD $head_sha)"
