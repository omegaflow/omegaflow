#!/bin/sh
# leads_merge — Kandidaten aus research/…/leads.φ gegen das Register deduplizieren,
# eine Datei mit nur den noch nicht registrierten Hosts.
set -u
self="$0"
while [ -h "$self" ]; do
    d="$(CDPATH= cd -- "$(dirname -- "$self")" && pwd)"
    self="$(readlink "$self")"
    case "$self" in /*) ;; *) self="$d/$self" ;; esac
done
root="$(CDPATH= cd -- "$(dirname -- "$self")/.." && pwd)"
"$root/bin/.tools_ensure" leads_merge
bin="$root/target/release/leads_merge"
if [ ! -x "$bin" ]; then
    echo "leads_merge: pending — no release installed; the build belongs to CI (tools-build)" >&2
    exit 2
fi
exec "$bin" "$@"
