#!/bin/sh
# The mail digest: execs the release binary refreshed by bin/.tools_ensure; never builds.
set -u
self="$0"
while [ -h "$self" ]; do
    d="$(CDPATH= cd -- "$(dirname -- "$self")" && pwd)"
    self="$(readlink "$self")"
    case "$self" in /*) ;; *) self="$d/$self" ;; esac
done
root="$(CDPATH= cd -- "$(dirname -- "$self")/.." && pwd)"
"$root/bin/.tools_ensure" mail_digest
bin="$root/target/release/mail_digest"
if [ ! -x "$bin" ]; then
    echo "mail_digest: pending — no release installed; the build belongs to CI (tools-build)" >&2
    exit 2
fi
exec "$bin" "$@"
