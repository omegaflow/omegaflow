#!/bin/sh
# post_lookup — the postbox lookup for one line: reads the house root from
# bin/_roots.sh, never a literal relative path. The public tree holds no post/;
# a relative `ls post/in/...` there is a silent zero, and the marker lives only
# in the file name ("*-an-<line>*.md").
#
# Usage: post_lookup --line <line> [--out]
#   --out   also list today's sent post: post/out/<date>-<line>-*.md
#
# Exit: 0 measured (including 0 hits), 2 the house itself is absent or the line
# is missing — an absent house is a riss, never a fabricated "0 post".
set -u

self="$0"
while [ -h "$self" ]; do
    d="$(CDPATH= cd -- "$(dirname -- "$self")" && pwd)"
    self="$(readlink "$self")"
    case "$self" in /*) ;; *) self="$d/$self" ;; esac
done
root="$(CDPATH= cd -- "$(dirname -- "$self")/.." && pwd)"
. "$root/bin/_roots.sh"

line=""
want_out=0
while [ $# -gt 0 ]; do
    case "$1" in
        --line) [ $# -ge 2 ] || { echo "post_lookup: --line needs a value" >&2; exit 2; }
                line="$2"; shift 2 ;;
        --out)  want_out=1; shift ;;
        -h|--help) sed -n '2,11p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        *) echo "post_lookup: unknown argument: $1" >&2; exit 2 ;;
    esac
done
[ -n "$line" ] || { echo "post_lookup: missing --line <line>" >&2; exit 2; }

# Same renames the register carries: a line that changed its name keeps its post.
case "$line" in
    bau) line="mountain" ;;
    ernte) line="mycelium" ;;
    forschung) line="sensory" ;;
esac

house="$OMEGAFLOW_WORK/post"
[ -d "$house" ] || {
    echo "post_lookup: post house absent: $house (root from bin/_roots.sh)" >&2
    exit 2
}
[ -d "$house/in" ] || {
    echo "post_lookup: inbox absent: $house/in" >&2
    exit 2
}

hits=0
for f in "$house/in/"*-an-"$line"*.md; do
    [ -e "$f" ] || continue
    printf 'POST\tin\t%s\n' "$f"
    hits=$((hits + 1))
done

sent=0
if [ "$want_out" -eq 1 ]; then
    [ -d "$house/out" ] || {
        echo "post_lookup: outbox absent: $house/out" >&2
        exit 2
    }
    day="$(date +%F)"
    for f in "$house/out/$day-$line-"*.md; do
        [ -e "$f" ] || continue
        printf 'POST\tout\t%s\n' "$f"
        sent=$((sent + 1))
    done
fi

printf 'post_lookup --line %s: %s in' "$line" "$hits"
[ "$want_out" -eq 1 ] && printf ', %s out (today)' "$sent"
printf '\n'
