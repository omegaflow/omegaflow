#!/bin/sh
# private_read — the redactor, in the operator's order:
#   Stage 1 — deterministic (patterns + map): the wall. Runs always, on the machine.
#   Stage 2 — the Mistral check (via the local gateway): it sees the ALREADY-redacted
#             text and replaces only what stage 1 missed (a name without a shape, a
#             contact, a device id). It sits BETWEEN the redactor and the reader, so
#             even its logging carries placeholders, not the original.
# Stage 2 runs only when OMEGAFLOW_REDACT_MODEL is set (default: a small Mistral).
# If the gateway is closed (paid gate) or unreachable, stage 1's output is returned as is.
#
# It must run OUTSIDE the cage: the cage rightly hides the private house from the
# public agent's shell. So it is launched by the operator (their terminal) or by the
# gateway — never by the caged agent itself.
#
# Usage: private_read <path-under-private | absolute-path-under-private>
set -eu
priv="${OMEGAFLOW_PRIVATE:-$HOME/projects/omegaflow-personal}"
target="${1:?usage: private_read <file-under-private|absolute>}"
case "$target" in
  /*) f="$target" ;;
  *) f="$priv/$target" ;;
esac
case "$f" in
  "$priv"/*) : ;;
  *) printf 'private_read: %s is outside the private house\n' "$f" >&2; exit 2 ;;
esac
[ -f "$f" ] || { printf 'private_read: no such file: %s\n' "$f" >&2; exit 2; }
map="$priv/redact.map"
[ -f "$map" ] || { printf 'private_read: no redact.map in the private house\n' >&2; exit 2; }

filter="$(mktemp)"
mapscript="$(mktemp)"
trap 'rm -f "$filter" "$mapscript"' EXIT

# ---- Stage 2 config (the Mistral check) ----
gateway="${OMEGAFLOW_GATEWAY:-http://127.0.0.1:1621/v1/chat/completions}"
model="${OMEGAFLOW_REDACT_MODEL:-}"
prompt='Dieser Text ist BEREITS geschwärzt: Personen, Adressen, Kontakte und Kennungen stehen als Platzhalter wie <NAME>, <ADDR>, <TEL>, <EMAIL>, <DEVICE>, <CONTACT>. Finde NUR NOCH die Reste, die übersehen wurden — Personennamen (auch einzelne Vor- oder Nachnamen), Adressen, Telefonnummern, Mailadressen, Konten-, Geräte- und Netz-Kennungen — und ersetze sie durch dieselben Platzhalter. Lass die vorhandenen Platzhalter und den übrigen Text WÖRTLICH unverändert. Gib NUR den Text zurück — keine Erklärung, keine Anführungszeichen.'

# ---- Stage 1: the patterns ----
cat > "$filter" <<'SED'
s/sk-[A-Za-z0-9_-]\{16,\}/<KEY>/g
s/github_pat_[A-Za-z0-9_]\{20,\}/<KEY>/g
s/gh[pousr]_[A-Za-z0-9]\{20,\}/<KEY>/g
s/AKIA[0-9A-Z]\{16\}/<KEY>/g
s/AIza[0-9A-Za-z_-]\{30,\}/<KEY>/g
s/[0-9A-Fa-f]\{2\}\(:[0-9A-Fa-f]\{2\}\)\{5\}/<MAC>/g
s/[0-9a-fA-F]\{8\}-[0-9a-fA-F]\{4\}-[0-9a-fA-F]\{4\}-[0-9a-fA-F]\{4\}-[0-9a-fA-F]\{12\}/<UUID>/g
s/xox[baprs]-[A-Za-z0-9-]\{10,\}/<KEY>/g
s/hf_[A-Za-z0-9]\{20,\}/<KEY>/g
s/Bearer[[:space:]]\{1,\}[A-Za-z0-9._-]\{16,\}/Bearer <KEY>/g
s/\([Pp]assword\|[Pp]asswd\|[Ss]ecret\|[Tt]oken\|[Aa]pi[-_]\?[Kk]ey\|[Kk]ey\)[[:space:]]*[:=][[:space:]]*[^[:space:]]\{1,\}/\1=<SECRET>/g
s/[A-Za-z0-9._%+-]\{1,\}@[A-Za-z0-9.-]\{1,\}\.[A-Za-z]\{2,\}/<EMAIL>/g
s/[A-Z]\{2\}[0-9]\{2\}[A-Z0-9]\{10,\}/<IBAN>/g
s/[A-ZÄÖÜ][a-zäöüß-]\{2,\}\(straße\|str\.\|weg\|gasse\|platz\|allee\|ring\|damm\|ufer\)[[:space:]]\{0,2\}[0-9]\{1,4\}[a-z]\{0,1\}\b/<ADDR>/g
s/[0-9]\{5\}[[:space:]]\{1,2\}[A-ZÄÖÜ][a-zäöüß-]\{2,\}/<ORT>/g
s/\b\(Tel\|Telefon\|Mobil\|Handy\|Fax\)[[:space:]]*[:.]*[[:space:]]*[+0-9][0-9 ()/.-]\{5,\}[0-9]\b/<TEL>/g
SED

# ---- Stage 1: the map ----
awk -F'=' '
  /^[[:space:]]*#/ { next }
  /^[[:space:]]*$/ { next }
  {
    a=$1; b=substr($0, index($0,"=")+1)
    if (a=="") next
    if (substr(a,1,1)=="<" && substr(b,1,1)!="<") {
      t=a; a=b; b=t
      print "private_read: swapped a reversed map line (real and placeholder were inverted)" > "/dev/stderr"
    }
    # Sicherheit: NUR echte Schwärz-Zeilen (rechts ein <PLATZHALTER>). Eine Zeile,
    # deren rechte Seite KEIN Platzhalter ist, würde den rechten Wert ÜBERALL
    # einsetzen (der beobachtete Bug) — sie wird übersprungen, nie angewandt.
    # Nach dem Tausch muss LINKS der echte Wert stehen und RECHTS ein <Platzhalter>.
    # Eine Zeile, deren LINKE Seite ein Platzhalter ist, würde eine gerade
    # geschwärzte Stelle WIEDER in einen echten Wert verwandeln (der beobachtete Bug).
    if (substr(a,1,1)=="<") {
      print "private_read: skipped a map line whose left side is a <placeholder> (line " NR ")" > "/dev/stderr"
      next
    }
    if (substr(b,1,1)!="<") {
      print "private_read: skipped a map line whose right side is not a <placeholder> (line " NR ")" > "/dev/stderr"
      next
    }
    print length(a)"\t"a"\t"b
  }
' "$map" | sort -rn | while IFS="$(printf '\t')" read -r _ real ph; do
  esc="$(printf '%s' "$real" | sed 's/[][\\.*^$/&]/\\&/g')"
  escph="$(printf '%s' "$ph" | sed 's/[\\/&]/\\&/g')"
  printf 's/%s/%s/g\n' "$esc" "$escph" >> "$mapscript"
done

stage1="$(awk '
  /-----BEGIN [A-Z ]*PRIVATE KEY-----/ { inkey=1; print "<PRIVATE KEY>"; next }
  /-----END [A-Z ]*PRIVATE KEY-----/ { inkey=0; print "</PRIVATE KEY>"; next }
  inkey { next }
  { print }
' "$f" | sed -f "$filter" | sed -f "$mapscript")"

printf '%s\n' "$stage1"
