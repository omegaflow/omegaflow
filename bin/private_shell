#!/bin/sh
# private_shell — das private Haus: setzt die Wurzeln und öffnet den privaten Käfig.
#
# Die Grenze steht in `bin/sandbox` (Profil `private`): private Haus UND öffentliches
# Repo eingehängt — Einweg. Hier nur die Wurzeln und der geteilte Lehre-Plugin.
#
# Der frühere „Merge" ist gefallen: er wollte den öffentlichen Permission-Block in die
# private Config schreiben und lief dabei ins Leere (`jaq -s` schluckt auf 3.1.1 jede
# Datei einzeln → `.[1]` = null → Fehler → `|| true`). Und die Listen gibt es nicht mehr.
set -eu
root="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
priv="${OMEGAFLOW_PRIVATE:-$HOME/projects/omegaflow-personal}"
export OMEGAFLOW_REPO="$root"
export OMEGAFLOW_PRIVATE="$priv"
export OMEGAFLOW_STATE="$priv"
export OMEGAFLOW_WORK="${OMEGAFLOW_WORK:-$HOME/projects/omegaflow-work}"
[ -f "$root/bin/_roots.sh" ] && . "$root/bin/_roots.sh" || true

mkdir -p "$priv/.opencode/plugin"
cp -f "$root/.opencode/plugin/form-guard.ts" "$priv/.opencode/plugin/form-guard.ts" 2>/dev/null || true

exec "$root/bin/sandbox" private "$@"
