#!/bin/sh
# rat_dispatch — the roster dispatcher.
#
# One question goes to the API seats of the local llm_gateway (OpenAI surface,
# http://127.0.0.1:1621/v1/chat/completions), one POST per seat. The raw answer
# is stored per seat and gathered into one readable sheet, plus a short
# comparison (char count, majority/alone). The roster is the ROSTER list below:
#     seat | model-id | tier
# Add or remove a line to change the seats; nothing else knows them. The
# model-id is the gateway form '<route>/<provider-model>' exactly as
# GET /v1/models reports it.
#
# Usage:
#   rat_dispatch "the question"
#   echo "the question" | rat_dispatch
#
# Writes:
#   state/stimmen/<date>_rat_<seat>.json   the raw OpenAI answer per seat
#   state/stimmen/<date>_rat_frage.md      the readable collection
# A missing gateway or a per-seat error is named; never a silent zero.
set -u

ROOT=$(readlink -f "$(dirname -- "$0")/..")
OUT="$ROOT/state/stimmen"
URL=${OMEGAFLOW_GATEWAY_URL:-http://127.0.0.1:1621/v1/chat/completions}
TIMEOUT=${RAT_TIMEOUT:-180}
MAXTOK=${RAT_MAX_TOKENS:-1500}
SHARE=${RAT_SHARE:-0.30}

# seat | model-id | tier  (tier is a label; the gateway enforces payment)
ROSTER='
deepseek-v4-pro|deepseek/deepseek-v4-pro|direct · paid-open
glm-5.3|deepinfra/zai-org/GLM-5.3|DeepInfra · billed
minimax-m3|deepinfra/MiniMaxAI/MiniMax-M3|DeepInfra · billed
glm-4.7-flash|cf/@cf/zai-org/glm-4.7-flash|free
qwen3.8-27b|groq/qwen/qwen3.8-27b|free
nemotron-3-ultra|kilo/nvidia/nemotron-3-ultra-550b-a55b:free|free
gpt-oss-120b|ollama/gpt-oss:120b|free
pollinations-fast|pollinations/openai-fast|free
qwen3.8-27b-ovh|ovh/Qwen3.8-27B|free · keyless
'

usage() {
    printf '%s\n' 'usage: rat_dispatch "question"' '       echo question | rat_dispatch' >&2
    exit 2
}

if [ "$#" -ge 1 ]; then
    QUESTION="$*"
elif [ ! -t 0 ]; then
    QUESTION=$(sed -n 'p')
else
    usage
fi
[ -n "$QUESTION" ] || usage

DATE=$(date +%F)
TMP=$(mktemp -d "${TMPDIR:-/tmp}/rat_dispatch.XXXXXX") || exit 2
trap 'rm -rf "$TMP"' EXIT INT TERM
: > "$TMP/sections"
: > "$TMP/meta"
: > "$TMP/answered"

# JSON-escape the question for the request body (backslash, quote, newline).
Q_ESC=$(printf '%s' "$QUESTION" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' \
    | awk 'BEGIN{ORS=""}{if(NR>1)printf "\\n";printf "%s",$0}')

# The first JSON string value of key in a compact OpenAI response (awk fallback).
awk_string() {
    awk -v want="$2" '{
        pat = "\"" want "\"[ \t]*:[ \t]*\""
        p = match($0, pat)
        if (p == 0) next
        i = p + RLENGTH
        n = length($0)
        out = ""; esc = 0
        while (i <= n) {
            c = substr($0, i, 1)
            if (esc) {
                if (c == "n") out = out "\n"
                else if (c == "t") out = out "\t"
                else if (c == "r") out = out "\r"
                else out = out c
                esc = 0
            } else if (c == "\\") {
                esc = 1
            } else if (c == "\"") {
                break
            } else {
                out = out c
            }
            i++
        }
        print out
        exit
    }' "$1"
}

# The answer text: content, else the reasoning channel.
json_answer() {
    f=$1
    v=""
    if command -v jq >/dev/null 2>&1; then
        v=$(jq -r '.choices[0]?.message?.content // empty' "$f" 2>/dev/null)
        [ -n "$v" ] || v=$(jq -r '.choices[0]?.message?.reasoning_content // .choices[0]?.message?.reasoning // empty' "$f" 2>/dev/null)
    elif command -v jaq >/dev/null 2>&1; then
        v=$(jaq -r '.choices[0]?.message?.content // empty' "$f" 2>/dev/null)
        [ -n "$v" ] || v=$(jaq -r '.choices[0]?.message?.reasoning_content // .choices[0]?.message?.reasoning // empty' "$f" 2>/dev/null)
    else
        v=$(awk_string "$f" content)
        [ -n "$v" ] || v=$(awk_string "$f" reasoning_content)
        [ -n "$v" ] || v=$(awk_string "$f" reasoning)
    fi
    printf '%s' "$v"
}

json_error() {
    f=$1
    if command -v jq >/dev/null 2>&1; then
        jq -r '.error.message // empty' "$f" 2>/dev/null
    elif command -v jaq >/dev/null 2>&1; then
        jaq -r '.error.message // empty' "$f" 2>/dev/null
    else
        awk_string "$f" message
    fi
}

# Normalise an answer to the set of its significant words (lowercase, len>=3).
words_of() {
    tr 'A-Z' 'a-z' | tr -cs 'a-z0-9' '\n' | awk '
        BEGIN { n = split("the and for are but not you all any can her his one our out day get has him how its new now old see two who did use way may say too der die das und ist ein eine mit von auf den dem des sich nicht sind auch als aus bei nach wird werden", a, " "); for (i = 1; i <= n; i++) s[a[i]] = 1 }
        (length($0) >= 3 || $0 ~ /^[0-9]+$/) && !($0 in s) && !seen[$0]++ { print }
    '
}

printf '# Rat — %s\n\n**Frage:** %s\n\n' "$DATE" "$QUESTION" > "$TMP/intro"

IFS='
'
for entry in $ROSTER; do
    [ -n "$entry" ] || continue
    IFS_SAVE=$IFS
    IFS='|'
    set -- $entry
    IFS=$IFS_SAVE
    seat=$1; model=$2; tier=${3:-}
    raw="$OUT/${DATE}_rat_${seat}.json"
    body=$(printf '{"model":"%s","messages":[{"role":"user","content":"%s"}],"max_tokens":%s}' "$model" "$Q_ESC" "$MAXTOK")
    code=$(printf '%s' "$body" | curl -s -m "$TIMEOUT" -X POST "$URL" \
        -H 'Content-Type: application/json' --data-binary @- -o "$raw" -w '%{http_code}')
    content=$(json_answer "$raw")
    err=$(json_error "$raw")
    chars=$(printf '%s' "$content" | wc -m | tr -d ' ')

    if [ "$code" = '000' ]; then
        status="gateway unread at $URL"
        chars='—'
    elif [ "$code" = '200' ] && [ -n "$content" ]; then
        status='ok'
    elif [ "$code" = '200' ]; then
        status='ok · empty answer'
        chars=0
    elif [ "$code" = '402' ]; then
        status="billed route — paid gate: $err"
        chars='—'
    elif [ "$code" = '429' ]; then
        status='rate limited (429)'
        chars='—'
    else
        status="HTTP $code"
        [ -n "$err" ] && status="$status: $err"
        chars='—'
    fi

    printf '%s\t%s\t%s\t%s\t%s\n' "$seat" "$model" "$code" "$chars" "$status" >> "$TMP/meta"

    {
        printf '## %s\n\n' "$seat"
        printf '`%s` · %s\n\n' "$model" "$tier"
        if [ -n "$content" ]; then
            printf '%s\n\n' "$content"
        else
            printf '_keine Antwort — %s_\n\n' "$status"
        fi
    } >> "$TMP/sections"

    if [ "$code" = '200' ] && [ -n "$content" ]; then
        printf '%s' "$content" | words_of > "$TMP/${seat}.set"
        printf '%s\n' "$seat" >> "$TMP/answered"
    fi
done
unset IFS

# ---- short comparison: char count + alone/majority by word overlap ----
{
    printf '## Kurzvergleich\n\n'
    printf '%-20s %8s  %s\n' 'Sitz' 'Zeichen' 'Antwortgruppe'
    tab=$(printf '\t')
    while IFS="$tab" read -r seat model code chars status; do
        group=''
        if [ "$code" = '200' ] && [ -s "$TMP/${seat}.set" ]; then
            shares=0; others=0
            while read -r other; do
                [ "$other" = "$seat" ] && continue
                others=$((others + 1))
                si=$(wc -l < "$TMP/${seat}.set")
                sj=$(wc -l < "$TMP/${other}.set")
                inter=$(awk 'NR==FNR{a[$0]=1;next}{if($0 in a)c++}END{print c+0}' "$TMP/${seat}.set" "$TMP/${other}.set")
                union=$((si + sj - inter))
                hit=$(awk -v x="$inter" -v u="$union" -v t="$SHARE" 'BEGIN{print (u > 0 && x/u >= t) ? 1 : 0}')
                [ "$hit" = '1' ] && shares=$((shares + 1))
            done < "$TMP/answered"
            if [ "$others" -gt 0 ] && [ $((2 * shares)) -ge "$others" ] && [ "$shares" -ge 1 ]; then
                group="Mehrheit (teilt mit $shares/$others)"
            else
                group="steht allein ($shares/$others)"
            fi
        elif [ "$code" = "200" ]; then
            group='200 · keine signifikanten Woerter'
        else
            group="$status"
        fi
        printf '%-20s %8s  %s\n' "$seat" "$chars" "$group"
    done < "$TMP/meta"
    printf '\n_Overlap-Schwelle: Jaccard >= %s der signifikanten Woerter._\n' "$SHARE"
} > "$TMP/compare"

md="$OUT/${DATE}_rat_frage.md"
{
    sed -n 'p' "$TMP/intro"
    sed -n 'p' "$TMP/sections"
    printf '\n'
    sed -n 'p' "$TMP/compare"
} > "$md"

count=$(wc -l < "$TMP/meta" | tr -d ' ')
printf '%s\n' "rat_dispatch: $DATE — Frage an $count Sitze" "  $md"
sed -n 'p' "$TMP/compare"
