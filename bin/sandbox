#!/bin/sh
# sandbox — der Käfig: EIN Apparat, ZWEI Profile (Operator-Wort 2026-10-16).
#
#   public   das öffentliche Repo + die Werkstatt. Das private Haus ist NICHT
#            eingehängt — es existiert hier drin nicht. `.secrets.local` zeigt nur
#            die Schlüssel-NAMEN (Werte leer), damit `bin/secrets_keys` sie nennt.
#   private  dasselbe PLUS das private Haus. EINWEG: privat sieht öffentlich,
#            öffentlich sieht privat nicht. (Hier sitzt der Operator mit Future.)
#
# Das Gerüst ist für beide Profile identisch (Programmbasis, DNS-Stub, leeres /run,
# eigener /proc, tmpfs /tmp, Rust, gitconfig); nur die Einhängungen unterscheiden
# sich. Damit ist „zwei Sandboxen" eine Regel, kein zweites Programm.
#
# Die Modelle gehören NICHT hierher, sondern in die Configs: privat `deepinfra/…`,
# öffentlich `deepseek/…`.
#
# Der Aufruf kommt als `<shell> -c "<befehl>"`, darum steht IMMER `/bin/bash` als
# Kommando hinter den Optionen (sonst läse bwrap das `-c` als Option).
set -eu
root="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
priv="${OMEGAFLOW_PRIVATE:-$HOME/projects/omegaflow-personal}"
work="${OMEGAFLOW_WORK:-$HOME/projects/omegaflow-work}"
profile="${1:-}"
case "$profile" in
  public|private) shift ;;
  *) echo "usage: sandbox public|private [cmd...]" >&2; exit 2 ;;
esac

# Start-Verzeichnis: Profil-Standard — aber das AKTUELLE Verzeichnis bleibt, wenn es
# im Profil erreichbar ist (sonst bräche der workdir-Vertrag der Werkzeuge).
if [ "$profile" = private ]; then cd_into="$priv"; else cd_into="$root"; fi
case "$PWD" in
  "$root"|"$root"/*|"$work"|"$work"/*) cd_into="$PWD" ;;
esac
if [ "$profile" = private ]; then
  case "$PWD" in "$priv"|"$priv"/*) cd_into="$PWD" ;; esac
fi

# Das Gerüst + das Profil, als bwrap-Flags (unsere Pfade tragen kein Leerzeichen).
# public: die Schlüssel-NAMEN als leere Werte sichtbar, nie ein Wert.
names_file=""
if [ "$profile" = public ] && [ -f "$root/.secrets.local" ]; then
  names_file="$root/target/.secrets.names"
  mkdir -p "$root/target"
  awk -F= '
    /^[[:space:]]*#/ { next }
    /^[[:space:]]*$/ { next }
    { key = $1; sub(/[[:space:]]+$/, "", key); if (key != "") print key "=" }
  ' "$root/.secrets.local" > "$names_file"
  chmod 644 "$names_file"
fi

flags() {
  printf '%s\n' \
    --ro-bind /usr /usr \
    --ro-bind-try /lib /lib \
    --ro-bind-try /lib64 /lib64 \
    --ro-bind-try /bin /bin \
    --ro-bind-try /sbin /sbin \
    --ro-bind /etc /etc \
    --tmpfs /run \
    --ro-bind-try /run/systemd/resolve /run/systemd/resolve \
    --unshare-pid \
    --proc /proc \
    --dev /dev \
    --tmpfs /tmp \
    --ro-bind-try "$HOME/.cargo" "$HOME/.cargo" \
    --ro-bind-try "$HOME/.rustup" "$HOME/.rustup" \
    --ro-bind-try "$HOME/.local/bin" "$HOME/.local/bin" \
    --ro-bind-try "$HOME/.gitconfig" "$HOME/.gitconfig" \
    --share-net
  case "$1" in
    public)
      printf '%s\n' \
        --bind "$root" "$root" \
        --bind "$work" "$work"
      if [ -n "$names_file" ]; then
        printf '%s\n' --ro-bind "$names_file" "$root/.secrets.local"
      else
        printf '%s\n' --ro-bind /dev/null "$root/.secrets.local"
      fi
      ;;
    private)
      printf '%s\n' \
        --bind "$root" "$root" \
        --bind "$priv" "$priv" \
        --bind "$work" "$work" \
        --bind-try "${OMEGAFLOW_TMP:-/tmp/opencode}" "${OMEGAFLOW_TMP:-/tmp/opencode}" ;;
  esac
}

MOUNTS="$(flags "$profile")"

# Nur der öffentliche Token — Name gelesen, Wert nur in den Käfig-Env, nie gedruckt.
# Beide Profile: so ist `gh` im Käfig authentifiziert, ohne dass ~/.config/gh
# (der volle Konto-Login) eingehängt werden muss.
ghtok="$(sed -n 's/^GH_TOKEN=//p' "$root/.secrets.local" 2>/dev/null | sed -n '1p')"
if [ -n "${ghtok:-}" ]; then
  # shellcheck disable=SC2086
  exec bwrap --setenv GH_TOKEN "$ghtok" $MOUNTS --chdir "$cd_into" /bin/bash "$@"
fi
# shellcheck disable=SC2086
exec bwrap $MOUNTS --chdir "$cd_into" /bin/bash "$@"
