#!/bin/sh
set -u
self="$0"
while [ -h "$self" ]; do
    d="$(CDPATH= cd -- "$(dirname -- "$self")" && pwd)"
    self="$(readlink "$self")"
    case "$self" in /*) ;; *) self="$d/$self" ;; esac
done
root="$(CDPATH= cd -- "$(dirname -- "$self")/.." && pwd)"
"$root/bin/.tools_ensure" schema_index
bin="$root/target/release/schema_index"
if [ ! -x "$bin" ]; then
    echo "schema_index: pending — no release installed; the build belongs to CI (tools-build)" >&2
    exit 2
fi
exec "$bin" "$@"
