#!/bin/sh
# secrets_keys — prints ONLY the key names of .secrets.local, never the values.
# The file path lives in this script, never on the command line: the agent deny
# matches the command string (*.secrets.local*), so the wrapper is the name-only
# read allowed by AGENTS.md while the value read stays structurally blocked.
#
# Modes:
#   secrets_keys                     — the key names (one per line)
#   secrets_keys --fingerprint [KEY] — per key: length + whether the value is
#                                       quoted (never the value itself)
set -u
root="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
f="$root/.secrets.local"
if [ ! -f "$f" ]; then
    echo "secrets_keys: no .secrets.local at $f" >&2
    exit 2
fi
if [ "${1:-}" = "--fingerprint" ]; then
    want="${2:-}"
    while IFS= read -r line || [ -n "$line" ]; do
        case "$line" in
            '' | \#*) continue ;;
        esac
        key="${line%%=*}"
        [ "$line" = "$key" ] && continue
        val="${line#*=}"
        key="$(printf '%s' "$key" | tr -d ' \t\r')"
        n=${#val}
        spaces="$(printf '%s' "$val" | tr -cd ' ' | wc -c | tr -d ' ')"
        dots="$(printf '%s' "$val" | tr -cd '.' | wc -c | tr -d ' ')"
        sha="$(printf '%s' "$val" | sha256sum | cut -c1-12)"
        if [ -z "$want" ] || [ "$key" = "$want" ]; then
            printf '%s len=%s spaces=%s dots=%s sha=%s\n' "$key" "$n" "$spaces" "$dots" "$sha"
        fi
    done <"$f"
    exit 0
fi
awk -F= '
  /^[[:space:]]*#/ { next }
  /^[[:space:]]*$/ { next }
  { key = $1; sub(/[[:space:]]+$/, "", key); print key }
' "$f"
