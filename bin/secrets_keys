#!/bin/sh
# secrets_keys — prints ONLY the key names of .secrets.local, never the values.
# The file path lives in this script, never on the command line: the agent deny
# matches the command string (*.secrets.local*), so the wrapper is the name-only
# read allowed by AGENTS.md while the value read stays structurally blocked.
#
# Modes:
#   secrets_keys                     — the key names (one per line)
#   secrets_keys --fingerprint [KEY] — per key: length + whether the value is
#                                       quoted (never the value itself)
set -u
root="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
f="${OMEGAFLOW_SECRETS_FILE:-$root/.secrets.local}"
priv="${OMEGAFLOW_PRIVATE:-$HOME/projects/omegaflow-personal}"
if [ ! -e "$f" ] && [ -e "$priv/.secrets.local" ]; then
    f="$priv/.secrets.local"
fi
if [ ! -e "$f" ]; then
    echo "secrets_keys: no .secrets.local at $root/.secrets.local or $priv/.secrets.local" >&2
    exit 2
fi
if [ ! -f "$f" ]; then
    if [ -c "$f" ]; then kind="a character device"; else kind="not a regular file"; fi
    echo "secrets_keys: .secrets.local is $kind (overlaid by the public profile) — 0 keys readable, 0 values read" >&2
    exit 0
fi
if [ "${1:-}" = "--fingerprint" ]; then
    want="${2:-}"
    while IFS= read -r line || [ -n "$line" ]; do
        case "$line" in
            '' | \#*) continue ;;
        esac
        key="${line%%=*}"
        [ "$line" = "$key" ] && continue
        val="${line#*=}"
        key="$(printf '%s' "$key" | tr -d ' \t\r')"
        n=${#val}
        spaces="$(printf '%s' "$val" | tr -cd ' ' | wc -c | tr -d ' ')"
        dots="$(printf '%s' "$val" | tr -cd '.' | wc -c | tr -d ' ')"
        sha="$(printf '%s' "$val" | sha256sum | cut -c1-12)"
        if [ -z "$want" ] || [ "$key" = "$want" ]; then
            printf '%s len=%s spaces=%s dots=%s sha=%s\n' "$key" "$n" "$spaces" "$dots" "$sha"
        fi
    done <"$f"
    exit 0
fi
if head -1 "$f" 2>/dev/null | grep -q '^# projection: names only'; then
    names="$(awk -F= '
      /^[[:space:]]*#/ { next }
      /^[[:space:]]*$/ { next }
      index($0, "=") == 0 { next }
      { key = $1; sub(/[[:space:]]+$/, "", key); if (key != "") print key }
    ' "$f")"
    printf '%s\n' "$names" | sed '/^$/d'
    n="$(printf '%s\n' "$names" | sed '/^$/d' | wc -l | tr -d ' ')"
    printf 'secrets_keys: %s key name(s) — names only in this profile; a missing name is the only open gate\n' "$n" >&2
    exit 0
fi
names="$(awk -F= '
  /^[[:space:]]*#/ { next }
  /^[[:space:]]*$/ { next }
  index($0, "=") == 0 { next }
  {
    key = $1
    sub(/[[:space:]]+$/, "", key)
    val = substr($0, index($0, "=") + 1)
    sub(/^[[:space:]]+/, "", val)
    if (key != "" && val != "") print key
  }
' "$f")"
printf '%s\n' "$names" | sed '/^$/d'
n="$(printf '%s\n' "$names" | sed '/^$/d' | wc -l | tr -d ' ')"
printf 'secrets_keys: %s key name(s) with a value — a missing name is the only open gate\n' "$n" >&2
