#!/bin/sh
# The fetch tool the divers run: execs the release binary; the build belongs
# to CI. HTML/Text by default; --raw passes binary through unchanged.
set -u
root="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
bin="$root/target/release/sfetch"
if [ ! -x "$bin" ]; then
    echo "sfetch: no release binary on PATH — the build belongs to CI" >&2
    exit 2
fi
if find "$root/tools/utils/src" "$root/src" "$root/Cargo.toml" "$root/tools/utils/Cargo.toml" \
        \( -name '*.rs' -o -name '*.cjs' \) -newer "$bin" -print -quit 2>/dev/null | grep -q .; then
    echo "sfetch: release binary is older than the tree — running the existing binary; the rebuild belongs to CI" >&2
fi
exec "$bin" "$@"
