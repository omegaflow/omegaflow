#!/bin/sh
# The divers' content search: execs the release binary; the build belongs to
# CI. A dirty or broken working tree never blocks the search — the existing
# release binary runs, and a binary older than the tree still runs.
set -u
self="$0"
while [ -h "$self" ]; do
    d="$(CDPATH= cd -- "$(dirname -- "$self")" && pwd)"
    self="$(readlink "$self")"
    case "$self" in /*) ;; *) self="$d/$self" ;; esac
done
root="$(CDPATH= cd -- "$(dirname -- "$self")/.." && pwd)"
bin="$root/target/release/sgrep"
if [ ! -x "$bin" ]; then
    echo "sgrep: no release binary on PATH — the build belongs to CI" >&2
    exit 2
fi
if find "$root/tools/utils/src" "$root/Cargo.toml" "$root/tools/utils/Cargo.toml" \
        -name '*.rs' -newer "$bin" -print -quit 2>/dev/null | grep -q .; then
    echo "sgrep: release binary is older than the tree — running the existing binary; the rebuild belongs to CI" >&2
fi
exec "$bin" "$@"
