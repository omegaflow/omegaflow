#!/bin/sh
# sniff — Format, Trennzeichen, Kopf, Spalten, Zeitrolle, Einheit, Magic.
# Routet auf `archive_search --sniff`; die Release-Binary kommt aus CI.
set -u
self="$0"
while [ -h "$self" ]; do
    d="$(CDPATH= cd -- "$(dirname -- "$self")" && pwd)"
    self="$(readlink "$self")"
    case "$self" in /*) ;; *) self="$d/$self" ;; esac
done
root="$(CDPATH= cd -- "$(dirname -- "$self")/.." && pwd)"
"$root/bin/.tools_ensure" archive_search
bin="$root/target/release/archive_search"
if [ ! -x "$bin" ]; then
    echo "sniff: pending — no release installed; the build belongs to CI (tools-build)" >&2
    exit 2
fi
exec "$bin" --sniff "$@"
