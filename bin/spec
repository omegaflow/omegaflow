#!/bin/sh
# spec — Quellensuche nach der Messung, nicht nach dem Namen.
# usage: bin/spec --quantity "ELF magnetic field" [--band "0.001-30 Hz"] \
#                 [--unit nT] [--cadence "10 min"] [--instrument "induction coil"] \
#                 [--arms youmcp] [--top 8]
set -u
export LC_ALL=C
root="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
bin="$root/target/release/archive_search"

usage() {
    cat >&2 <<'EOF'
spec: usage: bin/spec --quantity "<messgroesse>" [--band "<band>"] [--unit "<einheit>"]
           [--cadence "<kadenz>"] [--instrument "<instrumentenklasse>"]
           [--arms youmcp,datacite,zenodo] [--without "A B"] [--extra "<freie Variante>"] [--top N]
  Sucht die Messung, nicht den Markennamen. --without schliesst bekannte Marken
  aus. --extra gibt EINE freie Variante dazu (Sprache, Format, Community) — keine
  festen Muster. Ein Arm je Aufruf.
EOF
    exit 2
}

quantity=""; band=""; unit=""; cadence=""; instrument=""; arms="youmcp"; without=""; extra=""; top=8
while [ $# -gt 0 ]; do
    case "$1" in
        --quantity) [ $# -ge 2 ] || usage; quantity="$2"; shift 2 ;;
        --band) [ $# -ge 2 ] || usage; band="$2"; shift 2 ;;
        --unit) [ $# -ge 2 ] || usage; unit="$2"; shift 2 ;;
        --cadence) [ $# -ge 2 ] || usage; cadence="$2"; shift 2 ;;
        --instrument) [ $# -ge 2 ] || usage; instrument="$2"; shift 2 ;;
        --arms) [ $# -ge 2 ] || usage; arms="$2"; shift 2 ;;
        --without) [ $# -ge 2 ] || usage; without="$2"; shift 2 ;;
        --extra) [ $# -ge 2 ] || usage; extra="$2"; shift 2 ;;
        --top) [ $# -ge 2 ] || usage; top="$2"; shift 2 ;;
        *) usage ;;
    esac
done
[ -n "$quantity" ] || usage
neg=""
for b in $without; do neg="$neg -$b"; done
[ -x "$bin" ] || { echo "spec: $bin fehlt — Release bauen (CI)" >&2; exit 2; }

q1="$quantity"
[ -n "$instrument" ] && q1="$q1 $instrument"
[ -n "$band" ] && q1="$q1 $band"

q2="$quantity spectra dataset"
[ -n "$band" ] && q2="$q2 $band"
[ -n "$cadence" ] && q2="$q2 $cadence"

q3="$quantity"
[ -n "$band" ] && q3="$q3 $band"
[ -n "$unit" ] && q3="$q3 $unit"


for arm in $(printf '%s' "$arms" | tr ',' ' '); do
    for q in "$q1$neg" "$q2$neg" "$q3$neg" ${extra:+"$extra"}; do
        printf '== %s · %s ==\n' "$arm" "$q" >&2
        "$bin" --"$arm" "$q" 2>&1 | WITHOUT="$without" perl -ne '
            # --without ist ein Filter, kein Suchwort: kein Treffer eines
            # ausgeschlossenen Brands darf die Ausgabe erreichen.
            my @ex = grep { length } split /\s+/, ($ENV{WITHOUT} // "");
            if (@ex) {
                my ($u) = /url\s+(\S+)/;
                if (defined $u && $u =~ m{://([^/]+)}) {
                    my $h = lc $1;
                    my $skip = 0;
                    for my $x (@ex) { $skip = 1 if index($h, lc $x) >= 0 }
                    next if $skip;
                }
            }
            print;
        ' | head -n "$top"
    done
done
