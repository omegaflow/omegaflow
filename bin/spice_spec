#!/bin/sh
# spice_spec — Instrumenten-Spec aus einem SPICE-Text-Kernel ziehen.
#
#   bin/spice_spec <datei|url>
#
# Liest FK/IK/PCK (Text-Kernel) und gibt nur belegte `spec`-Zeilen aus:
#
#   spec instrument -82360
#   spec fov -82360 RECTANGLE
#   spec boresight -82360 (0.0 0.0 1.0)
#   spec bandwidth -82360 0.1
#   spec wavelength -82360 200 1100
#   spec frame CASSINI_ISS_NAC -82360
#   spec kernel cas_iss_v10.ti 31060 B, 4 Instrumente, 0 Frames
#
# Gelesen wird nur der \begindata ... \begintext-Teil; Prosa und
# Kommentar-Beispiele zaehlen nicht. Fehlt ein Wert, fehlt seine Zeile —
# es wird nichts erfunden. Binaere Kernel (.bc) werden mit exit 3 abgewiesen.
# Kein Rohinhalt, keine Zugangsdaten. Fehler gehen nach stderr.
set -u
export LC_ALL=C

usage() {
    cat >&2 <<'EOF'
spice_spec: usage: bin/spice_spec <datei|url>
  liest einen SPICE-Text-Kernel (FK/IK/PCK) und gibt nur spec-Zeilen aus
EOF
}

die2() { echo "spec: $*" >&2; exit 2; }
die3() { echo "spec: $*" >&2; exit 3; }

src=""
while [ $# -gt 0 ]; do
    case "$1" in
        -h|--help)
            usage
            exit 0
            ;;
        -)
            [ -z "$src" ] || die2 "genau eine Quelle"
            src="-"
            shift
            ;;
        --)
            shift
            [ $# -eq 1 ] || die2 "genau eine Quelle"
            src="$1"
            shift
            ;;
        -*)
            die2 "unbekannte Option: $1"
            ;;
        *)
            [ -z "$src" ] || die2 "genau eine Quelle"
            src="$1"
            shift
            ;;
    esac
done
[ -n "$src" ] || { usage; exit 2; }

case "$src" in
    *'
'*|*' '*|*[![:print:]]*)
        die2 "Quelle enthaelt Leerraum oder Steuerzeichen"
        ;;
esac

tmp="$(mktemp -d "${TMPDIR:-/tmp}/spice_spec.XXXXXX" 2>/dev/null)" ||
    die3 "kein temporaeres Verzeichnis"
trap 'rm -rf "$tmp"' 0 1 2 15
body="$tmp/body"

is_url=0
case "$src" in
    http://*|https://*) is_url=1 ;;
esac

# Dateiname fuer die Kernel-Zeile: letzter Pfadteil, ohne Query.
name="$src"
case "$is_url" in
    1)
        name="${src%%[?#]*}"
        ;;
esac
name="${name##*/}"
case "$name" in
    ''|-|.) name="kernel" ;;
esac

case "$name" in
    *.bc)
        die3 "binaerer Kernel — nur Text-Kernel lesbar"
        ;;
esac

if [ "$is_url" -eq 1 ]; then
    host="${src#*://}"
    host="${host%%[/?#]*}"
    host="${host%%:*}"
    [ -n "$host" ] || die2 "URL ohne Host"
    case "$host" in
        *@*) die2 "Zugangsdaten gehoeren nicht in die URL" ;;
    esac
    err="$tmp/curl.err"
    code="$(curl -q -sS -L --compressed --max-time 90 --max-filesize 67108864 \
        --proto '=http,https' --proto-redir '=https' --max-redirs 3 \
        -o "$body" -w '%{http_code}' "$src" 2>"$err")"
    rc=$?
    if [ "$rc" -ne 0 ]; then
        die3 "kein Text (curl $rc)"
    fi
    case "$code" in
        2[0-9][0-9]) ;;
        *) die3 "HTTP $code" ;;
    esac
    [ -s "$body" ] || die3 "kein Text"
elif [ "$src" = "-" ]; then
    cat >"$body" || die3 "kein Text"
    [ -s "$body" ] || die3 "kein Text"
else
    [ -f "$src" ] || die2 "keine Datei: $src"
    [ -r "$src" ] || die3 "kein Text"
    cp -- "$src" "$body" 2>/dev/null || die3 "kein Text"
    [ -s "$body" ] || die3 "kein Text"
fi

# Binaer? NUL-Bytes im Kopf sind das sichere Zeichen; ein Text-Kernel ist ASCII.
head_n="$(head -c 4096 "$body" | wc -c | tr -d ' ')"
txt_n="$(head -c 4096 "$body" | tr -d '\000' | wc -c | tr -d ' ')"
[ "$head_n" = "$txt_n" ] || die3 "binaerer Kernel — nur Text-Kernel lesbar"

bytes="$(wc -c <"$body" | tr -d ' ')"

prog="$(cat <<'AWK'
function trim(s) {
    sub(/^[ \t\r]+/, "", s)
    sub(/[ \t\r]+$/, "", s)
    return s
}

# Anzahl offener Klammern, Anfuehrungszeichen korrekt uebersprungen.
function pdepth(s,   i, c, q, d) {
    q = 0; d = 0
    for (i = 1; i <= length(s); i++) {
        c = substr(s, i, 1)
        if (q) {
            if (c == "'") {
                if (substr(s, i + 1, 1) == "'") i++
                else q = 0
            }
        } else if (c == "'") {
            q = 1
        } else if (c == "(") {
            d++
        } else if (c == ")") {
            d--
        }
    }
    return d
}

function openquote(s,   i, c, q) {
    q = 0
    for (i = 1; i <= length(s); i++) {
        c = substr(s, i, 1)
        if (c == "'") {
            if (q && substr(s, i + 1, 1) == "'") { i++; continue }
            q = 1 - q
        }
    }
    return q
}

function parse_stmt(s,   key, val) {
    if (s !~ /^[ \t]*[A-Za-z0-9_+\/-]+[ \t]*(\+=|=)/) return
    key = s
    sub(/^[ \t]*/, "", key)
    sub(/[ \t]*(\+=|=).*$/, "", key)
    if (key == "") return
    val = s
    sub(/^[^=]*=/, "", val)
    val = trim(val)
    if (!(key in KV)) ORDER[++NK] = key
    KV[key] = val
}

# String-Wert: 'text' -> text; '' innerhalb bleibt ein '.
function strval(v,   s, i, c, out) {
    if (v !~ /^'/) return ""
    s = substr(v, 2)
    out = ""
    for (i = 1; i <= length(s); i++) {
        c = substr(s, i, 1)
        if (c == "'") {
            if (substr(s, i + 1, 1) == "'") { out = out "'"; i++ }
            else break
        } else {
            out = out c
        }
    }
    return out
}

function is_num(x) {
    return x ~ /^-?[0-9]+([.][0-9]*)?([eEdD][-+]?[0-9]+)?$/
}

function clean_num(x) {
    sub(/^\+/, "", x)
    if (x == "-0") x = "0"
    return x
}

# Zahlentupel aus "( 1.0, 2.0, 3.0 )" in A[1..n].
function nums(v, A,   s, t, n, i, c) {
    s = v
    gsub(/[()]/, " ", s)
    gsub(/,/, " ", s)
    n = split(s, t, /[ \t]+/)
    c = 0
    for (i = 1; i <= n; i++) {
        if (t[i] == "") continue
        A[++c] = clean_num(t[i])
    }
    return c
}

function vecfmt(A, n,   i, s) {
    if (n < 1) return ""
    s = "("
    for (i = 1; i <= n; i++) s = s (i > 1 ? " " : "") A[i]
    return s ")"
}

# Skalar oder Tupel ohne Klammern, z. B. "200 1100".
function numfmt(A, n,   i, s) {
    s = ""
    for (i = 1; i <= n; i++) s = s (i > 1 ? " " : "") A[i]
    return s
}

function qname(s) {
    gsub(/"/, "\\\"", s)
    return s
}

BEGIN { indata = 0; pending = ""; NK = 0 }

{
    line = $0
    sub(/\r$/, "", line)
    if (line ~ /^[ \t]*\\begindata/) { indata = 1; pending = ""; next }
    if (line ~ /^[ \t]*\\begintext/) { indata = 0; pending = ""; next }
    if (!indata) next

    if (line ~ /^[ \t]*$/) {
        if (pending != "") pending = pending " " line
        next
    }

    if (pending == "") stmt = line
    else stmt = pending " " line

    # Mehrzeilige Arrays (Klammer offen) und offene Strings sammeln.
    if (pdepth(stmt) > 0 || openquote(stmt)) {
        pending = stmt
        next
    }
    parse_stmt(stmt)
    pending = ""
}

END {
    if (pending != "") parse_stmt(pending)

    # ---------- Instrumente ----------
    for (i = 1; i <= NK; i++) {
        k = ORDER[i]
        if (k !~ /^INS[^_]+_/) continue
        rest = k
        sub(/^INS/, "", rest)
        id = rest
        sub(/_.*$/, "", id)
        fld = rest
        sub(/^[^_]+_/, "", fld)

        if (!(id in ISEEN)) { ISEEN[id] = 1; IORDER[++NI] = id }

        v = KV[k]
        if (fld == "NAME") INAME[id] = strval(v)
        else if (fld == "FRAME" && !(id in IFFRAME)) IFFRAME[id] = strval(v)
        else if (fld == "FOV_SHAPE") ISHAPE[id] = strval(v)
        else if (fld == "FOV_FRAME") IFFRAME[id] = strval(v)
        else if (fld == "FOV_REF_VECTOR") { n = nums(v, T); IVEC[id] = vecfmt(T, n) }
        else if (fld == "FOV_REF_ANGLE") { n = nums(v, T); IREF[id] = (n ? T[1] : "") }
        else if (fld == "FOV_CROSS_ANGLE") { n = nums(v, T); ICROSS[id] = (n ? T[1] : "") }
        else if (fld == "BORESIGHT") { n = nums(v, T); IBORE[id] = vecfmt(T, n) }
        else if (fld == "BANDWIDTH") { n = nums(v, T); IBW[id] = numfmt(T, n) }
        else if (fld == "WAVELENGTH") { n = nums(v, T); IWL[id] = numfmt(T, n) }
        else if (fld == "WAVELENGTH_RANGE" && !(id in IWL)) { n = nums(v, T); IWL[id] = numfmt(T, n) }
    }

    # ---------- Frames ----------
    # FRAME_<key> = <code>           klassisch: Name -> Code
    # FRAME_<key>_NAME / _FRAME_CODE idealisiert: Key traegt Name und Code
    # FRAME_<code>_NAME / _CLASS     klassisch: Code traegt Name/Klasse
    for (i = 1; i <= NK; i++) {
        k = ORDER[i]
        if (k !~ /^FRAME_/) continue
        rest = substr(k, 7)
        if (rest == "") continue

        if (rest ~ /_(NAME|FRAME_CODE|CLASS_ID|CLASS|CENTER_ID|CENTER)$/) {
            x = rest
            v = KV[k]
            if (rest ~ /_FRAME_CODE$/) {
                sub(/_FRAME_CODE$/, "", x)
                n = nums(v, T); if (n) FCODE[x] = T[1]
            } else if (rest ~ /_CLASS_ID$/) {
                sub(/_CLASS_ID$/, "", x)
            } else if (rest ~ /_CLASS$/) {
                sub(/_CLASS$/, "", x)
                n = nums(v, T); if (n) FCLASS[x] = T[1]
            } else if (rest ~ /_CENTER_ID$/) {
                sub(/_CENTER_ID$/, "", x)
            } else if (rest ~ /_CENTER$/) {
                sub(/_CENTER$/, "", x)
                n = nums(v, T); if (n) FCENTER[x] = T[1]
            } else {
                sub(/_NAME$/, "", x)
                FNAME[x] = strval(v)
            }
            if (x != "") {
                if (!(x in FSEEN)) { FSEEN[x] = 1; FKEY[++NF] = x }
            }
        } else {
            n = nums(KV[k], T)
            if (n) {
                FCODE[rest] = T[1]
                if (!(rest in FSEEN)) { FSEEN[rest] = 1; FKEY[++NF] = rest }
            }
        }
    }

    # TKFRAME_<id>_RELATIVE ordnet einen Frame einem Bezugsframe zu. Ein
    # Frame, der nur hier auftaucht, wird mit seinem Code registriert.
    for (i = 1; i <= NK; i++) {
        k = ORDER[i]
        if (k !~ /^TKFRAME_/ || k !~ /_RELATIVE$/) continue
        x = k
        sub(/^TKFRAME_/, "", x)
        sub(/_RELATIVE$/, "", x)
        if (x == "") continue
        TRELV[x] = strval(KV[k])
        if (!(x in FSEEN)) { FSEEN[x] = 1; FKEY[++NF] = x }
    }

    # Code -> sprechende ID. Ein Name-Key schlaegt einen numerischen Key.
    for (i = 1; i <= NF; i++) {
        x = FKEY[i]
        if (x in FCODE) code = FCODE[x]
        else if (is_num(x)) code = x
        else continue
        if (!(code in CODESEEN)) { CODESEEN[code] = 1; CORDER[++NC] = code }
        if (!(code in CODEID) || (is_num(CODEID[code]) && !is_num(x))) CODEID[code] = x
    }

    # ---------- Ausgabe ----------
    if (NI == 0 && NC == 0) {
        print "spec: keine Instrumenten-Spec" > "/dev/stderr"
        exit 3
    }

    for (i = 1; i <= NI; i++) {
        id = IORDER[i]
        if (id in INAME && INAME[id] != "") printf "spec instrument %s \"%s\"\n", id, qname(INAME[id])
        else printf "spec instrument %s\n", id
        if (id in ISHAPE && ISHAPE[id] != "") printf "spec fov %s %s\n", id, ISHAPE[id]
        if (id in IFFRAME && IFFRAME[id] != "") printf "spec fovframe %s %s\n", id, IFFRAME[id]
        if (id in IBORE && IBORE[id] != "") printf "spec boresight %s %s\n", id, IBORE[id]
        if (id in IBW && IBW[id] != "") printf "spec bandwidth %s %s\n", id, IBW[id]
        if (id in IWL && IWL[id] != "") printf "spec wavelength %s %s\n", id, IWL[id]
    }

    for (i = 1; i <= NC; i++) {
        code = CORDER[i]
        printf "spec frame %s %s\n", CODEID[code], code
    }

    printf "spec kernel %s %s B, %d Instrumente, %d Frames\n", kname, kbytes, NI, NC
}
AWK
)"

out="$tmp/out"
awk -v kname="$name" -v kbytes="$bytes" "$prog" "$body" >"$out"
rc=$?
case "$rc" in
    0) ;;
    3) exit 3 ;;
    *) die3 "Kernel nicht lesbar" ;;
esac
[ -s "$out" ] || die3 "keine Instrumenten-Spec"
cat "$out"
exit 0
