#!/bin/bash
# zonen — Katalog aller Ordner in den drei Häusern, in denen Dokumente liegen.
#
# Keine Wertung, kein Eigentum, kein git. Nur: welche Ordner gibt es, wo,
# wie viele Dokumente, wie groß, wie alt.
#   Dokument = Textdatei mit dauerhafter Form (.md .φ .txt .rst .markdown .csv .tsv .pdf)
#   Kategorien je Dokument:
#     dok    docs-artig — Dokument mit Doku-Form (md/rst/φ)
#     daten  Daten — csv/tsv/txt-Massen, Logs
#     code   Code/Konfig — .rs .sh .js .py .toml .json .yml ...
#
# Usage:
#   zonen                 Katalog: Ordner mit Dokumenten, Tiefe 2, drei Häuser
#   zonen <haus>          nur ein Haus (omegaflow | work | personal)
#   zonen --depth N       andere Tiefe (1 = Wurzelordner, 3 = weitere)
#   zonen --dupes         Ordner-Namen, die in mehr als einem Haus vorkommen
#   zonen --orphans       nur Ordner ohne README/INDEX (unbeschriftet)
#   zonen --noui T        Ordner mit wenigen Dokumenten (Default T=2)
set -u

H="$(cd "$(dirname "$0")" && pwd)"
ROOTS="$(cd "$H/.." && pwd)"
WF="${OMEGAFLOW_WORK:-$HOME/projects/omegaflow-work}"
PRIV="${OMEGAFLOW_PRIVATE:-$HOME/projects/omegaflow-personal}"

DEPTH=2; MODE=katalog; SMALL=2
while [ $# -gt 0 ]; do
  case "$1" in
    --depth) DEPTH="${2:?}"; shift 2;;
    --dupes) MODE=dupes; shift;;
    --orphans) MODE=orphans; shift;;
    --noui) MODE=small; SMALL="${2:-2}"; shift; [ $# -gt 0 ] && [ "${1#--}" = "$1" ] && shift;;
    --*) shift;;
    *) ONLY="$1"; shift;;
  esac
done
ONLY="${ONLY:-}"

DOC_RE='\.(md|markdown|rst|φ|pdf)$'
KAT_DOC='\.(md|markdown|rst|φ)$|\.pdf$'
KAT_DATEN='\.(csv|tsv|txt|log)$'
KAT_CODE='\.(rs|sh|py|js|ts|json|ya?ml|toml|html|css|sql|rs\.in)$'

root_of() { case "$1" in omegaflow) echo "$ROOTS";; work) echo "$WF";; personal) echo "$PRIV";; esac; }

# alt: Tage seit der jüngsten mtime im Ordner (0 = heute)
alter() { local t; t=$(find "$1" -type f -printf '%T@\n' 2>/dev/null | sort -n | tail -1); [ -n "$t" ] || { echo '-'; return; }; echo $(( ( $(date +%s) - ${t%.*} ) / 86400 )); }

katalog() {
  local haus="$1" root="$2" d n docd daten code alt sz
  find "$root" -mindepth 1 -maxdepth "$DEPTH" -type d -not -path '*/.git*' -not -path '*/node_modules*' \
       -not -path '*/target/*' -not -path '*/__pycache__*' -printf '%P\n' 2>/dev/null | sort | while IFS= read -r d; do
    docd=$(find "$root/$d" -maxdepth 1 -type f -regextype posix-extended -regex ".*($KAT_DOC)" 2>/dev/null | wc -l)
    daten=$(find "$root/$d" -maxdepth 1 -type f -regextype posix-extended -regex ".*($KAT_DATEN)" 2>/dev/null | wc -l)
    code=$(find "$root/$d" -maxdepth 1 -type f -regextype posix-extended -regex ".*($KAT_CODE)" 2>/dev/null | wc -l)
    # nur Ordner, die selbst Dokumente halten (Unterordner zählen für die Eltern nicht)
    [ $((docd+daten+code)) -gt 0 ] || continue
    n=$(find "$root/$d" -maxdepth 1 -type f 2>/dev/null | wc -l)
    sz=$(du -sh "$root/$d" 2>/dev/null | cut -f1)
    alt=$(alter "$root/$d")
    printf '%s\t%s\t%d\t%d\t%d\t%d\t%s\t%s\n' "$haus" "$d" "$docd" "$daten" "$code" "$n" "${sz:-?}" "$alt"
  done
}

alle() {
  local h
  for h in $( [ -n "$ONLY" ] && echo "$ONLY" || echo omegaflow work personal ); do
    katalog "$h" "$(root_of "$h")"
  done
}

if [ "$MODE" = dupes ]; then
  alle | awk -F'\t' '{base=$2; sub(/.*\//,"",base); print base"\t"$1"\t"$2"\t"$3} ' \
       | sort | awk -F'\t' '{c[$1]++; l[$1]=l[$1]" "$2"/"$3} END{for(b in c) if(c[b]>1) printf "DOPPELT\t%s\t%dx\t%s\n", b, c[b], l[b]}' | sort
  exit 0
fi

if [ "$MODE" = orphans ]; then
  alle | while IFS=$'\t' read -r haus d docd daten code n sz alt; do
    r="$(root_of "$haus")/$d"
    ls "$r" 2>/dev/null | grep -qiE '^(README|INDEX|_index|00-INDEX)' || printf '%s\t%s\t%d Dok\t%s\n' "$haus" "$d" "$docd" "$sz"
  done
  exit 0
fi

if [ "$MODE" = small ]; then
  alle | awk -F'\t' -v s="$SMALL" '$3+$4 < s {printf "%s\t%s\t%d Dok\t%d\n", $1, $2, $3+$4, $5}'
  exit 0
fi

{
  printf 'HAUS\tORDNER\tDOK\tDATEN\tCODE\tDATEIEN\tGROESSE\tTAGE\n'
  alle | sort -t$'\t' -k1,1 -k2,2
} | column -t -s$'\t'
echo
echo "— Summen je Haus —"
alle | awk -F'\t' '{o[$1]++; d[$1]+=$3; t[$1]+=$4; printf ""} END{for(h in o) printf "%s: %d Ordner mit Dokumenten · %d Doku · %d Daten\n", h, o[h], d[h], t[h]}' | sort
