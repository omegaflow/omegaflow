{
  "$schema": "https://opencode.ai/config.json",
  "shell": "/home/johannes/projects/omegaflow/bin/agent_sandbox",
  "instructions": [
    "AGENTS.md"
  ],
  "model": "deepseek/deepseek-flash",
  "small_model": "deepseek/deepseek-flash",
  "default_agent": "line",
  "watcher": {
    "ignore": [
      "target/**",
      "*.φ",
      ".continue/**",
      "docs/**",
      "data/**",
      "cache/**",
      "state/**",
      "**/*.log",
      "**/*.fits",
      "**/*.fits.gz",
      "**/*.h5",
      "**/*.bsp",
      "**/*.tif",
      "**/*.tiff",
      "**/*.gz",
      "**/*.bin"
    ]
  },
  "agent": {
    "rat": {
      "mode": "subagent",
      "model": "deepseek/deepseek-flash",
      "variant": "low",
      "permission": {
        "edit": "deny",
        "task": "deny"
      }
    },
    "line": {
      "mode": "primary",
      "model": "deepseek/deepseek-flash",
      "variant": "low",
      "permission": {
        "edit": "allow",
        "webfetch": "deny",
        "websearch": "deny",
        "task": {
          "*": "deny",
          "taucher": "allow",
          "rat": "allow"
        }
      }
    },
    "taucher": {
      "mode": "subagent",
      "model": "deepseek/deepseek-flash",
      "variant": "low",
      "permission": {
        "edit": "deny",
        "task": "deny",
        "playwright_*": "allow"
      }
    }
  },
  "mcp": {
    "chrome-devtools": {
      "type": "local",
      "command": [
        "bin/chrome-devtools-mcp",
        "--autoConnect"
      ],
      "cwd": ".",
      "enabled": true,
      "timeout": 180000
    }
  },
  "permission": {
    "edit": "allow",
    "webfetch": "deny",
    "websearch": "deny"
  },
  "lsp": true,
  "compaction": {
    "auto": true
  },
  "tool_output": {
    "max_lines": 80,
    "max_bytes": 4096
  },
  "logLevel": "WARN"
}
