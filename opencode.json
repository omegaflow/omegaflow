{
  "$schema": "https://opencode.ai/config.json",
  "shell": "/bin/bash",
  "permissions": [
    {
      "action": "*",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "read",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "edit",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "archive_search *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "sgrep *",
      "effect": "allow"
    },
    {
      "action": "webfetch",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "websearch",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "AGENTS.md",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "opencode.json",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": ".opencode/**",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "**/.secrets.local",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "**/.secrets.local",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "*secrets.local*",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "**/auth.json",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "/home/johannes/projects/omegaflow-personal/**",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "/home/johannes/projects/omegaflow-personal/**",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "*omegaflow-personal*",
      "effect": "deny"
    }
  ],
  "model": "deepseek/deepseek-flash",
  "watcher": {
    "ignore": [
      "target/**",
      "**/*.φ",
      "docs/**",
      "data/**",
      "state/**",
      "**/*.log",
      "**/*.fits",
      "**/*.fits.gz",
      "**/*.h5",
      "**/*.bsp",
      "**/*.tif",
      "**/*.tiff",
      "**/*.gz",
      "**/*.bin"
    ]
  }
}
