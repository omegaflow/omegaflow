{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md", "docs/council_voices.yaml"],
  "model": "deepseek/deepseek-v4-pro",
  "small_model": "deepseek/deepseek-v4-flash",
  "default_agent": "build",
  "subagent_depth": 2,
  "permission": {
    "edit": "allow",
    "bash": {
      "cargo *": "allow",
      "git *": "allow",
      "curl *": "allow",
      "rg *": "allow",
      "ls *": "allow",
      "gh *": "allow",
      "*": "ask"
    },
    "webfetch": "allow",
    "websearch": "allow"
  },
  "formatter": {
    "rust": {
      "command": ["rustfmt"],
      "extensions": [".rs"]
    }
  },
  "lsp": true,
  "compaction": {
    "auto": true,
    "prune": true,
    "tail_turns": 30
  },
  "tool_output": {
    "max_lines": 300,
    "max_bytes": 50000
  },
  "watcher": {
    "ignore": ["target/**", "*.φ", ".continue/**", "docs/**"]
  },
  "agent": {
    "build": {
      "mode": "primary",
      "model": "deepseek/deepseek-v4-pro",
      "permission": {
        "edit": "allow",
        "bash": "allow"
      }
    },
    "plan": {
      "mode": "primary",
      "model": "deepseek/deepseek-v4-pro",
      "permission": {
        "edit": "deny",
        "bash": "deny"
      }
    },
    "general": {
      "mode": "subagent",
      "model": "deepseek/deepseek-v4-flash",
      "description": "General research and multi-step execution that needs no architectural judgment — use for routine investigation, verification, and parallelizable units of work.",
      "permission": {
        "edit": "deny"
      }
    },
    "explore": {
      "mode": "subagent",
      "model": "deepseek/deepseek-v4-flash",
      "permission": {
        "edit": "deny"
      }
    },
    "council": {
      "mode": "subagent",
      "model": "deepseek/deepseek-v4-pro",
      "permission": {
        "edit": "deny"
      }
    },
    "grind-flash": {
      "mode": "subagent",
      "model": "deepseek/deepseek-v4-flash",
      "description": "Routine source-port work that needs bash+edit but no judgment: API reachability verification (curl), catalog harvesting, mechanical recheck batches, --probe review of obvious cases. No Force-Gate decisions.",
      "permission": {
        "edit": "allow",
        "bash": "allow"
      }
    },
    "grind-pro": {
      "mode": "subagent",
      "model": "deepseek/deepseek-v4-pro",
      "description": "Judgment source-port work: Force-Gate litmus classification, parser-gap research, novel source curation, kraft-kanal research. Not for mechanical harvest/verify/recheck.",
      "permission": {
        "edit": "allow",
        "bash": "allow"
      }
    }
  },
  "experimental": {
    "batch_tool": false
  }
}