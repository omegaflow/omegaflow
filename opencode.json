{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md"
  ],
  "model": "omegaflow/deepseek-v4-flash",
  "small_model": "omegaflow/deepseek-v4-flash",
  "default_agent": "build",
  "subagent_depth": 2,
  "permission": {
    "edit": "allow",
    "bash": {
      "cargo *": "allow",
      "git *": "allow",
      "omega_sh *": "allow",
      "sgrep *": "allow",
      "sfetch *": "allow",
      "smail *": "allow",
      "./target/release/*": "allow",
      "*": "ask"
    },
    "webfetch": "allow",
    "websearch": "allow"
  },
  "formatter": {
    "rust": {
      "command": [
        "rustfmt"
      ],
      "extensions": [
        ".rs"
      ]
    }
  },
  "lsp": true,
  "compaction": {
    "auto": true
  },
  "tool_output": {
    "max_lines": 80,
    "max_bytes": 4096
  },
  "watcher": {
    "ignore": [
      "target/**",
      "*.φ",
      ".continue/**",
      "docs/**"
    ]
  },
  "experimental": {
    "batch_tool": false
  }
}
