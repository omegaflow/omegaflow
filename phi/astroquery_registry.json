  "jplhorizons": {
    "name": "jpl_horizons",
    "ttl": 86400,
    "force": "em",
    "url": "https://ssd.jpl.nasa.gov/api/horizons.api",
    "method": "GET",
    "params": {
      "format": "json",
      "COMMAND": "\"{target}\"",
      "EPHEM_TYPE": "OBSERVER",
      "QUANTITIES": "\"1,2,3,4,5,6,7,8,9\"",
      "START_TIME": "\"{start}\"",
      "STOP_TIME": "\"{stop}\"",
      "STEP_SIZE": "\"1d\"",
      "CSV_FORMAT": "YES"
    },
    "notes": "JPL Horizons. Use format=json&CSV_FORMAT=YES for JSON. Target=planet/asteroid ID.",
    "tier": "text_other"
  },
