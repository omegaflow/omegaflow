{
  "splatalogue": {
    "name": "splatalogue",
    "ttl": 2592000,
    "force": "em",
    "url": "https://splatalogue.online/splata-slap/advanceded/false?chemical_element=&chemical_element_min=&chemical_element_max=&max_frequency={max_freq}&min_frequency={min_freq}",
    "notes": "Splatalogue molecular line database. Returns JSON. Query by frequency range.",
    "tier": "json_rest"
  },
  "jplsbdb": {
    "name": "jpl_sbdb",
    "ttl": 86400,
    "force": "em",
    "url": "https://ssd-api.jpl.nasa.gov/sbdb.api?sstr={target}",
    "map_path": "object",
    "fields": {
      "fullname": "name",
      "spkid": "id",
      "orbit_class.code": "orbit_class",
      "epoch": "epoch",
      "e": "eccentricity",
      "a": "semi_major_axis_au",
      "q": "perihelion_au",
      "i": "inclination_deg",
      "node": "longitude_node_deg",
      "per": "perihelion_arg_deg",
      "tp": "perihelion_time",
      "n": "mean_motion_deg_per_day",
      "ma": "mean_anomaly_deg",
      "H": "abs_magnitude"
    },
    "notes": "JPL Small-Body Database. GET with sstr=target name. No RA/Dec (orbital elements).",
    "tier": "json_rest"
  },
  "oac": {
    "name": "oac_astrocats",
    "ttl": 86400,
    "force": "em",
    "url": "https://api.astrocats.space/{target}/",
    "lat_key": "ra",
    "lon_key": "dec",
    "fields": {
      "name": "name",
      "claimedtype": "type",
      "redshift": "redshift"
    },
    "notes": "Open Astronomy Catalog. Returns JSON with transient metadata. Single-object response.",
    "tier": "json_rest"
  },
  "gemini": {
    "name": "gemini_archive",
    "ttl": 3600,
    "force": "em",
    "url": "https://archive.gemini.edu/jsonsummary/notengineering/NotFail/",
    "map_path": ".",
    "lat_key": "ra",
    "lon_key": "dec",
    "fields": {
      "object": "target",
      "instrument": "instrument",
      "observation_id": "observation_id",
      "utc": "observation_date"
    },
    "notes": "Gemini archive JSON summary. Returns array of objects. Append filters to URL path.",
    "tier": "json_rest"
  },
  "mast": {
    "name": "mast_caom",
    "ttl": 3600,
    "force": "em",
    "tap_url": "https://mast.stsci.edu/vo-tap/api/v0.1/caom/sync",
    "pos_fields": [
      "s_ra",
      "s_dec"
    ],
    "json_format": "object",
    "default_table": "caom.Observation",
    "fields": {
      "s_ra": "ra_deg",
      "s_dec": "dec_deg",
      "obs_id": "observation_id",
      "obs_collection": "collection",
      "instrument_name": "instrument",
      "filters": "filters",
      "target_name": "target",
      "calib_level": "calibration_level"
    },
    "adql_template": "SELECT TOP 200 s_ra,s_dec,obs_id,obs_collection,instrument_name,filters,target_name,calib_level FROM caom.Observation WHERE CONTAINS(POINT('ICRS',s_ra,s_dec),CIRCLE('ICRS',{ra},{dec},0.1))=1",
    "format_support": [
      "votable",
      "json"
    ],
    "notes": "MAST CAOM TAP via /vo-tap. Supports FORMAT=json. Returns object-array JSON.",
    "tier": "tap_adql"
  },
  "gaia": {
    "name": "gaia_dr3",
    "ttl": 2592000,
    "force": "em",
    "tap_url": "https://gea.esac.esa.int/tap-server/tap/sync",
    "default_table": "gaiadr3.gaia_source",
    "pos_fields": [
      "ra",
      "dec"
    ],
    "json_format": "array",
    "fields": {
      "ra": "ra_deg",
      "dec": "dec_deg",
      "parallax": "parallax_mas",
      "pmra": "pmra_mas_per_yr",
      "pmdec": "pmdec_mas_per_yr",
      "phot_g_mean_mag": "mag_g",
      "phot_bp_mean_mag": "mag_bp",
      "phot_rp_mean_mag": "mag_rp",
      "radial_velocity": "radial_velocity_km_s"
    },
    "adql_template": "SELECT TOP 200 ra,dec,parallax,pmra,pmdec,phot_g_mean_mag,phot_bp_mean_mag,phot_rp_mean_mag,radial_velocity FROM gaiadr3.gaia_source WHERE 1=CONTAINS(POINT('ICRS',ra,dec),CIRCLE('ICRS',{ra},{dec},{radius}))",
    "format_support": [
      "votable",
      "json"
    ],
    "notes": "Gaia DR3 TAP. Supports FORMAT=json (returns array-of-arrays). Use /sync for GET.",
    "tier": "tap_adql"
  },
  "simbad": {
    "name": "simbad",
    "ttl": 604800,
    "force": "em",
    "tap_url": "https://simbad.cds.unistra.fr/simbad/sim-tap",
    "default_table": "basic",
    "pos_fields": [
      "ra",
      "dec"
    ],
    "fields": {
      "main_id": "name",
      "ra": "ra_deg",
      "dec": "dec_deg",
      "coo_err_maj": "pos_error_mas",
      "plx_value": "parallax_mas",
      "pmra": "pmra_mas_per_yr",
      "pmdec": "pmdec_mas_per_yr",
      "rv_value": "radial_velocity_km_s",
      "sp_type": "spectral_type"
    },
    "adql_template": "SELECT TOP 200 {fields} FROM {table} WHERE CONTAINS(POINT('ICRS',ra,dec),CIRCLE('ICRS',{ra},{dec},{radius}))=1",
    "format_support": [
      "votable"
    ],
    "notes": "SIMBAD TAP. VOTable only. Server unreachable as of 2026-07-28.",
    "tier": "tap_adql"
  },
  "vizier": {
    "name": "vizier",
    "ttl": 2592000,
    "force": "em",
    "tap_url": "https://tapvizier.cds.unistra.fr/TAPVizieR/tap/sync",
    "pos_fields": [
      "RAJ2000",
      "DEJ2000"
    ],
    "fields": {
      "RAJ2000": "ra_deg",
      "DEJ2000": "dec_deg"
    },
    "adql_template": "SELECT TOP 200 * FROM \"{catalog}\" WHERE CONTAINS(POINT('ICRS',RAJ2000,DEJ2000),CIRCLE('ICRS',{ra},{dec},{radius}))=1",
    "format_support": [
      "votable"
    ],
    "notes": "VizieR TAP. Catalog name required (e.g. 'I/355/gaiadr3'). VOTable only.",
    "tier": "tap_adql"
  },
