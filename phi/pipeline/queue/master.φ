source opensky_aircraft_positions
ttl 10
force em
url https://opensky-network.org/api/states/all
map states
lat_key 6
lon_key 5
field_in 0 icao24
field_in 1 callsign
field_in 2 origin_country
field_in 7 baro_altitude_m
field_in 9 velocity_ms
field_in 10 heading_deg
field_in 11 vertical_rate_ms
field_in 13 on_ground

