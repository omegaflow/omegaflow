source irsa_2mass_psc
ttl 86400
force em
url https://irsa.ipac.caltech.edu/cgi-bin/Gator/nph-query?catalog=fp_psc&spatial=box&ra=0.0&dec=0.0&size=14400&outfmt=1&selcols=ra,dec,j_m,h_m,k_m&outrows=5000
format text
rows
ra_key ra
dec_key dec
field j_m mag_j
field h_m mag_h
field k_m mag_k

# ---------------------------------------------------------------------------
# [5] IRSA / AllWISE — All-Sky Source Catalog (allwise_p3as_psd)
#     W1–W4 mid-infrared bands (3.4, 4.6, 12, 22 µm)
#     Cone via Gator REST; outfmt=1 = IPAC ASCII table
#     selcols: ra, dec, w1mpro, w2mpro, w3mpro, w4mpro
# ---------------------------------------------------------------------------
source irsa_allwise_psd
ttl 86400
force em
url https://irsa.ipac.caltech.edu/cgi-bin/Gator/nph-query?catalog=allwise_p3as_psd&spatial=box&ra=0.0&dec=0.0&size=14400&outfmt=1&selcols=ra,dec,w1mpro,w2mpro,w3mpro,w4mpro&outrows=5000
format text
rows
ra_key ra
dec_key dec
field w1mpro mag_w1
field w2mpro mag_w2
field w3mpro mag_w3
field w4mpro mag_w4

# ---------------------------------------------------------------------------
# [6] IRSA / NEOWISE-R — Year 10 single-exposure table (neowiser_p1bs_psd)
#     Active survey data (post-2013 reactivation), W1+W2 only
#     Useful for time-variable sources (asteroids, transients)
# ---------------------------------------------------------------------------
source irsa_neowise_r10
ttl 3600
force em
url https://irsa.ipac.caltech.edu/cgi-bin/Gator/nph-query?catalog=neowiser_p1bs_psd&spatial=box&ra=0.0&dec=0.0&size=3600&outfmt=1&selcols=ra,dec,w1mpro,w2mpro,mjd&outrows=2000&constraints=mjd%3E59000
format text
rows
ra_key ra
dec_key dec
field w1mpro mag_w1
field w2mpro mag_w2
field mjd mjd

# ---------------------------------------------------------------------------
# [7] IRSA TAP / 2MASS — ADQL geometric cone at Galactic center region
#     TAP/sync endpoint returns VOTable XML → parse as text
#     Demonstrates the TAP path (see Notes above)
#     ⚠ outfmt not JSON — use format text + rows; columns TSV-parsable
# ---------------------------------------------------------------------------
source irsa_tap_2mass_galcenter
ttl 86400
force em
url https://irsa.ipac.caltech.edu/TAP/sync?LANG=ADQL&FORMAT=csv&QUERY=SELECT+TOP+3000+ra,dec,j_m,h_m,k_m+FROM+fp_psc+WHERE+CONTAINS(POINT('ICRS',ra,dec),CIRCLE('ICRS',266.4,-29.0,2.0))=1
format text
rows
ra_key ra
dec_key dec
field j_m mag_j
field h_m mag_h
field k_m mag_k


