#       "type": "Feature",
#       "geometry": {"type": "Point", "coordinates": [lon, lat]},
#       "properties": {
#         "mag": 2.1,
#         "type": "marsquake",
#         "time": "2022-03-12T06:45:23.000Z",
#         "depth": 8,
#         "quality": "A",
#         "catalog": "MQS"
#       }
#     }, ...
#   ]
# }
# → map features
# Koordinaten: Mars-Planetozentrisch (Ares Vallis ≈ 19.13°N, 33.22°W)
# ⚠ lon: Mars verwendet Längengrade 0-360° (östlich); 
#   Standard: Gale Crater (5.4°S, 137.8°E auf Mars)
#   InSight Landeort: 4.502°N, 135.623°E (Mars-ICRF)

