# ===========================================================================
# EVAPOTRANSPIRATION / VEGETATIONSWASSERHAUSHALT
# GLEAM (Global Land Evaporation Amsterdam Model):
#   https://www.gleam.eu → NetCDF-Kacheln, kein direktes REST-CSV
# VIABLE FREI:
# 1. NOAA CoastWatch ERDDAP: MODIS ET (MOD16A2 via erdMH1ET8day)
# 2. Open-Meteo: ET0-Proxy (FAO Penman-Monteith) global
# 3. FLUXNET: Eddy-Covariance Tower-Messungen (JSON, stationsbezogen)
# Force: diffusion (H2O-Fluss von Oberfläche in Atmosphäre)
# ===========================================================================

# ---------------------------------------------------------------------------
# [27] NOAA CoastWatch ERDDAP — MODIS Terra ET 8-Tage Global (MOD16A2)
#      Aktuelle Evapotranspiration + Latenter Wärmestrom vom Land
#      ERDDAP-Dataset: erdMH1ET8day (oder erdMT1ET8day für Terra)
# ---------------------------------------------------------------------------
source noaa_modis_et_8day_global
ttl 86400
force diffusion
url https://coastwatch.noaa.gov/erddap/griddap/erdMH1ET8day.csv?ET%5Blast%5D%5B(-60.0):(75.0):5%5D%5B(-180.0):(180.0):5%5D
format text
rows
lat_key latitude
lon_key longitude
field ET evapotranspiration_kg_m2_8d

# ---------------------------------------------------------------------------
# [28] FLUXNET — Eddycovariance-Türme (Kohlenstoff + Wasser + Energie)
#      FLUXNET2015: >200 Türme weltweit, stündlich/täglich
#      Öffentlicher REST: FLUXNET API via AmeriFlux/ICOS
#      ICOS Data Portal REST: https://data.icos-cp.eu/portal/
# ---------------------------------------------------------------------------
source icos_fluxnet_tower_stations
ttl 86400
force diffusion
url https://meta.icos-cp.eu/sparql?format=json&query=SELECT+?uri+?name+?lat+?lon+?alt+?country+?ecosys+WHERE+{?uri+a+<http://meta.icos-cp.eu/ontologies/cpmeta/ES>+;+<http://www.w3.org/2000/01/rdf-schema#label>+?name+;+<http://meta.icos-cp.eu/ontologies/cpmeta/hasLatitude>+?lat+;+<http://meta.icos-cp.eu/ontologies/cpmeta/hasLongitude>+?lon+}
map results.bindings
lat_key lat.value
lon_key lon.value
field name.value station_name
field country.value country_code
field alt.value altitude_m
field ecosys.value ecosystem_type

# ---------------------------------------------------------------------------
# [29] Open-Meteo — Globale ET0 (FAO-56 Penman-Monteith, tagesaktuell)
#      ET0: Referenz-Evapotranspiration = Standardisierter Verdunstungsindex
#      Ergänzt MODIS-ET mit Echtzeit-Schätzung ohne 8-Tage-Verzögerung
# ---------------------------------------------------------------------------
source open_meteo_et0_realtime_grid
ttl 3600
force diffusion
url https://api.open-meteo.com/v1/forecast?latitude={lat}&longitude={lon}&daily=et0_fao_evapotranspiration,precipitation,soil_moisture_0_to_7cm,soil_moisture_7_to_28cm&models=era5_seamless&forecast_days=1&format=json
terra 1
map daily.time
field_in daily.et0_fao_evapotranspiration et0_mm_d
field_in daily.precipitation precipitation_mm
field_in daily.soil_moisture_0_to_7cm soil_moisture_0_7cm
field_in daily.soil_moisture_7_to_28cm soil_moisture_7_28cm


