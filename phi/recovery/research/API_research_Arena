field commonName event_name
field GPS gps_time
field parameters.mass_1_source.best mass1_solar
field parameters.mass_2_source.best mass2_solar
field parameters.luminosity_distance.best lum_dist_mpc
field parameters.has_ns.best has_neutron_star

# ---------------------------------------------------------------------------
# [17] GWOSC — Beobachtungsläufe (O1–O4) Metadaten
