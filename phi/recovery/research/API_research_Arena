# ===========================================================================
# SDSS / 2MASS / WISE  —  photometric catalog queries via IRSA Gator + SkyServer
# ALL sources: point-cloud compatible (ra_key + dec_key + dist via redshift)
# TTL 86400: static catalog data, daily re-fetch is sufficient
# Force: em (photons = EM radiation)
# ===========================================================================

# ---------------------------------------------------------------------------
# [1] SDSS DR18 — photometric galaxy catalog via SkyServer SQL REST
#     Returns JSON array of galaxies with ra, dec, photometric z (redshift)
#     PC-compatible: ra_key + dec_key + z_key → ICRS 3-D
# ---------------------------------------------------------------------------
source sdss_dr18_galaxies
ttl 86400
force em
url https://skyserver.sdss.org/dr18/SearchTools/sql?cmd=SELECT+TOP+5000+ra,dec,z,r,g,i+FROM+SpecObj+WHERE+class%3D%27GALAXY%27+AND+z+BETWEEN+0.01+AND+0.3+AND+zWarning%3D0&format=json
cmap .
ra_key ra
dec_key dec
z_key z
field r mag_r
field g mag_g
field i mag_i

# ---------------------------------------------------------------------------
# [2] SDSS DR18 — photometric QSO / quasar catalog
#     Quasars have measured spectroscopic redshifts → good dist proxy
#     PC-compatible: ra_key + dec_key + z_key
# ---------------------------------------------------------------------------
source sdss_dr18_qso
ttl 86400
force em
url https://skyserver.sdss.org/dr18/SearchTools/sql?cmd=SELECT+TOP+3000+ra,dec,z,psfMag_r,psfMag_g+FROM+SpecObj+WHERE+class%3D%27QSO%27+AND+z+BETWEEN+0.1+AND+3.0+AND+zWarning%3D0&format=json
cmap .
ra_key ra
dec_key dec
z_key z
field psfMag_r mag_r
field psfMag_g mag_g

# ---------------------------------------------------------------------------
# [3] SDSS DR18 — stellar point sources (Star view, photometry only)
#     No spectroscopic z → distance via parallax not available from SDSS;
#     use as 2-D angular map (no dist_key). Still valid em point-cloud in 2D.
# ---------------------------------------------------------------------------
source sdss_dr18_stars
ttl 86400
force em
url https://skyserver.sdss.org/dr18/SearchTools/sql?cmd=SELECT+TOP+5000+ra,dec,r,g,u,i,z+FROM+Star+WHERE+(r-extinction_r)%3C20+AND+clean%3D1&format=json
cmap .
ra_key ra
dec_key dec
field r mag_r
field g mag_g
field u mag_u

# ---------------------------------------------------------------------------
# [4] IRSA / 2MASS — All-Sky Point Source Catalog (fp_psc)
#     REST Gator cone: returns IPAC ASCII text, parse with format text + rows
#     outfmt=1 = IPAC table (pipe-delimited ASCII)
#     selcols: ra, dec, j_m (J-band mag), h_m, k_m
#     NOTE: no spectroscopic z → 2-D angular catalog; dist via photometric
