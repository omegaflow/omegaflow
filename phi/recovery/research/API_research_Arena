# ===========================================================================
# GRAVITATIONSWELLEN — GWOSC (LIGO / Virgo / KAGRA)
# API: https://gwosc.org/api/v2/
# Vollständig öffentlich, kein Auth erforderlich
# Endpunkte:
#   /events/         → Alle GW-Ereignisse (mit Parametern)
#   /catalogs/       → Verfügbare Kataloge (GWTC-1, -2, -3, -4)
#   /events/<name>/  → Einzelereignis-Details
#   /runs/           → Beobachtungsläufe (O1, O2, O3, O4)
# JSON-Antwortstruktur: {"events": {...}} oder direktes Array
# Parameter: mass_1_source, mass_2_source, far, redshift,
#            network_matched_filter_snr, luminosity_distance
# Force: gravity (Gravitationswellen = Raumzeit-Krümmung)
# TTL: 3600 (neue Ereignisse nach Datenfreigabe, Latenz monate)
# ===========================================================================

# ---------------------------------------------------------------------------
# [14] GWOSC — Alle bestätigten GW-Ereignisse (GWTC gesamt)
#      Gibt alle Ereignisse mit zentralen Parametern zurück
#      JSON: {"count":..., "next":..., "results":[...]}
#      Felder: commonName, GPS, mass_1_source, mass_2_source,
#              luminosity_distance, redshift, far, version, catalog.shortName
# ---------------------------------------------------------------------------
source gwosc_gw_events_all
ttl 3600
force gravity
url https://gwosc.org/api/v2/events/?format=json&page_size=300
map results
ra_key sky_map.ra
dec_key sky_map.dec
z_key parameters.redshift.best
field commonName event_name
field GPS gps_time
field parameters.mass_1_source.best mass1_solar
field parameters.mass_2_source.best mass2_solar
field parameters.luminosity_distance.best lum_dist_mpc
field parameters.network_matched_filter_snr.best snr
field catalog.shortName catalog_name

# ---------------------------------------------------------------------------
# [15] GWOSC — GWTC-4 Katalog (O4a, neueste Daten)
#      4. Gravitationswellen-Transientenkatalog: enthält O4-Ereignisse
# ---------------------------------------------------------------------------
source gwosc_gwtc4_catalog
ttl 3600
force gravity
url https://gwosc.org/api/v2/events/?catalog=GWTC-4-confident&format=json&page_size=200
map results
ra_key sky_map.ra
dec_key sky_map.dec
z_key parameters.redshift.best
field commonName event_name
field GPS gps_time
field parameters.mass_1_source.best mass1_solar
field parameters.mass_2_source.best mass2_solar
field parameters.luminosity_distance.best lum_dist_mpc
field parameters.chirp_mass_source.best chirp_mass_solar

# ---------------------------------------------------------------------------
# [16] GWOSC — Neutronenstern-Merger (Typ: BNS + NSBH)
#      Gefiltert auf Ereignisse mit Neutronensternkomplex
