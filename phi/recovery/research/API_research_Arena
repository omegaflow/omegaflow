ttl 86400
force em
url https://irsa.ipac.caltech.edu/TAP/sync?LANG=ADQL&FORMAT=csv&QUERY=SELECT+TOP+3000+designation,ra,dec,i1_f_ap,i2_f_ap,i4_f_ap,m1_f_ap+FROM+spitzer_sage_smc_irac_m1+WHERE+ra+IS+NOT+NULL+AND+i1_f_ap>0.05+ORDER+BY+i1_f_ap+DESC
format text
rows
ra_key ra
dec_key dec
field designation source_id
field i1_f_ap irac_3_6um_mJy
field i2_f_ap irac_4_5um_mJy
field i4_f_ap irac_8_0um_mJy
field m1_f_ap mips_24um_mJy

# ---------------------------------------------------------------------------
