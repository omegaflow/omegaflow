```
# ===========================================================================
# FERMI 4FGL / AGN / BLAZAR
# HEASARC Xamin TAP endpoint: https://heasarc.gsfc.nasa.gov/xamin/vo/tap/sync
# Alle Tabellen: fermilpsc (4FGL-DR4 alle Quellen), fermilac (4LAC AGN)
# Force: em  (Gamma-Strahlung = hochenergetische EM-Strahlung)
# TTL: 86400 (Katalog, jährliche Updates)
# PC-kompatibel: ra_key + dec_key + dist_key (via Rotverschiebung bei AGN)
# ADQL: FORMAT=csv gibt saubes CSV zurück → format text + rows
# Spalten fermilpsc: name, ra, dec, glat, glon, pivot_energy,
#   flux_density, unc_flux_density, spectral_index, signif_avg,
#   class1, assoc_name
# Spalten fermilac: name, ra, dec, redshift, flux1000, nu_syn_peak,
#   class, assoc_name, counterpart_name
# ===========================================================================

# ---------------------------------------------------------------------------
# [1] Fermi 4FGL-DR4 — alle Punktquellen (Gesamt-Katalog ~7000 Objekte)
#     Gefiltert auf signifikante Quellen (signif_avg > 10 sigma)
#     Keine Entfernung → 2-D ICRS-Karte (Kein z_key, kein dist_key)
# ---------------------------------------------------------------------------
source heasarc_fermi_4fgl_all
ttl 86400
force em
url https://heasarc.gsfc.nasa.gov/xamin/vo/tap/sync?LANG=ADQL&FORMAT=csv&QUERY=SELECT+TOP+5000+name,ra,dec,glat,glon,pivot_energy,flux_density,spectral_index,signif_avg,class1,assoc_name+FROM+fermilpsc+WHERE+signif_avg%3E10+ORDER+BY+signif_avg+DESC
format text
rows
ra_key ra
dec_key dec
field flux_density flux_density
field spectral_index spectral_index
field signif_avg significance
field class1 src_class

# ---------------------------------------------------------------------------
# [2] Fermi 4FGL-DR4 — nur Blazare (class1 IN BLL, FSRQ, BCU)
#     Blazare dominieren den Hochenergie-Himmel bei |b|>10°
# ---------------------------------------------------------------------------
source heasarc_fermi_blazars
ttl 86400
force em
url https://heasarc.gsfc.nasa.gov/xamin/vo/tap/sync?LANG=ADQL&FORMAT=csv&QUERY=SELECT+TOP+3000+name,ra,dec,flux_density,spectral_index,signif_avg,class1,assoc_name+FROM+fermilpsc+WHERE+class1+IN+('BLL','bll','FSRQ','fsrq','BCU','bcu')+ORDER+BY+flux_density+DESC
format text
rows
ra_key ra
dec_key dec
field flux_density flux_blazar
field spectral_index spectral_index
field class1 blazar_class

# ---------------------------------------------------------------------------
# [3] Fermi 4LAC-DR3 — AGN-Katalog (3407 AGN, mit Rotverschiebung)
#     PC-kompatibel: ra_key + dec_key + z_key (Rotverschiebung vorhanden)
#     Blazare, Seyferts, NLSy1, Radio Galaxien
# ---------------------------------------------------------------------------
source heasarc_fermi_4lac_agn
ttl 86400
force em
url https://heasarc.gsfc.nasa.gov/xamin/vo/tap/sync?LANG=ADQL&FORMAT=csv&QUERY=SELECT+TOP+3500+name,ra,dec,redshift,flux1000,nu_syn_peak,class,assoc_name+FROM+fermilac+WHERE+redshift+IS+NOT+NULL+AND+redshift%3E0+ORDER+BY+flux1000+DESC
format text
