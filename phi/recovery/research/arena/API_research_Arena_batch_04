#      INTERMAGNET JSON: https://imag-data.bgs.ac.uk/GIN_V1/GINServices?
# ---------------------------------------------------------------------------
source intermagnet_geomagnetic_observatories
ttl 3600
force em
url https://imag-data.bgs.ac.uk/GIN_V1/GINServices?Request=GetObservatoryList&format=json
map .
lat_key latitude
lon_key longitude
field iagaCode station_code
field name station_name
field country country
field dataAvailability data_status
field elevation elevation_m
