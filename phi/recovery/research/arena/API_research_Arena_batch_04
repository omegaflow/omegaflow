# ===========================================================================

# ---------------------------------------------------------------------------
# [43] Planck PCCS2 — Compact Source Catalog 217GHz (via VizieR TAP)
#      VizieR: J/A+A/594/A26/pccs2 (Planck Catalog of Compact Sources 2)
#      Enthält ~48k Quellen bei 30-857 GHz (Galaxien, SZ-Cluster, Staubnebel)
#      217 GHz: optimale Frequenz für CMB + galaktischen Staub
#      PC-kompatibel: ra_key + dec_key (keine Entfernung)
# ---------------------------------------------------------------------------
source vizier_planck_pccs2_217ghz
ttl 86400
force em
url https://tapvizier.cds.unistra.fr/TAPVizieR/tap/sync?REQUEST=doQuery&LANG=ADQL&FORMAT=csv&QUERY=SELECT+TOP+5000+Name,RAJ2000,DEJ2000,Flux,S_N+FROM+"J/A+A/594/A26/pccs2-217"+WHERE+S_N%3E5+ORDER+BY+Flux+DESC
format text
rows
ra_key RAJ2000
dec_key DEJ2000
field Flux flux_217ghz_mjy
field S_N snr
field Name source_name

