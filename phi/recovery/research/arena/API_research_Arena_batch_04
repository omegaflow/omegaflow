#      Endpunkt: /daily/point → Stündliche / tägliche Agro-Daten
# ---------------------------------------------------------------------------
source nasa_power_agro_daily
ttl 86400
force thermal
url https://power.larc.nasa.gov/api/temporal/daily/point?parameters=T2M,T2MDEW,RH2M,WS10M,PRECTOTCORR,ALLSKY_SFC_SW_DWN,ET0&community=AG&longitude={lon}&latitude={lat}&start={year}{month}{day}&end={year}{month}{day}&format=JSON
terra 1
map properties.parameter.T2M
