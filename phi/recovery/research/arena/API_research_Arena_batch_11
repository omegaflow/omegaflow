# ===== BOLD v4 Public API JSON-Struktur ===================================
# http://v4.boldsystems.org/index.php/API_Public/specimen?taxon=X&format=json
# Antwort: JSON-Array (direkt):
# [
#   {
#     "processid": "BCHYM001-09",
#     "taxon": "Animalia",
#     "species_name": "Apis mellifera",
#     "lat": "48.136",
#     "lon": "11.577",
#     "country": "Germany",
#     "province_state": "Bavaria",
#     "institution_storing": "ZFMK Bonn",
#     "collection_date": "2009-06-12",
#     "markercode": "COI-5P"
#   }, ...
# ]
# → map . (Root-Array)
# → lat_key lat / lon_key lon (String → Float-Konvertierung nötig)
# ⚠ BOLDv5 (portal.boldsystems.org/api) verwendet dreistufige Query-Tokens:
#   1. POST /api/query → Token
#   2. GET /api/summary?token=<T> → Zusammenfassung
#   3. GET /api/sequence?token=<T> → Daten-Stream
#   → BOLDv4 REST ist einfacher für direkten Ingestor-Zugriff

# ===== GFZ Kp/Ap JSON-Struktur ============================================
# {
#   "datetime": ["2026-07-27T00:00:00Z", "2026-07-27T03:00:00Z", ...],
#   "Kp": [1.67, 2.33, ...],
#   "Ap": [5, 9, ...],
#   "Cp": [0.1, 0.2, ...],
#   "C9": [1, 1, ...]
# }
# → map . (Dictionary mit Arrays)
# → datetime[i], Kp[i], Ap[i] sind parallel → Ingestor muss zip
# Kp: Dreistunden-Wert (0-9, in 1/3-Schritten: 0.0, 0.33, 0.67, 1.0...)
# Ap: äquivalente Amplitude in nT (Kp→Ap-Umrechnungstabelle beachten)
# Cp: Character Figure (0.0-2.5, geomag. Aktivitätsniveau des Tages)

# ===== GTN-P REST JSON-Struktur ===========================================
# {
#   "stations": [
#     {
#       "station_id": "RUSSIA_001",
#       "station_name": "Yakutsk",
#       "latitude": 62.01,
#       "longitude": 129.73,
#       "country": "Russia",
#       "elevation": 103,
#       "borehole_depth": 32,
#       "start_year": 1996,
#       "environment_type": "continuous permafrost"
#     }, ...
#   ]
# }
# → map stations
# ⚠ GTN-P API kann langsam reagieren → TTL erhöhen oder lokales Caching

# ===== MOVEBANK REST-Format ===============================================
# https://www.movebank.org/movebank/service/direct-read?entity_type=study
# Gibt CSV oder JSON zurück je nach format-Parameter
# Wichtig: entity_type=event für Ortungsdaten, entity_type=study für Metadaten
# Öffentliche Studien: i_have_download_access=true ohne Auth verfügbar
# ⚠ Für Ortungsdaten (entity_type=event):
#   Pflichtparameter: study_id + sensor_type_id
#   Koordinaten: location_lat + location_long (Dezimalgrad)

# ===== IERS EOP CSV-Format ================================================
# finals2000A.data.csv enthält folgende Spalten (Tab-delimitiert):
# year, month, day, mjd, PM-X("), err_PM-X, PM-Y("), err_PM-Y,
# UT1-UTC(s), err_UT1-UTC, LOD(ms), err_LOD, dX("), dY(")
# MJD = Modified Julian Date (JD - 2400000.5)
# Polbewegung: x_p, y_p in Bogensekunden (typisch < 0.5")
# UT1-UTC: Differenz zwischen Erdrotationszeit und UTC (|UT1-UTC| < 0.9s)

# ===== Movebank Storch Tracking JSON =====================================
# {
#   "individuals": [
#     {
#       "individual_id": 12345,
#       "individual_local_identifier": "DE-Ber-2023-01",
#       "location_lat": 52.45,
#       "location_long": 13.43,
#       "timestamp": "2026-07-27T09:15:00.000Z",
#       "ground_speed": 12.3,
#       "heading": 195.5,
#       "altitude": 234
#     }, ...
#   ]
# }
# → map individuals
# → lat_key location_lat / lon_key location_long

# ===== OpenSky States Array-Struktur =====================================
# {
#   "time": 1753257600,
#   "states": [
#     ["ab1234", "DLH123 ", "Germany", ..., lat, lon, alt, ..., on_ground, ...]
#   ]
# }
# → map states
# Spaltenindizes (0-basiert):
#   0: icao24, 1: callsign, 2: origin_country,
#   3: time_position, 4: last_contact,
#   5: longitude, 6: latitude, 7: baro_altitude,
#   8: on_ground, 9: velocity, 10: true_track,
#   11: vertical_rate, 12: sensors, 13: geo_altitude,
#   14: squawk, 15: spi, 16: position_source
# → lat_key 6 / lon_key 5 (direkte Array-Index-Angabe)

# ===== NOAA AWC PIREPs JSON ===============================================
# {
#   "airepType": "PIREP",
#   "airepTime": "2026-07-27T09:00:00Z",
#   "airepLat": 48.3,
#   "airepLon": 11.7,
#   "altitude": 350,   # Flight Level (FL 350 = ~10700m)
#   "turbType": "MOD",
#   "turbInten": "MOD-SEV",
#   "turbFreq": "ISOL",
#   "cloudCovLo": "SCT",
#   "icing": "NONE",
#   "wxString": "MOD TURB 330-350"
# }
# turbInten: NONE, LGT, LGT-MOD, MOD, MOD-SEV, SEV, EXTRM
# altitude: in Hunderten von Fuß (FL) → × 30.48 = Meter
