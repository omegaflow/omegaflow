# ── Block 1: iss_position ──
# Old: pos orbital_iss_lat orbital_iss_lon orbital_iss_alt_km 1000.0 | force em | ttl 10
# New: map-based dynamic position (single-object API — see curation note)

url https://api.wheretheiss.at/v1/satellites/25544
ttl 10
at earth
map
  lat_key latitude
  lon_key longitude
  alt_key altitude
  field iss_presence ISS_Presence inverse-square em 1 1.0 0.0 0.0

# ── Block 2: universe_iss_history ──
# Old: pos universe_iss_history_lat universe_iss_history_lon universe_iss_history_alt 1000 | force em | ttl 10
# New: map-based dynamic position (native array response)

url https://api.wheretheiss.at/v1/satellites/25544/positions?timestamps=1,2,3,4,5
ttl 10
at earth
map
  lat_key latitude
  lon_key longitude
  alt_key altitude
  field iss_history ISS_History_Presence inverse-square em 1 1.0 0.0 0.0

# ── Block 3: anu_quantum_entropy ──
# Old: lat -35.2809 lon 149.1300 | force em | ttl 60 | path data.0 quantum_entropy_anu
# New: fixed surface frame, field extract

url https://qrng.anu.edu.au/API/jsonI.php?length=1&type=uint8
ttl 60
on earth -35.2809 149.1300 0
field data.0 anu_quantum_entropy inverse-square em count 6.0 0.0 0.0

