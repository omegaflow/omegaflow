accepted https://gracedb.ligo.org/api/superevents/?limit=10
# title: LIGO/Virgo/KAGRA Gravitationswellen-Superevents (far = Falschalarmrate, gravity)
url https://gracedb.ligo.org/api/superevents/?limit=10
ttl 300
at earth
last superevents.far gravity_wave_far inverse-square gravity 1 300 0.0 0.0

accepted https://seismic-api.science.unimelb.edu.au/today-quakes
# title: UniMelb AGOS Erdbeben-GeoJSON-Feed (seismic-body)
url https://seismic-api.science.unimelb.edu.au/today-quakes
ttl 300
at earth
map features
lat geometry.coordinates.1
lon geometry.coordinates.0
field geometry.coordinates.2 geosphere_quake_depth_km erfc seismic-body km 3600 0.0 0.0
field properties.magnitude geosphere_quake_magnitude erfc seismic-body Mw 3600 0.0 0.0

accepted https://www.ioc-sealevelmonitoring.org/service.php?query=stationlist&format=json
# title: IOC Sea-Level-Station-Monitoring (lastvalue in m, gravity)
url https://www.ioc-sealevelmonitoring.org/service.php?query=stationlist&format=json
ttl 3600
on earth 0 0 0
map .
lat lat
lon lon
field lastvalue hydrosphere_sealevel_m inverse-square gravity m 3600 0.0 0.0
