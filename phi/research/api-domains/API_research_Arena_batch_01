# ---------------------------------------------------------------------------
# [6] AERONET SDA — Spectral Deconvolution (fine/coarse mode aerosol)
#     Product: SDA15 (L1.5), separates dust from smoke/pollution
#     Columns include: Total_AOD_500nm, Fine_Mode_AOD_500nm, Coarse_Mode_AOD_500nm
# ---------------------------------------------------------------------------
source aeronet_sda_global
ttl 3600
force diffusion
url https://aeronet.gsfc.nasa.gov/cgi-bin/print_web_data_v3?year={year}&month={month}&day={day}&year2={year}&month2={month}&day2={day}&SDA15=1&AVG=10&if_no_html=1
format text
rows
lat_key Site_Latitude(Degrees)
lon_key Site_Longitude(Degrees)
field Total_AOD_500nm[tau_a] aod_total_500
field Fine_Mode_AOD_500nm[tau_f] aod_fine_500
field Coarse_Mode_AOD_500nm[tau_c] aod_coarse_500

# ---------------------------------------------------------------------------
# [7] AERONET TOT — Total Optical Depth L1.5 (gas + aerosol combined)
#     Useful for radiative transfer models
# ---------------------------------------------------------------------------
source aeronet_tot_global
ttl 3600
force diffusion
url https://aeronet.gsfc.nasa.gov/cgi-bin/print_web_data_v3?year={year}&month={month}&day={day}&year2={year}&month2={month}&day2={day}&TOT15=1&AVG=10&if_no_html=1
format text
rows
lat_key Site_Latitude(Degrees)
lon_key Site_Longitude(Degrees)
field Total_Optical_Depth_440nm tot_od_440
field Total_Optical_Depth_500nm tot_od_500

# ---------------------------------------------------------------------------
# [8] AERONET INV — Almucantar inversion products L1.5
#     Retrieves SSA (Single Scattering Albedo), Refractive Index, Phase Function
#     Requires sufficient solar loading — not all sites active daily
# ---------------------------------------------------------------------------
source aeronet_inv_ssa
ttl 3600
force diffusion
url https://aeronet.gsfc.nasa.gov/cgi-bin/print_web_data_v3?year={year}&month={month}&day={day}&year2={year}&month2={month}&day2={day}&INV15=1&AVG=10&if_no_html=1
format text
rows
lat_key Site_Latitude(Degrees)
lon_key Site_Longitude(Degrees)
field Single_Scattering_Albedo[440nm] ssa_440
field Single_Scattering_Albedo[675nm] ssa_675
field Absorption_AOD[440nm] aabs_440

# ---------------------------------------------------------------------------
# [9] AERONET AOD L2.0 — Quality-assured (cloud-screened + manually validated)
#     Lag: L2.0 has ~1 year delay in full QA; today query returns near-real-time
#     partial L2.0 where available, fallback to empty rows otherwise
# ---------------------------------------------------------------------------
source aeronet_aod20_global
ttl 86400
force diffusion
url https://aeronet.gsfc.nasa.gov/cgi-bin/print_web_data_v3?year={year}&month={month}&day={day}&year2={year}&month2={month}&day2={day}&AOD20=1&AVG=20&if_no_html=1
format text
rows
lat_key Site_Latitude(Degrees)
lon_key Site_Longitude(Degrees)
field AOD_440nm aod_440_l2
field AOD_500nm aod_500_l2
field Precipitable_Water(cm) precip_water_l2

# ---------------------------------------------------------------------------
# [10] AERONET Site List — static metadata (lat/lon/elevation of all ~1000 sites)
#      Use the official v3 site list; returns CSV-like text with headers
#      TTL 86400 (daily): site network changes rarely
# ---------------------------------------------------------------------------
source aeronet_site_list
ttl 86400
force diffusion
url https://aeronet.gsfc.nasa.gov/aeronet_locations_v3.txt
format text
rows
lat_key Latitude(decimal_degrees)
lon_key Longitude(decimal_degrees)
field Site_Name site_name
field Elevation(m) elevation
