```
# ===========================================================================
# SDSS / 2MASS / WISE  —  photometric catalog queries via IRSA Gator + SkyServer
# ALL sources: point-cloud compatible (ra_key + dec_key + dist via redshift)
# TTL 86400: static catalog data, daily re-fetch is sufficient
# Force: em (photons = EM radiation)
# ===========================================================================

# ---------------------------------------------------------------------------
# [1] SDSS DR18 — photometric galaxy catalog via SkyServer SQL REST
#     Returns JSON array of galaxies with ra, dec, photometric z (redshift)
#     PC-compatible: ra_key + dec_key + z_key → ICRS 3-D
# ---------------------------------------------------------------------------
source sdss_dr18_galaxies
ttl 86400
force em
url https://skyserver.sdss.org/dr18/SearchTools/sql?cmd=SELECT+TOP+5000+ra,dec,z,r,g,i+FROM+SpecObj+WHERE+class%3D%27GALAXY%27+AND+z+BETWEEN+0.01+AND+0.3+AND+zWarning%3D0&format=json
cmap .
ra_key ra
dec_key dec
z_key z
field r mag_r
field g mag_g
field i mag_i

# ---------------------------------------------------------------------------
# [2] SDSS DR18 — photometric QSO / quasar catalog
#     Quasars have measured spectroscopic redshifts → good dist proxy
#     PC-compatible: ra_key + dec_key + z_key
# ---------------------------------------------------------------------------
source sdss_dr18_qso
ttl 86400
force em
url https://skyserver.sdss.org/dr18/SearchTools/sql?cmd=SELECT+TOP+3000+ra,dec,z,psfMag_r,psfMag_g+FROM+SpecObj+WHERE+class%3D%27QSO%27+AND+z+BETWEEN+0.1+AND+3.0+AND+zWarning%3D0&format=json
cmap .
ra_key ra
dec_key dec
z_key z
field psfMag_r mag_r
field psfMag_g mag_g

# ---------------------------------------------------------------------------
# [3] SDSS DR18 — stellar point sources (Star view, photometry only)
#     No spectroscopic z → distance via parallax not available from SDSS;
#     use as 2-D angular map (no dist_key). Still valid em point-cloud in 2D.
# ---------------------------------------------------------------------------
source sdss_dr18_stars
ttl 86400
force em
url https://skyserver.sdss.org/dr18/SearchTools/sql?cmd=SELECT+TOP+5000+ra,dec,r,g,u,i,z+FROM+Star+WHERE+(r-extinction_r)%3C20+AND+clean%3D1&format=json
cmap .
ra_key ra
dec_key dec
field r mag_r
field g mag_g
field u mag_u

# ---------------------------------------------------------------------------
# [4] IRSA / 2MASS — All-Sky Point Source Catalog (fp_psc)
#     REST Gator cone: returns IPAC ASCII text, parse with format text + rows
#     outfmt=1 = IPAC table (pipe-delimited ASCII)
#     selcols: ra, dec, j_m (J-band mag), h_m, k_m
#     NOTE: no spectroscopic z → 2-D angular catalog; dist via photometric
#           distance modulus would need post-processing (not in-pipeline here)
# ---------------------------------------------------------------------------
source irsa_2mass_psc
ttl 86400
force em
url https://irsa.ipac.caltech.edu/cgi-bin/Gator/nph-query?catalog=fp_psc&spatial=box&ra=0.0&dec=0.0&size=14400&outfmt=1&selcols=ra,dec,j_m,h_m,k_m&outrows=5000
format text
rows
ra_key ra
dec_key dec
field j_m mag_j
field h_m mag_h
field k_m mag_k

# ---------------------------------------------------------------------------
# [5] IRSA / AllWISE — All-Sky Source Catalog (allwise_p3as_psd)
#     W1–W4 mid-infrared bands (3.4, 4.6, 12, 22 µm)
#     Cone via Gator REST; outfmt=1 = IPAC ASCII table
#     selcols: ra, dec, w1mpro, w2mpro, w3mpro, w4mpro
# ---------------------------------------------------------------------------
source irsa_allwise_psd
ttl 86400
force em
url https://irsa.ipac.caltech.edu/cgi-bin/Gator/nph-query?catalog=allwise_p3as_psd&spatial=box&ra=0.0&dec=0.0&size=14400&outfmt=1&selcols=ra,dec,w1mpro,w2mpro,w3mpro,w4mpro&outrows=5000
format text
rows
ra_key ra
dec_key dec
field w1mpro mag_w1
field w2mpro mag_w2
field w3mpro mag_w3
field w4mpro mag_w4

# ---------------------------------------------------------------------------
# [6] IRSA / NEOWISE-R — Year 10 single-exposure table (neowiser_p1bs_psd)
#     Active survey data (post-2013 reactivation), W1+W2 only
#     Useful for time-variable sources (asteroids, transients)
# ---------------------------------------------------------------------------
source irsa_neowise_r10
ttl 3600
force em
url https://irsa.ipac.caltech.edu/cgi-bin/Gator/nph-query?catalog=neowiser_p1bs_psd&spatial=box&ra=0.0&dec=0.0&size=3600&outfmt=1&selcols=ra,dec,w1mpro,w2mpro,mjd&outrows=2000&constraints=mjd%3E59000
format text
rows
ra_key ra
dec_key dec
field w1mpro mag_w1
field w2mpro mag_w2
field mjd mjd

# ---------------------------------------------------------------------------
# [7] IRSA TAP / 2MASS — ADQL geometric cone at Galactic center region
#     TAP/sync endpoint returns VOTable XML → parse as text
#     Demonstrates the TAP path (see Notes above)
#     ⚠ outfmt not JSON — use format text + rows; columns TSV-parsable
# ---------------------------------------------------------------------------
source irsa_tap_2mass_galcenter
ttl 86400
force em
url https://irsa.ipac.caltech.edu/TAP/sync?LANG=ADQL&FORMAT=csv&QUERY=SELECT+TOP+3000+ra,dec,j_m,h_m,k_m+FROM+fp_psc+WHERE+CONTAINS(POINT('ICRS',ra,dec),CIRCLE('ICRS',266.4,-29.0,2.0))=1
format text
rows
ra_key ra
dec_key dec
field j_m mag_j
field h_m mag_h
field k_m mag_k


# ===========================================================================
# AERONET  —  Aerosol Optical Depth network (NASA GSFC)
# All sources: terra-based (lat/lon from response data, not URL)
# Force: diffusion (aerosol concentration / optical depth)
# TTL: 600–3600 (sub-daily observations, update ~ hourly under cloud cover)
# Output: AERONET v3 is plain-text CSV with 7-line header → format text + rows
# AVG=10: all points; AOD15=1: Level 1.5 cloud-screened
# MANDATORY API params: year/month/day, AVG, data_type_flag
# Template vars used: {year} {month} {day}
# lat1/lon1/lat2/lon2 bounding box: defines spatial tile per deployment
# if_no_html=1: strips HTML wrapper → clean pipe-delimited ASCII
# ===========================================================================

# ---------------------------------------------------------------------------
# [1] AERONET AOD 440nm — Global bounding box, all sites, today
#     Level 1.5 (cloud-screened), all points, AOD_440nm column
#     ⚠ Header is 7 lines of metadata; data rows start after "Date(dd:mm:yyyy)"
#       Use format text + rows; skip lines starting with % or "AERONET"
# ---------------------------------------------------------------------------
source aeronet_aod440_global
ttl 3600
force diffusion
url https://aeronet.gsfc.nasa.gov/cgi-bin/print_web_data_v3?year={year}&month={month}&day={day}&year2={year}&month2={month}&day2={day}&AOD15=1&AVG=10&if_no_html=1
format text
rows
lat_key Site_Latitude(Degrees)
lon_key Site_Longitude(Degrees)
field AOD_440nm aod_440
field AOD_500nm aod_500
field Precipitable_Water(cm) precip_water

# ---------------------------------------------------------------------------
# [2] AERONET AOD 500nm — Europe bounding box (lat1=35, lon1=-10, lat2=70, lon2=40)
#     Same L1.5 data, bounded to European network
# ---------------------------------------------------------------------------
source aeronet_aod500_europe
ttl 1800
force diffusion
url https://aeronet.gsfc.nasa.gov/cgi-bin/print_web_data_v3?year={year}&month={month}&day={day}&year2={year}&month2={month}&day2={day}&AOD15=1&AVG=10&if_no_html=1&lat1=35.0&lon1=-10.0&lat2=70.0&lon2=40.0
format text
rows
lat_key Site_Latitude(Degrees)
lon_key Site_Longitude(Degrees)
field AOD_500nm aod_500
field Angstrom_Exponent_440-870nm angstrom_exp

# ---------------------------------------------------------------------------
# [3] AERONET AOD — Asia/Pacific bounding box (lat1=-10, lon1=60, lat2=55, lon2=150)
# ---------------------------------------------------------------------------
source aeronet_aod_asia
ttl 1800
force diffusion
url https://aeronet.gsfc.nasa.gov/cgi-bin/print_web_data_v3?year={year}&month={month}&day={day}&year2={year}&month2={month}&day2={day}&AOD15=1&AVG=10&if_no_html=1&lat1=-10.0&lon1=60.0&lat2=55.0&lon2=150.0
format text
rows
lat_key Site_Latitude(Degrees)
lon_key Site_Longitude(Degrees)
field AOD_440nm aod_440
field AOD_675nm aod_675

# ---------------------------------------------------------------------------
# [4] AERONET AOD — Americas bounding box (lat1=-55, lon1=-130, lat2=60, lon2=-30)
# ---------------------------------------------------------------------------
source aeronet_aod_americas
ttl 1800
force diffusion
url https://aeronet.gsfc.nasa.gov/cgi-bin/print_web_data_v3?year={year}&month={month}&day={day}&year2={year}&month2={month}&day2={day}&AOD15=1&AVG=10&if_no_html=1&lat1=-55.0&lon1=-130.0&lat2=60.0&lon2=-30.0
format text
rows
lat_key Site_Latitude(Degrees)
lon_key Site_Longitude(Degrees)
field AOD_440nm aod_440
field AOD_870nm aod_870

# ---------------------------------------------------------------------------
# [5] AERONET AOD — Africa bounding box (lat1=-35, lon1=-20, lat2=38, lon2=55)
# ---------------------------------------------------------------------------
source aeronet_aod_africa
ttl 3600
force diffusion
url https://aeronet.gsfc.nasa.gov/cgi-bin/print_web_data_v3?year={year}&month={month}&day={day}&year2={year}&month2={month}&day2={day}&AOD15=1&AVG=10&if_no_html=1&lat1=-35.0&lon1=-20.0&lat2=38.0&lon2=55.0
format text
rows
lat_key Site_Latitude(Degrees)
lon_key Site_Longitude(Degrees)
