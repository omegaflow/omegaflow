# USGS NWIS (National Water Information System):
#   https://waterservices.usgs.gov/nwis/gwlevels/ → Grundwasserpegel
# Force: diffusion (Grundwasserstand als Konzentrations-/Druckfeld)
# TTL: 3600 (USGS) / 86400 (IGRAC)
# ===========================================================================

# ---------------------------------------------------------------------------
# [53] USGS NWIS — Aktuelle Grundwasserpegel (instantaneous values)
#      Endpunkt: /nwis/iv/ mit parameterCd=72019 (Grundwassertiefe ft)
#      Format: JSON (WaterML 2.0 via &format=json)
#      ⚠ Benötigt stateCd oder bBox für sinnvolle Abfrage
#         Hier: Konterminale USA, aktuelle Werte (period=PT24H)
# ---------------------------------------------------------------------------
source usgs_nwis_groundwater_usa
ttl 3600
force diffusion
url https://waterservices.usgs.gov/nwis/iv/?parameterCd=72019&statCd=00001&siteType=GW&siteStatus=active&period=PT24H&format=json
map value.timeSeries
lat_key sourceInfo.geoLocation.geogLocation.latitude
lon_key sourceInfo.geoLocation.geogLocation.longitude
field sourceInfo.siteName station_name
