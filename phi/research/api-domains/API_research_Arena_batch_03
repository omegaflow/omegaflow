# Dashboard-API: https://terrabrasilis.dpi.inpe.br/app/api/
# PRODES REST: https://terrabrasilis.dpi.inpe.br/geoserver/prodes-amazon/
#              wfs?service=WFS&version=2.0.0&request=GetFeature&typeNames=...
#              &outputFormat=application/json
# Force: diffusion (Entwaldung als Flächenveränderungssignal)
# TTL: 86400 (PRODES: jährliche Kartierung, DETER: täglich)
# ===========================================================================

# ---------------------------------------------------------------------------
# [56] TerraBrasilis DETER — Tägl. Entwaldungsalarme (Amazônia Legal)
#      DETER: Detecção em Temps Real; tägl. SAR-basierte Alarme
#      WFS GeoJSON: geometrie + Fläche + Datum
#      ⚠ GeoJSON-Polygone → Centroid-Extraktion für lat/lon
# ---------------------------------------------------------------------------
source terrabrasilis_deter_amazon
ttl 86400
force diffusion
url https://terrabrasilis.dpi.inpe.br/app/api/v1/layer/amazon/latest/deforestation-alerts/all?format=geojson
map features
lat_key geometry.coordinates.0.0.1
lon_key geometry.coordinates.0.0.0
field properties.class_name deforestation_class
field properties.area_ha area_ha
field properties.view_date alert_date
field properties.uf state

# ---------------------------------------------------------------------------
# [57] TerraBrasilis PRODES — Jährlicher Entwaldungskatalog (seit 1988)
#      PRODES = Programa de Monitoramento da Floresta Amazônica Brasileira
#      REST JSON: Zusammenfassung nach Bundesstaat und Jahr
# ---------------------------------------------------------------------------
source terrabrasilis_prodes_annual
ttl 86400
force diffusion
url https://terrabrasilis.dpi.inpe.br/app/api/v1/layer/amazon/calculate/annual/deforestation-rates
map .
field year year
field state state
field area_km2 deforestation_km2
field accumulated_area_km2 accumulated_km2
