# ---------------------------------------------------------------------------
# [17] BZCAT 5th Edition — Roma Blazar Catalog (alle 3561 Blazare)
#      VizieR: VII/274/bzcat5
#      Felder: Name, RAJ2000, DEJ2000, z, Bmag, LogFlux, Type
#      Type: BLL (BL Lac), FSRQ, BCU (Blazar Candidate Uncertain)
#      PC-kompatibel: ra_key + dec_key + z_key
# ---------------------------------------------------------------------------
source vizier_bzcat5_blazars
ttl 86400
force em
url https://tapvizier.cds.unistra.fr/TAPVizieR/tap/sync?REQUEST=doQuery&LANG=ADQL&FORMAT=csv&QUERY=SELECT+TOP+4000+Name,RAJ2000,DEJ2000,z,Bmag,LogFlux,Type+FROM+"VII/274/bzcat5"+WHERE+RAJ2000+IS+NOT+NULL+ORDER+BY+LogFlux+DESC
format text
rows
ra_key RAJ2000
dec_key DEJ2000
z_key z
field Bmag optical_mag_b
field LogFlux log_radio_flux
field Type blazar_type
field Name source_name


