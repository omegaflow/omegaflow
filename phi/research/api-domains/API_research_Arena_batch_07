# Öffentlich, kein Auth
# Endpunkte:
#   /objsearch?search_type=Near+Position&in_csys=Equatorial&in_equinox=J2000.0
#              &lon=<ra>&lat=<dec>&search_radius=<arcmin>&img_stamp=NO
#              &out_csys=Equatorial&out_equinox=J2000.0&obj_sort=Distance+to+search+center
#              &of=ascii_bar (pipe-delimited ASCII)
#   /sdssConeSearch: Direkte SDSS-Cone-Suche
# Force: em (extragalaktische EM-Quellen)
# TTL: 86400
# ===========================================================================

# ---------------------------------------------------------------------------
# [23] NASA NED — Galaxien in der Virgo-Cluster-Region
#      Cone-Suche: RA=187.7, Dec=12.4, Radius=5° (Virgo-Cluster-Zentrum)
#      Gibt alle NED-Quellen in der Region zurück: Galaxien, QSOs, HII-Regionen
# ---------------------------------------------------------------------------
source nasa_ned_virgo_cluster
ttl 86400
force em
url https://ned.ipac.caltech.edu/cgi-bin/objsearch?search_type=Near+Position&in_csys=Equatorial&in_equinox=J2000.0&lon=187.7d&lat=12.4d&search_radius=300&img_stamp=NO&out_csys=Equatorial&out_equinox=J2000.0&obj_sort=Distance+to+search+center&of=ascii_bar&z_constraint=Unconstrained&z_value1=&z_value2=&z_unit=z&ot_include=ANY&nmp_op=ANY&out_equinox=J2000.0&obj_sort=Distance+to+search+center&of=ascii_bar
format text
rows
ra_key col_2
dec_key col_3
field col_1 ned_name
field col_4 object_type
field col_5 redshift
field col_6 mag_filter
field col_7 mag_value

