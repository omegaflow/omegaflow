# MODIS GPP / NDVI / PHOTOSYNTHESE-PROXY
# MOD17A2H: HDF-Kacheln → kein direktes REST-CSV
# VIABLE FREI: NASA AppEEARS REST API (Application for Extracting and
#   Exploring Analysis Ready Samples)
#   https://appeears.earthdatacloud.nasa.gov/api/
#   ⚠ Erfordert Earthdata-Login für Task-Submission → Auth-gesperrt
#
# BESTE FREIE ALTERNATIVEN OHNE AUTH:
# 1. NOAA CoastWatch ERDDAP: MODIS-Terra NDVI (erdMT1VImonthly)
# 2. NASA GES DISC Giovanni analog: via EARTHDATA ERDDAP
#    https://opendap.earthdata.nasa.gov/ → Auth
# 3. MODIS Land Cover via USGS EarthExplorer → kein REST
# 4. VIABLE FREI: GIMMS NDVI (Global Inventory Modeling and Mapping Studies)
#    via EARTHDATA öffentlicher FTP-Mirror
# 5. VIABLE FREI: Copernicus NDVI (SPOT/Proba-V/S3) via CLMS WMS
# 6. VIABLE FREI: CGLS NDVI via Copernicus Land Monitoring Service REST
#    https://land.copernicus.eu/global/products/ndvi
# 7. VIABLE FREI: OpenLandMap (via STAC / OGC API)
#    https://stac.openlandmap.org/ → öffentlich
# Force: diffusion (Vegetationsbiomasse = biologische Kohlenstoff-Diffusion)
# TTL: 86400 (8-Tages-Komposit Cadence)
# ===========================================================================

# ---------------------------------------------------------------------------
# [26] NOAA CoastWatch ERDDAP — MODIS Terra NDVI (monatlich global)
#      Dataset: erdMT1VImonthly → MODIS-Terra Vegetation Index
#      Variable: NDVI (Normalized Difference Vegetation Index, -1..+1)
#      Stride [5]: 0.5° effektive Auflösung für REST-Abfrage
# ---------------------------------------------------------------------------
source noaa_modis_ndvi_monthly_global
ttl 86400
force diffusion
url https://coastwatch.noaa.gov/erddap/griddap/erdMT1VImonthly.csv?NDVI%5Blast%5D%5B(-60.0):(75.0):5%5D%5B(-180.0):(180.0):5%5D
format text
rows
lat_key latitude
lon_key longitude
field NDVI ndvi_index

# ---------------------------------------------------------------------------
# [27] NOAA CoastWatch — MODIS Terra EVI (Enhanced Vegetation Index)
#      EVI korrigiert atmosphärische Einflüsse + Bodensignal besser als NDVI
#      Besser für Tropenwälder (Sättigungskorrektur)
# ---------------------------------------------------------------------------
source noaa_modis_evi_monthly_global
ttl 86400
force diffusion
url https://coastwatch.noaa.gov/erddap/griddap/erdMT1VImonthly.csv?EVI%5Blast%5D%5B(-60.0):(75.0):5%5D%5B(-180.0):(180.0):5%5D
format text
rows
lat_key latitude
lon_key longitude
field EVI evi_index

# ---------------------------------------------------------------------------
# [28] Copernicus CLMS — NDVI Global 1km (Proba-V/S3, dekadisch)
#      Copernicus Land Monitoring Service WCS REST:
#      https://land.copernicus.eu/global/products/ndvi
#      WCS GetCoverage für globales NDVI-Raster (dekadische Komposite)
#      Format: GeoTIFF → nicht direkt CSV; ERDDAP-Proxy nutzen
#      VIABLE ALTERNATIVE: CGLS via openEO-Prozesse
#      EINFACHSTER FREIER PFAD: Global NDVI via Open-Meteo-äquivalenter
#      COPERNICUS ERA5-Land-API (bodennahe Vegetationsvariablen)
# ---------------------------------------------------------------------------
source open_meteo_vegetation_proxy
ttl 86400
force diffusion
url https://api.open-meteo.com/v1/forecast?latitude={lat}&longitude={lon}&daily=et0_fao_evapotranspiration,vapor_pressure_deficit,growing_degree_days_base_0_limit_50&models=era5_seamless&forecast_days=1&format=json
terra 1
map daily.time
field_in daily.et0_fao_evapotranspiration et0_mm_proxy_gpp
field_in daily.vapor_pressure_deficit vpd_kpa
field_in daily.growing_degree_days_base_0_limit_50 gdd_0_50

# ---------------------------------------------------------------------------
# [29] OpenLandMap STAC — Bodenkohlenstoff + Landbedeckung (OGC API)
#      https://stac.openlandmap.org/ → öffentlich, STAC Items
#      Collections: sol_organic.carbon, lcv_land.cover
#      Format: JSON (STAC Item), Geometrie = Bounding Box des Tiles
# ---------------------------------------------------------------------------
source openlandmap_soil_carbon_stac
ttl 86400
force diffusion
url https://stac.openlandmap.org/collections/sol_organic.carbon_usda.6a1c_m/items?limit=500&bbox=-180,-60,180,75
map features
lat_key geometry.coordinates.0.0.1
lon_key geometry.coordinates.0.0.0
field properties.title layer_title
field properties.datetime data_datetime
field properties.description layer_description

# ---------------------------------------------------------------------------
# [30] USGS National Land Cover Database (NLCD) — Landnutzung USA
#      NLCD REST API via MRLC (Multi-Resolution Land Characteristics):
#      https://www.mrlc.gov/viewer/ → WMS/WCS (kein JSON-REST)
