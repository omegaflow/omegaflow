# SAGE (Spitzer Survey of the Large/Small Magellanic Clouds): IRAC+MIPS
# SINGS (Spitzer Infrared Nearby Galaxies Survey): 75 Galaxien
# Beide via IRSA TAP (NASA/IPAC Infrared Science Archive)
# Force: em (thermische IR-Emission = EM)
# ===========================================================================

# ---------------------------------------------------------------------------
# [23] IRSA TAP — SAGE LMC Point Source Catalog (Große Magellansche Wolke)
#      SAGE-LMC: vollständige Inventur aller Punktquellen (S3.6-160µm)
#      ~6.8 Mio. Quellen im 5.6×8 deg² LMC-Bereich
#      IRSA Tabelle: spitzer_sage_lmc_irac_m1
# ---------------------------------------------------------------------------
source irsa_sage_lmc_infrared_catalog
ttl 86400
force em
url https://irsa.ipac.caltech.edu/TAP/sync?LANG=ADQL&FORMAT=csv&QUERY=SELECT+TOP+3000+designation,ra,dec,i1_f_ap,i2_f_ap,i3_f_ap,i4_f_ap,m1_f_ap+FROM+spitzer_sage_lmc_irac_m1+WHERE+ra+IS+NOT+NULL+AND+i1_f_ap>0.1+ORDER+BY+i1_f_ap+DESC
format text
rows
ra_key ra
dec_key dec
field designation source_id
field i1_f_ap irac_3_6um_mJy
field i2_f_ap irac_4_5um_mJy
field i3_f_ap irac_5_8um_mJy
field i4_f_ap irac_8_0um_mJy
field m1_f_ap mips_24um_mJy

# ---------------------------------------------------------------------------
# [24] IRSA TAP — SAGE SMC Point Source Catalog (Kleine Magellansche Wolke)
