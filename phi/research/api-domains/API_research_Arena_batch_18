## Parser-Hinweise Batch 18

```
# ===== COSMOS2020 IRSA TAP Format =========================================
# Standard IRSA TAP CSV (identisch zu GLIMPSE, WISE etc.)
# lp_type: LePhare Morphologie (0=Galax, 1=Stern/QSO, 2=Hybrid)
# lp_zBEST: beste photo-z aus LePhare template fitting
# ez_z_phot: EAzY-basierte photo-z (Farmer-Katalog)
# lp_mass_med: log10(M_stellar/M_Sun) aus SED-Fitting
# ⚠ Koordinaten: ICRS J2000 (dezimal)
# ⚠ COSMOS2020 enthält 2 Versionen (Classic + Farmer) → verschiedene photo-z
#   für gleiche Objekte; Farmer meist besser für deblended Galaxien

# ===== GloFAS REST API =====================================================
# ECMWF CEMS-Flood API:
# {
#   "station_id": "GR000001",
#   "river_name": "Rhine",
#   "lat": 47.6,
#   "lon": 7.5,
#   "forecast_date": "2026-07-27",
#   "discharge_mean": 1234.5,    # m³/s ensemble mean
#   "discharge_p10": 890.2,      # 10th percentile
#   "discharge_p90": 1678.9,     # 90th percentile
#   "flood_alert": 5             # return period where current P90 exceeds
# }
# flood_alert: Rückkehrperiode in Jahren (2=jährlich, 5=5-jährlich, etc.)
# ⚠ terra=1 nötig: lat/lon aus Config-Parameter
# ⚠ CEMS-Flood API kann langsam sein → erhöhtes TTL (3600) verwenden

# ===== ACE-FTS SCISAT API =================================================
# SCISAT Level-2 Profile (JSON):
# {
#   "profiles": [
#     {
#       "profile_id": "SS3.5_2026_01_15_OCCS",
#       "observation_date": "2026-01-15T09:23:11Z",
#       "latitude": 72.3,
#       "longitude": -134.5,
#       "altitude_km": [10, 12, 14, ...],  # Array
#       "vmr_O3": [0.1, 0.3, 1.2, ...],    # ppbv Array
#       "vmr_err": [0.01, 0.02, 0.05, ...]
#     }, ...
#   ]
# }
# → vmr-Arrays sind Höhenprofile → Ingestor nimmt Profil-Maximum oder
#   bestimmte Druckniveau-Interpolation
# solar_zenith_angle: 90° = Sonnenauf/-untergang (optimale Okkultations-Geometrie)
# ⚠ Registrierung bei SCISAT (kostenlos) für vollständige L2-Daten nötig;
#   Statistik-API ggf. ohne Auth zugänglich

# ===== GEM OpenQuake API Format ============================================
# GEM Hazard API gibt GeoJSON zurück:
# {
#   "results": [
#     {
#       "lat": 37.5,
#       "lon": -122.0,
#       "pga": 0.48,         # in g (Erdbeschleunigung)
#       "return_period": 475,
#       "poe": 0.1,
#       "model": "GEM_GLOBAL_v2023.1"
#     }, ...
#   ]
# }
# PGA 0.48g → starkes Erdbebengefährdung
# PGA < 0.05g → niedriges Gefährdungsniveau
# ⚠ Template-Variable {lat_min}/{lon_min}/{lat_max}/{lon_max} erforderlich

# ===== TNS API Format ======================================================
# TNS (Transient Name Server): API-Key für vollständige Suche empfohlen
# Ohne Key: öffentliche Suche mit eingeschränkter Rate
# {
#   "reply": [
#     {
#       "objname": "AT2026abc",
#       "prefix": "AT",
#       "objtype": "Kilonova candidate",
#       "redshift": 0.083,
#       "discoverydate": "2026-07-25",
#       "discoverymag": 19.4,
#       "radeg": 197.45,
#       "decdeg": -23.38
#     }, ...
#   ]
# }
# objtype-Codes: 3=Kilonova, 4=LRN, 50=AT (unklassifiziert)
# ⚠ TNS Rate-Limit: 1 Request/10s für öffentlichen Zugang

# ===== BEDMAP3 / NSIDC TIF JSON Metadata ==================================
# NSIDC gibt Metadaten-JSON für TIF-Produkte zurück:
# {
#   "latitude": -75.0,   # Zentrum-Breite des Gitters
#   "longitude": 0.0,    # Zentrum-Länge
#   "bed_elevation": -2340,  # m über WGS84 (negativ = unter Meeresspiegel)
#   "ice_thickness": 3456,   # m
#   "surface_elevation": 1116  # m über Meeresspiegel
# }
# Antarktis: 70% des Untergrunds liegt unter Meeresspiegel
# ⚠ Koordinatensystem: Polar Stereographic (epsg:3031) → lat/lon Konversion

# ===== SOCAT JSON Format ==================================================
# SOCAT gibt pCO2-Messungen zurück:
# {
#   "observations": [
#     {
#       "latitude": -45.23,
#       "longitude": 158.76,
#       "expocode": "06MT20130109",
#       "timestamp": "2013-01-15T14:23:00Z",
#       "fCO2_recom_uatm": 378.5,
#       "Temperature_degC": 12.3,
#       "Salinity": 34.5,
#       "distance_to_land": 450
#     }, ...
#   ]
# }
# fCO2_recom: empfohlener fugacity of CO2 (µatm); Referenz: 400 µatm (2023)
# < 380 µatm: Ozean nimmt CO2 auf (Senke)
# > 400 µatm: Ozean gibt CO2 ab (Quelle)

# ===== HERA Phase I Power Spectrum Format ================================
# HERA Power Spectrum ASCII-Format:
# Zeile 1: Kommentar mit Metadaten (z_eff, k_parallel, k_perp)
# Datenzeilen: k_Mpc  Delta2  Delta2_upper  [noise_floor]
# Delta2: dimensionsloses Leistungsspektrum in mK²
# Delta2_upper: 2σ-Oberlimit
# k_Mpc: Wellenvektor in h/Mpc
# Signal erwartet: ~10-100 mK² bei k ~ 0.1-1 h/Mpc
# ⚠ Noch nicht detektiert (2026); nur Oberlimits verfügbar
```

