## Parser-Hinweise Batch 19

```
# ===== 4MOST ESO TAP_CAT Format ===========================================
# ESO TAP_CAT: https://archive.eso.org/tap_cat/sync
# Standard TAP CSV-Ausgabe (identisch zu VizieR)
# ⚠ 4MOST-Beobachtungen noch in früher Phase (2024-2026): TAP-Tabellennamen
#   können sich ändern → prüfe aktuell verfügbare Tabellen mit:
#   SELECT * FROM TAP_SCHEMA.tables WHERE schema_name LIKE '%4MOST%'
# Instrument-Modi: LRS (R~6500, 3660-9590 Å), HRS (R~20000, 3926-9440 Å)
# prog_id: ESO-Programm-ID (Format: NNNNNNN.A-NNNN)
# VIKING/VHS: K_s-Band < 18 mag als Standard-Tiefen-Limit für 4MOST

# ===== GCN REST API Einstein Probe Format ================================
# https://gcn.nasa.gov/api/v0.1/circulars?subject=Einstein+Probe&limit=200
# {
#   "items": [
#     {
#       "circularId": 44488,
#       "subject": "EP260507a: Einstein Probe detection of an X-ray transient",
#       "createdOn": "2026-05-07T16:23:00Z",
#       "submitter": "EP Team",
#       "body": "The transient triggered EP-WXT at 2026-05-07T13:47:57 UTC..."
#     }, ...
#   ]
# }
# → map items
# ⚠ RA/Dec nicht direkt im JSON-body → aus "subject"-Feld via Regex extrahieren
#   oder mit body-Text parsen: "R.A. = XXX.XX deg, DEC = XXX.XX deg"
# Designationsformat: EP[YYMMDD][a/b/c] (z.B. EP260507a)

# ===== IceCube HESE 12yr CSV-Format ========================================
# https://icecube.wisc.edu/data-releases/...hese_12yr_events.csv
# Spalten: event_id, ra_deg, dec_deg, energy_TeV, topology, ang_err_deg, mjd
# Topology: track=1 (muon neutrino, ~1° Winkelauflösung)
#            shower=2 (alle anderen, ~10-15° Auflösung)
# Energy: Proxy-Energie (nicht direkte Neutrino-Energie)
# ang_err_deg: 68% Konfidenz-Halbachse
# ⚠ ra_key dec_deg / lon_key ra_deg (umgekehrt, da dec = Breite, ra = Länge)

# ===== OSSOS Catalog Format ===============================================
# OSSOS: vollständig charakterisierter Survey → kein Effizienz-Bias
# class-Codes:
#   Res = Resonant (z.B. 3:2 Plutinos, 2:1 Twotinos)
#   Scat = Scattered Disk
#   Hot = Hot Classical Belt
#   Cold = Cold Classical Belt
#   Det = Detached (a > 50 AU, perihelion > 40 AU)
# a/e/i: Bahnelemente (AU/dimensionslos/Grad)
# H: Absolute Magnitude (sichtbares Licht, V-Band)
# ⚠ RAJ2000/DEJ2000 = Position zur Entdeckungsepoche (nicht aktuell)
#   Für aktuelle Position: JPL Horizons verwenden

# ===== LISA LDC2 Mock Source Format =======================================
# LDC2 Sangria-Datensatz: Galaktische Weiß-Zwerg-Binäre (GBs) + MBH-Merger
# {
#   "sources": [
#     {
#       "source_id": "GB_00001",
#       "frequency_Hz": 3.14e-4,
#       "amplitude": 1.23e-22,
#       "ecliptic_lat": 0.456,
#       "ecliptic_lon": 2.345,
#       "fdot": 1.2e-17,
#       "phi0": 1.56,
#       "inclination": 0.89
#     }, ...
#   ]
# }
# ecliptic_lat/lon: Ekliptik-Koordinaten in Radiant → Umrechnung zu ICRS nötig
# Frequenz 0.1-100 mHz: LISA-Empfindlichkeitsband
# ~25.000 individuelle GBs auflösbar von ~30M ungelöster Hintergrund

# ===== FUGIN CO Survey Format =============================================
# FUGIN gibt Punktquellen-Katalog zurück (nicht Gitterdaten):
# GLON/GLAT: galaktische Koordinaten → ra_key GLON / dec_key GLAT
# ⚠ Ingestor muss galaktische → äquatoriale Koordinaten konvertieren
# VLSR: LSR-Geschwindigkeit (km/s); negativ = auf uns zu
# Tmb: Haupt-Strahltemperatur (K); typisch 1-50 K für galaktische Wolken
# CO-Emissionslinie: 115.271 GHz (12CO J=1-0) → Molekülwolken-Tracer

# ===== NAO / PDO Index Format =============================================
# NOAA PSL Klimaindizes im gleichen Format wie RMM/QBO:
# Zeile 1: Jahr + 12 monatliche Werte (Leerzeichen-delimitiert)
# Fehlwerte: -999.99 → als NaN behandeln
# PDO positiv: warme NE-Pazifik + kühlere zentral-pazifische SST-Anomalie
# NAO positiv: starkes Islandtief + starkes Azorenhoch → stürmisches NW-Europa
# Beide: normalerweise z-skalierte Einheiten (dimensionslos)

# ===== GRDC Station Metadaten JSON ========================================
# GRDC GeoJSON FeatureCollection:
# {
#   "features": [
#     {
#       "type": "Feature",
#       "geometry": {"type": "Point", "coordinates": [lon, lat]},
#       "properties": {
#         "grdc_no": "1159900",
#         "river": "RHINE",
#         "country": "DE",
#         "continent": "EU",
#         "area_calc": 185000,   # km²
#         "alt_i": 156,          # m
#         "d_start": "1817-01-01",
#         "d_end": "2023-12-31"
#       }
#     }, ...
#   ]
# }
# → map features
# → lat_key geometry.coordinates.1 / lon_key geometry.coordinates.0
```

