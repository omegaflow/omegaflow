# sources_new.φ — STAGING for curated source candidates
#
# Rule: a block enters this file ONLY after (a) reachability test passed
# (direct + Jina route), and (b) field paths verified against the live
# response structure. Blocks here are NOT loaded by the Archivar.
# Move rule: verified -> sources_live.φ (live API) or sources_cdn.φ (CDN).
#
# All 9 blocks below passed HTTP 200 + structure inspection on 2026-08-07.

# --- Geomagnetic field, Boulder USGS ---
# structure: values[] = [ {id:X|Y|Z, values:[...]}, ... ]
url https://geomag.usgs.gov/ws/data/?id=BOU&type=adjusted&starttime={today}T00:00:00&endtime={today}T23:59:59&format=json&sampling_period=60
ttl 60
force gravity
on earth 40.137 -105.237
first values.0.values.0 magnetosphere_x_bou_nt
first values.1.values.0 magnetosphere_y_bou_nt
first values.2.values.0 magnetosphere_z_bou_nt

# --- Aerosol optical depth, Mauna Loa (direct sun photometer) ---
# structure: CSV text, last data row
url https://aeronet.gsfc.nasa.gov/cgi-bin/print_web_data_v3?site=Mauna_Loa&year={year}&month={month}&day={day}&year2={year}&month2={month}&day2={day}&AOD15=1&AVG=10&if_no_html=1
ttl 86400
force em
on earth 19.54 -155.58
format csv
last_row AOD_500nm atmosphere_aerosol_optical_depth_mauna_loa

# --- Wind, Key West (NOAA tides) ---
# structure: { data: [ { t, s, d, dr, g, f } ] }
url https://api.tidesandcurrents.noaa.gov/api/prod/datagetter?station=8724580&product=wind&time_zone=gmt&units=metric&format=json&date=latest
ttl 300
force advective
on earth 24.5557 -81.8079
first data.0.s atmosphere_wind_speed_keywest_ms
first data.0.dr atmosphere_wind_dir_keywest_deg

# --- Air temperature, Providence (NOAA tides) ---
# structure: { data: [ { t, v, f } ] }
url https://api.tidesandcurrents.noaa.gov/api/prod/datagetter?station=8454000&product=air_temperature&time_zone=gmt&units=metric&format=json&date=latest
ttl 300
force thermal
on earth 41.8067 -71.4006
first data.0.v atmosphere_air_temp_providence_c

# --- CFC-11 global mean (NOAA GML HATS) ---
# structure: CSV text, last data row
url https://gml.noaa.gov/aftp/data/hats/cfcs/cfc11/combined/HATS_global_F11.txt
ttl 2592000
force diffusion
at sun 1.0
format csv
last_row global_mean atmosphere_cfc11_global_ppt

# --- CFC-12 global mean (NOAA GML HATS) ---
url https://gml.noaa.gov/aftp/data/hats/cfcs/cfc12/combined/HATS_global_F12.txt
ttl 2592000
force diffusion
at sun 1.0
format csv
last_row global_mean atmosphere_cfc12_global_ppt

# --- CO2 daily, Mauna Loa (NOAA GML) ---
url https://gml.noaa.gov/webdata/ccgg/trends/co2/co2_daily_mlo.txt
ttl 86400
force diffusion
at sun 1.0
format csv
last_row value atmosphere_co2_daily_mlo_ppm

# --- Spectral wave data, NDBC buoy 41001 ---
# structure: CSV text with SwH/SwP columns
url https://www.ndbc.noaa.gov/data/realtime2/41001.spec
ttl 300
force acoustic
on earth 34.68 -72.55
format csv
last_row SwH hydrosphere_swell_height_41001_m
last_row SwP hydrosphere_swell_period_41001_s

# --- NWS ASOS JFK latest observation ---
# structure: { properties: { temperature: {value}, barometricPressure: {value}, windSpeed: {value} } }
url https://api.weather.gov/stations/KJFK/observations/latest
ttl 300
force advective
on earth 40.64 -73.78
path properties.temperature.value atmosphere_temp_jfk_c
path properties.barometricPressure.value atmosphere_pressure_jfk_pa
path properties.windSpeed.value atmosphere_wind_speed_jfk_ms
