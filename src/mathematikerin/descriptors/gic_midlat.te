# gic_midlat.te — GIC-Breitenband-Familie mid-latitude (|CGM| < 50 Grad): der Stufe-1-Screen
#   ueber die 98 Stationen des Bandes. Die Bandzugehoerigkeit ist eine deklarierte Ableitung
#   aus `cgm_lat` (phi/sources.φ, per Station) und den fixierten Grenzen — kein `family`-Token.
#   Partition gemessen 2026-10-07: 154 = 31 + 25 + 98 (Artefakt state/river/gic-cgm-lat.tsv).
#   Lauf: .github/workflows/field-te-query.yml Job `matrix-gic-midlat` (CI), nie lokal.
matrix gic_midlat full
register sources
channels magnetic_field_x_aae,magnetic_field_x_abg,magnetic_field_x_ams,magnetic_field_x_api,magnetic_field_x_aqu,magnetic_field_x_asc,magnetic_field_x_asp,magnetic_field_x_bdv,magnetic_field_x_bel,magnetic_field_x_bfo,magnetic_field_x_bmt,magnetic_field_x_bng,magnetic_field_x_bou,magnetic_field_x_bsl,magnetic_field_x_cki,magnetic_field_x_clf,magnetic_field_x_cnb,magnetic_field_x_cnh,magnetic_field_x_cpl,magnetic_field_x_cta,magnetic_field_x_cyg,magnetic_field_x_dlr,magnetic_field_x_dlt,magnetic_field_x_dou,magnetic_field_x_dur,magnetic_field_x_ebr,magnetic_field_x_frd,magnetic_field_x_frn,magnetic_field_x_fur,magnetic_field_x_gan,magnetic_field_x_gck,magnetic_field_x_gna,magnetic_field_x_gng,magnetic_field_x_gua,magnetic_field_x_gui,magnetic_field_x_gzh,magnetic_field_x_had,magnetic_field_x_hbk,magnetic_field_x_her,magnetic_field_x_hon,magnetic_field_x_hrb,magnetic_field_x_hua,magnetic_field_x_hyb,magnetic_field_x_ipm,magnetic_field_x_irt,magnetic_field_x_isk,magnetic_field_x_izn,magnetic_field_x_jai,magnetic_field_x_kak,magnetic_field_x_kdu,magnetic_field_x_kep,magnetic_field_x_khb,magnetic_field_x_kiv,magnetic_field_x_kmh,magnetic_field_x_kny,magnetic_field_x_kou,magnetic_field_x_lnp,magnetic_field_x_lon,magnetic_field_x_lrm,magnetic_field_x_lvv,magnetic_field_x_lzh,magnetic_field_x_mab,magnetic_field_x_mbo,magnetic_field_x_mid,magnetic_field_x_mlt,magnetic_field_x_mmb,magnetic_field_x_mzl,magnetic_field_x_nck,magnetic_field_x_ngk,magnetic_field_x_orc,magnetic_field_x_pag,magnetic_field_x_peg,magnetic_field_x_pet,magnetic_field_x_phu,magnetic_field_x_pil,magnetic_field_x_ppt,magnetic_field_x_pst,magnetic_field_x_qsb,magnetic_field_x_reu,magnetic_field_x_sbl,magnetic_field_x_sfs,magnetic_field_x_she,magnetic_field_x_sjg,magnetic_field_x_spt,magnetic_field_x_stt,magnetic_field_x_sua,magnetic_field_x_tam,magnetic_field_x_tan,magnetic_field_x_tdc,magnetic_field_x_thy,magnetic_field_x_tsu,magnetic_field_x_ttb,magnetic_field_x_tuc,magnetic_field_x_val,magnetic_field_x_vss,magnetic_field_x_wic,magnetic_field_x_wmq,magnetic_field_x_wng
cond none
fdr bh 0.05 over matrix
expect cells 9506
lags 0,1
surrogate 10
cadence live
bin 86400
seasonal none
