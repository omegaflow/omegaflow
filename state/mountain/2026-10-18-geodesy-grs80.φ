#   sha256 bff8c276b3dc9f04e9a757837923bc3fa80774b858f5b9aa03d1402ddc64d280:
#   GRS80_a() = 6378137; GRS80_GM() = 3986005 * 1e8; GRS80_omega() = 7292115 / 1e11; GRS80_J2() = 108263/1e8.
